{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination and optional search filters",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve detailed information for a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record with associated authors and optional cover image",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update an existing book's data, including authors and cover image",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book and clean up related author links",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List all authors with pagination",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors/{id}",
      "description": "Retrieve details of a specific author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author record",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PUT",
      "path": "/authors/{id}",
      "description": "Update an existing author's information",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all book categories",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Register a new library member (or librarian) account",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Create a borrowing record when a member checks out an available book",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings/{id}/return",
      "description": "Mark a borrowing as returned and update book availability",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a book that is currently checked out",
      "file": "app/routes/reservation_routes.py"
    }
  ],
  "database_schema": [
