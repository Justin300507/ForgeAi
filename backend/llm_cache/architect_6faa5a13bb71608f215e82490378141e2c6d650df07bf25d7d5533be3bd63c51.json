{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve list of users (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/exercises",
      "description": "List all exercises with optional pagination",
      "file": "app/routes/exercise_routes.py"
    },
    {
      "method": "GET",
      "path": "/exercises/{id}",
      "description": "Get detailed information for a specific exercise",
      "file": "app/routes/exercise_routes.py"
    },
    {
      "method": "GET",
      "path": "/exercises/search",
      "description": "Search exercises by name, muscle group or equipment",
      "file": "app/routes/exercise_routes.py"
    },
    {
      "method": "POST",
      "path": "/workouts",
      "description": "Create a new workout routine or log a workout session",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts",
      "description": "List workouts for the authenticated user",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts/{id}",
      "description": "Retrieve a specific workout by ID",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "PUT",
      "path": "/workouts/{id}",
      "description": "Update an existing workout or routine",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/workouts/{id}",
      "description": "Delete a workout or routine",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/progress",
      "description": "Get aggregated progress data for chart visualizations",
      "file": "app/routes/progress_routes.py"
    }
  ],
