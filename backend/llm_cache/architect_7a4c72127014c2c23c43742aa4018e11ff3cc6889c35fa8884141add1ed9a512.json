        },
        {
          "name": "timestamp",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "is_deleted",
          "type": "BOOLEAN",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
