          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_by",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "message",
