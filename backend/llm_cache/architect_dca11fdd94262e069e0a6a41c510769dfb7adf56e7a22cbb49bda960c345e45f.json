{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects",
      "description": "Retrieve a paginated list of projects visible to the authenticated user.",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects",
      "description": "Create a new project with the requesting user set as the owner.",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{project_id}",
      "description": "Get detailed information about a specific project.",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "PUT",
      "path": "/projects/{project_id}",
      "description": "Update project fields (name, description) or archive flag.",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/projects/{project_id}",
      "description": "Soft\u2011delete (archive) a project; only owners or admins may perform this.",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/issues",
      "description": "Retrieve a paginated list of issues with optional filters (project, status, priority, assignee).",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "POST",
      "path": "/issues",
      "description": "Create a new issue within a project; defaults status to \"Open\".",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "GET",
      "path": "/issues/{issue_id}",
      "description": "Get full details of a single issue, including comments and attachments.",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "PUT",
      "path": "/issues/{issue_id}",
      "description": "Update issue fields such as title, description, priority, status, and assignee.",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/issues/{issue_id}",
      "description": "Delete an issue; only permitted for admins or the project manager.",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "GET",
      "path": "/issues/{issue_id}/comments",
      "description": "List comments for a given issue with pagination.",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/issues/{issue_id}/comments",
      "description": "Add a new comment to an issue; triggers real\u2011time WebSocket broadcast.",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/attachments",
      "description": "Upload a file (max 5\u202fMB) attached to an issue or comment; returns the attachment ID and URL.",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/attachments/{attachment_id}",
      "description": "Download an attachment file with correct Content\u2011Type header.",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/search",
      "description": "Search projects or issues by query string; entity parameter selects target (projects or issues).",
      "file": "app/routes/search_routes.py"
    }
  ],
