{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get current authenticated user's profile",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/portfolios",
      "description": "List all portfolios belonging to the current user (paginated)",
      "file": "app/routes/portfolio_routes.py"
    },
    {
      "method": "POST",
      "path": "/portfolios",
      "description": "Create a new portfolio for the current user",
      "file": "app/routes/portfolio_routes.py"
    },
    {
      "method": "GET",
      "path": "/portfolios/{id}",
      "description": "Retrieve details of a specific portfolio, including cash balance",
      "file": "app/routes/portfolio_routes.py"
    },
    {
      "method": "GET",
      "path": "/portfolios/{portfolio_id}/holdings",
      "description": "List holdings for a portfolio with current share count and average cost",
      "file": "app/routes/holding_routes.py"
    },
    {
      "method": "GET",
      "path": "/portfolios/{portfolio_id}/transactions",
      "description": "List transactions for a portfolio (paginated, sorted by date desc)",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "POST",
      "path": "/portfolios/{portfolio_id}/transactions",
      "description": "Create a buy or sell transaction and automatically update holding shares and cost basis",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "GET",
      "path": "/portfolios/{portfolio_id}/dividends",
      "description": "List dividend records for a portfolio (paginated)",
      "file": "app/routes/dividend_routes.py"
    },
    {
      "method": "POST",
      "path": "/portfolios/{portfolio_id}/dividends",
      "description": "Record a dividend receipt and adjust cash balance",
      "file": "app/routes/dividend_routes.py"
    },
    {
      "method": "POST",
      "path": "/imports/csv",
      "description": "Upload a CSV file containing historical transactions for bulk import",
      "file": "app/routes/import_routes.py"
    },
    {
      "method": "GET",
      "path": "/price_history/{ticker}",
      "description": "Get latest price and recent price history for a ticker",
      "file": "app/routes/price_history_routes.py"
    },
    {
      "method": "GET",
      "path": "/search/securities",
      "description": "Search securities by ticker or company name for autocomplete suggestions",
      "file": "app/routes/search_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard",
      "description": "Retrieve aggregated dashboard data: total value, daily change, cash balance, dividend income, using real\u2011time prices",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
