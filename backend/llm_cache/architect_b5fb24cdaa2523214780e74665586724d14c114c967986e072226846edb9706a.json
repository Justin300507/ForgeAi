  "folder_structure": {
    "backend": [
      "app/models",
      "app/schemas",
      "app/routes",
      "app/services",
      "app/utils",
      "app/dependencies",
      "app/config",
      "app/main.py"
    ]
  },
  "frontend_structure": {
