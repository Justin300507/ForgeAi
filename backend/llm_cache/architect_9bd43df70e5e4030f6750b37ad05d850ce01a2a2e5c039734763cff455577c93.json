{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/leagues",
      "description": "List leagues with pagination and optional search",
      "file": "app/routes/league_routes.py"
    },
    {
      "method": "POST",
      "path": "/leagues",
      "description": "Create a new league",
      "file": "app/routes/league_routes.py"
    },
    {
      "method": "GET",
      "path": "/leagues/{id}",
      "description": "Get league details, including teams and current standings",
      "file": "app/routes/league_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/leagues/{id}",
      "description": "Edit league information or archive the league",
      "file": "app/routes/league_routes.py"
    },
    {
      "method": "POST",
      "path": "/teams",
      "description": "Create a new team within a league and assign a coach",
      "file": "app/routes/team_routes.py"
    },
    {
      "method": "GET",
      "path": "/teams/{id}",
      "description": "Get team details, including roster and logo",
      "file": "app/routes/team_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/teams/{id}",
      "description": "Edit team information and upload/change logo",
      "file": "app/routes/team_routes.py"
    },
    {
      "method": "POST",
      "path": "/players",
      "description": "Add a player to a team roster",
      "file": "app/routes/player_routes.py"
    },
    {
      "method": "GET",
      "path": "/players/{id}",
      "description": "Get player details and photo",
      "file": "app/routes/player_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/players/{id}",
      "description": "Edit player data and upload/change headshot",
      "file": "app/routes/player_routes.py"
    },
    {
      "method": "POST",
      "path": "/matches",
      "description": "Schedule a new match fixture",
      "file": "app/routes/match_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/matches/{id}",
      "description": "Edit match details or change status (e.g., mark as live or completed)",
      "file": "app/routes/match_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/matches/{id}/score",
      "description": "Update live score for an ongoing match",
      "file": "app/routes/match_routes.py"
    },
    {
      "method": "POST",
      "path": "/media/upload",
      "description": "Upload team logos or player headshots, returning a stored URL",
      "file": "app/routes/media_routes.py"
    }
  ],
