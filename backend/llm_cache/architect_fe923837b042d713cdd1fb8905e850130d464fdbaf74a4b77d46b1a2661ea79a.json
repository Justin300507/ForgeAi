{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and return JWT tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update the authenticated user's profile (name, phone, avatar upload)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Admin endpoint to change a user's role (Admin, Organizer, Volunteer)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/events",
      "description": "List events with pagination and search (title, description, location)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event (draft status) by an Organizer",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{id}",
      "description": "Get detailed information for a specific event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events/{id}/publish",
      "description": "Publish a draft event, making it visible to volunteers",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{event_id}/shifts",
      "description": "List all shifts belonging to an event",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "POST",
      "path": "/events/{event_id}/shifts",
      "description": "Create a new shift for an event",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "POST",
      "path": "/shifts/{id}/signup",
      "description": "Volunteer signs up for a shift (creates a VolunteerShift record)",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me/shifts",
      "description": "List shifts the authenticated volunteer has signed up for",
      "file": "app/routes/volunteer_shift_routes.py"
    },
    {
      "method": "POST",
      "path": "/volunteer_shifts/{id}/hours",
      "description": "Log completed hours for a volunteer shift",
      "file": "app/routes/hours_log_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/event-hours",
      "description": "Generate a CSV report of total volunteer hours per event with optional filters",
      "file": "app/routes/report_routes.py"
    }
  ],
  "database_schema": [
