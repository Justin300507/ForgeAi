{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (mentor or mentee) and receive initial JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile and role",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/mentors",
      "description": "Search public mentor profiles with filters (skill tags, availability, experience)",
      "file": "app/routes/mentor_routes.py"
    },
    {
      "method": "GET",
      "path": "/mentors/{id}",
      "description": "View a public mentor profile by its identifier",
      "file": "app/routes/mentor_routes.py"
    },
    {
      "method": "POST",
      "path": "/mentor_profiles",
      "description": "Create a mentor profile (bio, expertise tags, availability)",
      "file": "app/routes/mentor_routes.py"
    },
    {
      "method": "PUT",
      "path": "/mentor_profiles/{id}",
      "description": "Edit an existing mentor profile owned by the authenticated mentor",
      "file": "app/routes/mentor_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/mentor_profiles/{id}",
      "description": "Deactivate a mentor profile; it becomes hidden from search results",
      "file": "app/routes/mentor_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Mentee requests a mentorship session with agenda items and preferred time slot",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "PUT",
      "path": "/sessions/{id}/accept",
      "description": "Mentor accepts a pending session request and confirms start/end times",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "PUT",
      "path": "/sessions/{id}/decline",
      "description": "Mentor declines a pending session request",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions",
      "description": "List sessions for the current user (mentor or mentee) with pagination",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals",
      "description": "Mentee creates a SMART learning goal and optionally links future sessions",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/feedback",
      "description": "Mentor submits feedback for a completed session, rating the mentee and referencing goals",
      "file": "app/routes/feedback_routes.py"
    },
    {
      "method": "GET",
      "path": "/analytics",
      "description": "Admin retrieves aggregated analytics on sessions, goal completion, and feedback scores",
      "file": "app/routes/analytics_routes.py"
    }
  ],
