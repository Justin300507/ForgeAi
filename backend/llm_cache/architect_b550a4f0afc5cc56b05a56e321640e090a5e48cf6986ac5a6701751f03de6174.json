{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (employer or job seeker) with email and password, sending a verification email.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/verify-email",
      "description": "Verify a user's email address using a token provided as a query parameter.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT for subsequent authorized requests.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Handle password\u2011reset requests and actual password changes using a token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies",
      "description": "Create a company profile for an employer (name, description, location).",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "PUT",
      "path": "/companies/me",
      "description": "Update the authenticated employer's own company profile.",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidates",
      "description": "Create a candidate profile with bio, skills, and resume PDF upload.",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update the authenticated job seeker's candidate profile.",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job posting linked to the employer's company.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List public job postings with full\u2011text search, location/type filters, and pagination.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Retrieve detailed information for a specific job posting.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update a job posting owned by the authenticated employer.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Archive or delete a job posting owned by the authenticated employer.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job using the candidate's stored resume and optional cover letter.",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Employer updates the status of an application (e.g., in_review, interview_scheduled, rejected, hired).",
      "file": "app/routes/application_routes.py"
    }
  ],
