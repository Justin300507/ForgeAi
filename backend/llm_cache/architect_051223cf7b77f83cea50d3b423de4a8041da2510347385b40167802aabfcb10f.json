{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects",
      "description": "List projects with pagination and optional search",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects",
      "description": "Create a new project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{id}",
      "description": "Retrieve project details",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "PUT",
      "path": "/projects/{id}",
      "description": "Update project information",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/projects/{id}",
      "description": "Delete a project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects/{project_id}/members",
      "description": "Invite a user to a project with a role",
      "file": "app/routes/projectmember_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/projects/{project_id}/members/{user_id}",
      "description": "Remove a user from a project",
      "file": "app/routes/projectmember_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "List tasks with pagination and optional search",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new task within a project",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Retrieve task details",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tasks/{id}",
      "description": "Update task fields (status, assignee, etc.)",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tasks/{id}",
      "description": "Delete a task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks/{task_id}/comments",
      "description": "Add a comment (and optional attachments) to a task",
      "file": "app/routes/comment_routes.py"
    }
  ],
