{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with role selection and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access and refresh tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidates/profile",
      "description": "Create candidate profile after email verification",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/profile",
      "description": "Retrieve the authenticated candidate's profile",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/candidates/profile",
      "description": "Update candidate profile fields and upload PDF resume",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Search and filter public job listings with pagination",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job posting",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Employer creates a new job posting (status defaults to Open)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/jobs/{id}",
      "description": "Employer edits job details or changes job status (Open/Closed)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Candidate submits an application for a job with optional cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/me",
      "description": "Candidate lists all of their submitted applications",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/job/{job_id}",
      "description": "Employer views applications for a specific job posting",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}",
      "description": "Employer updates the status of a candidate's application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/logs",
      "description": "Admin retrieves paginated audit logs of system actions",
      "file": "app/routes/admin_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/users/{id}",
      "description": "Admin suspends or deletes a user account (action specified in request body)",
      "file": "app/routes/admin_routes.py"
    }
  ],
