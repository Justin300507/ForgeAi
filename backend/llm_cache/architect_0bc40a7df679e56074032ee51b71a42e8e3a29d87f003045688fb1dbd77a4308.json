{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips",
      "description": "List trips owned by the user with pagination and title search",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips",
      "description": "Create a new trip with title, start_date, and end_date",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{trip_id}",
      "description": "Retrieve details of a specific trip",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "PUT",
      "path": "/trips/{trip_id}",
      "description": "Update title, start_date, or end_date of a trip",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/trips/{trip_id}",
      "description": "Delete a trip owned by the user",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{trip_id}/itinerary",
      "description": "Get chronological itinerary: destinations with their activities",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "POST",
      "path": "/destinations",
      "description": "Add a destination to a trip (requires trip_id, city, arrival_date, departure_date)",
      "file": "app/routes/destination_routes.py"
    },
    {
      "method": "PUT",
      "path": "/destinations/{destination_id}",
      "description": "Update destination details",
      "file": "app/routes/destination_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/destinations/{destination_id}",
      "description": "Remove a destination from a trip",
      "file": "app/routes/destination_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{trip_id}/packing-items",
      "description": "List packing items for a trip",
      "file": "app/routes/packing_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips/{trip_id}/packing-items",
      "description": "Create a new packing item for a trip",
      "file": "app/routes/packing_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips/{trip_id}/collaborators",
      "description": "Invite another registered user to collaborate on a trip",
      "file": "app/routes/collaborator_routes.py"
    }
  ],
