{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/employees",
      "description": "Retrieve a list of all employees",
      "file": "app/routes/employee_routes.py"
    },
    {
      "method": "POST",
      "path": "/employees",
      "description": "Create a new employee profile",
      "file": "app/routes/employee_routes.py"
    },
    {
      "method": "GET",
      "path": "/employees/{id}",
      "description": "Retrieve details of a specific employee",
      "file": "app/routes/employee_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employees/{id}",
      "description": "Update an existing employee profile",
      "file": "app/routes/employee_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/employees/{id}",
      "description": "Delete an employee profile",
      "file": "app/routes/employee_routes.py"
    },
    {
      "method": "GET",
      "path": "/documents",
      "description": "List documents, optionally filtered by employee_id",
      "file": "app/routes/document_routes.py"
    },
    {
      "method": "POST",
      "path": "/documents",
      "description": "Upload a new onboarding document",
      "file": "app/routes/document_routes.py"
    },
    {
      "method": "GET",
      "path": "/documents/{id}",
      "description": "Download or view a specific document",
      "file": "app/routes/document_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "List onboarding tasks, optionally filtered by employee_id",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new onboarding task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Retrieve details of a specific task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks/{id}/complete",
      "description": "Mark a task as completed",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and issue JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "description": "Invalidate user session or token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Get current authenticated user info",
      "file": "app/routes/auth_routes.py"
    }
