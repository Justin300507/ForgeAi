{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/members",
      "description": "Retrieve list of all gym members",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Create a new gym member profile",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/{id}",
      "description": "Get detailed information for a specific member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/{id}",
      "description": "Update an existing member's information",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/members/{id}",
      "description": "Remove a member from the system",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts",
      "description": "Retrieve all workout log entries",
      "file": "app/routes/workoutlog_routes.py"
    },
    {
      "method": "POST",
      "path": "/workouts",
      "description": "Create a new workout log entry for a member",
      "file": "app/routes/workoutlog_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts/{id}",
      "description": "Get a specific workout log entry",
      "file": "app/routes/workoutlog_routes.py"
    },
    {
      "method": "PUT",
      "path": "/workouts/{id}",
      "description": "Update an existing workout log entry",
      "file": "app/routes/workoutlog_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/workouts/{id}",
      "description": "Delete a workout log entry",
      "file": "app/routes/workoutlog_routes.py"
    },
    {
      "method": "GET",
      "path": "/plans",
      "description": "Retrieve all subscription plans",
      "file": "app/routes/subscriptionplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/plans",
      "description": "Create a new subscription plan",
      "file": "app/routes/subscriptionplan_routes.py"
    },
    {
      "method": "GET",
      "path": "/plans/{id}",
      "description": "Get details of a specific subscription plan",
      "file": "app/routes/subscriptionplan_routes.py"
    },
    {
      "method": "PUT",
      "path": "/plans/{id}",
      "description": "Update an existing subscription plan",
      "file": "app/routes/subscriptionplan_routes.py"
    }
  ],
