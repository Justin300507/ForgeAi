{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/users/{id}",
      "description": "Deactivate or delete a user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/products",
      "description": "List and search digital products",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/products",
      "description": "Create a new product (admin only)",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Get detailed information for a product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "PUT",
      "path": "/products/{id}",
      "description": "Update product details (admin only)",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/products/{id}",
      "description": "Delete a product (admin only)",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/orders",
      "description": "Create an order and process payment",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders",
      "description": "List orders for the authenticated user",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders/{id}",
      "description": "Retrieve details of a specific order",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders/{id}/download",
      "description": "Download purchased product files for a completed order",
      "file": "app/routes/order_routes.py"
    }
  ],
