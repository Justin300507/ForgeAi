{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve public profile of a user by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get current authenticated user's details",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/nodes",
      "description": "List forum nodes; optional query param ?type=category|thread to filter",
      "file": "app/routes/forumnode_routes.py"
    },
    {
      "method": "GET",
      "path": "/nodes/{id}",
      "description": "Get details of a specific forum node (category or thread)",
      "file": "app/routes/forumnode_routes.py"
    },
    {
      "method": "POST",
      "path": "/nodes",
      "description": "Create a new forum node (category or thread)",
      "file": "app/routes/forumnode_routes.py"
    },
    {
      "method": "PUT",
      "path": "/nodes/{id}",
      "description": "Update title, description, or parent of a forum node",
      "file": "app/routes/forumnode_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/nodes/{id}",
      "description": "Delete a forum node and its descendants",
      "file": "app/routes/forumnode_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/thread/{thread_id}",
      "description": "List all posts belonging to a thread",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}",
      "description": "Retrieve a single post by its ID",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts",
      "description": "Create a new post (reply) in a thread",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "PUT",
      "path": "/posts/{id}",
      "description": "Edit content of an existing post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/posts/{id}",
      "description": "Delete a post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{id}/vote",
      "description": "Cast an upvote or downvote on a post",
      "file": "app/routes/post_routes.py"
    }
  ],
