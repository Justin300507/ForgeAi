{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email/password or Google OAuth and receive JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs",
      "description": "List clubs with pagination, filter by privacy",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs",
      "description": "Create a new club (organizer becomes creator)",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs/{slug}",
      "description": "Get club details by slug",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "PUT",
      "path": "/clubs/{slug}",
      "description": "Update club information (name, description, privacy)",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/clubs/{slug}",
      "description": "Delete a club (organizer only)",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs/{slug}/join",
      "description": "Join a club using invite code if private, creates membership",
      "file": "app/routes/membership_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs/{slug}/reading-list",
      "description": "List reading\u2011list items for a club with pagination",
      "file": "app/routes/readinglist_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs/{slug}/reading-list",
      "description": "Add a book to the club's reading list (status pending)",
      "file": "app/routes/readinglist_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/clubs/{slug}/reading-list/{item_id}",
      "description": "Update reading\u2011list item status or order index",
      "file": "app/routes/readinglist_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/search",
      "description": "Search external book API by title, author, or ISBN",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/reviews",
      "description": "Create a review for a book within a club",
      "file": "app/routes/review_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs/{slug}/discussions",
      "description": "List discussion threads for the club's current book",
      "file": "app/routes/discussion_routes.py"
    },
    {
      "method": "POST",
      "path": "/discussions/{thread_id}/comments",
      "description": "Post a comment in a discussion thread (real\u2011time broadcast)",
      "file": "app/routes/comment_routes.py"
    }
  ],
