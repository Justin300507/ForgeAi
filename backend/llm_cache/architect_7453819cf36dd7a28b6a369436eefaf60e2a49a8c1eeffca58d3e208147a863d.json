{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, password, and role",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/courses",
      "description": "List all courses with basic info for catalog browsing",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "GET",
      "path": "/courses/{id}",
      "description": "Get detailed course information including lesson list",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "POST",
      "path": "/courses",
      "description": "Create a new course (instructor role)",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "PUT",
      "path": "/courses/{id}",
      "description": "Update course metadata",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "GET",
      "path": "/courses/{course_id}/lessons",
      "description": "List lessons for a specific course in order",
      "file": "app/routes/lesson_routes.py"
    },
    {
      "method": "POST",
      "path": "/courses/{course_id}/lessons",
      "description": "Add a new lesson to a course",
      "file": "app/routes/lesson_routes.py"
    },
    {
      "method": "POST",
      "path": "/enrollments",
      "description": "Enroll a student in a course",
      "file": "app/routes/enrollment_routes.py"
    },
    {
      "method": "GET",
      "path": "/enrollments/user/{user_id}",
      "description": "Get all enrollments for a specific user",
      "file": "app/routes/enrollment_routes.py"
    },
    {
      "method": "GET",
      "path": "/enrollments/course/{course_id}",
      "description": "Get all enrollments for a specific course",
      "file": "app/routes/enrollment_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/enrollments/{id}",
      "description": "Update enrollment progress (completed lessons, progress percent, last accessed)",
      "file": "app/routes/enrollment_routes.py"
    },
    {
      "method": "GET",
      "path": "/enrollments/{id}",
      "description": "Retrieve detailed enrollment record",
      "file": "app/routes/enrollment_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "password_hash",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "full_name",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "role",
          "type": "VARCHAR(20)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "courses",
