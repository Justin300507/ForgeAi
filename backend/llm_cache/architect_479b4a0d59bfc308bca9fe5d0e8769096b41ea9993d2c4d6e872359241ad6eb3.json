{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/events",
      "description": "List events with pagination and search",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event (organizer only)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{id}",
      "description": "Retrieve detailed information for a specific event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "PUT",
      "path": "/events/{id}",
      "description": "Update event details (organizer only)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/events/{id}",
      "description": "Archive (soft\u2011delete) an event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events/{event_id}/shifts",
      "description": "Create a shift slot for a specific event",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{event_id}/shifts",
      "description": "List all shift slots for a given event",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "PUT",
      "path": "/shifts/{id}",
      "description": "Update shift details (organizer only)",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/shifts/{id}",
      "description": "Delete a shift slot",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "POST",
      "path": "/shifts/{shift_id}/signup",
      "description": "Volunteer requests assignment to a shift (creates pending VolunteerShift)",
      "file": "app/routes/volunteer_shift_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/volunteer_shifts/{id}/status",
      "description": "Organizer approves or rejects a volunteer shift request",
      "file": "app/routes/volunteer_shift_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/volunteer-hours",
      "description": "Generate a report of volunteer hours per event",
      "file": "app/routes/report_routes.py"
    }
  ],
