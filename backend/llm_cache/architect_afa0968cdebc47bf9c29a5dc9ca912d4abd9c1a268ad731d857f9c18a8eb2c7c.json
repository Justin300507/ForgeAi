{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination and optional search",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve a single book by ID",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book with authors and cover image",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update an existing book's details",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book from the catalog",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List authors with pagination",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PUT",
      "path": "/authors/{id}",
      "description": "Update an existing author's information",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/{id}",
      "description": "Get member profile (self or librarian view)",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/{id}",
      "description": "Update member profile information",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/borrowings",
      "description": "List borrowings; filter overdue with query param",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Create a borrowing (checkout a book)",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for an unavailable book",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/notifications/overdue",
      "description": "Trigger overdue reminder emails to members",
      "file": "app/routes/notification_routes.py"
    }
  ],
