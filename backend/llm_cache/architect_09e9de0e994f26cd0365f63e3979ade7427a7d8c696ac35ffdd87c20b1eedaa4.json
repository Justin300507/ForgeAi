{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Create a new user account with role (freelancer, client, admin)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access and refresh tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Request password reset email for a registered user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile and role information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update the authenticated user's profile fields (display name, headline, bio, rates)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/profiles/portfolio",
      "description": "Upload a portfolio file (image or PDF) for the authenticated freelancer",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/gigs",
      "description": "List public gigs with pagination, category/budget filters, and full\u2011text search",
      "file": "app/routes/gig_routes.py"
    },
    {
      "method": "POST",
      "path": "/gigs",
      "description": "Create a new gig (client) with title, description, category, total budget, and initial milestones",
      "file": "app/routes/gig_routes.py"
    },
    {
      "method": "GET",
      "path": "/gigs/{gig_id}",
      "description": "Retrieve detailed information for a specific gig, including milestones and proposals",
      "file": "app/routes/gig_routes.py"
    },
    {
      "method": "POST",
      "path": "/gigs/{gig_id}/milestones",
      "description": "Add a new milestone to an existing gig (client only while no contract awarded)",
      "file": "app/routes/milestone_routes.py"
    },
    {
      "method": "POST",
      "path": "/gigs/{gig_id}/proposals",
      "description": "Submit a proposal (freelancer) with cover letter and proposed price",
      "file": "app/routes/proposal_routes.py"
    },
    {
      "method": "GET",
      "path": "/gigs/{gig_id}/proposals",
      "description": "List all proposals received for a gig (client view)",
      "file": "app/routes/proposal_routes.py"
    },
    {
      "method": "POST",
      "path": "/proposals/{proposal_id}/award",
      "description": "Award a proposal, creating a contract and setting other proposals to declined",
      "file": "app/routes/proposal_routes.py"
    },
    {
      "method": "POST",
      "path": "/contracts/{contract_id}/milestones/{milestone_id}/submit",
      "description": "Freelancer submits deliverable files and notes for a milestone, changing status to submitted",
      "file": "app/routes/contract_routes.py"
    },
    {
      "method": "POST",
      "path": "/contracts/{contract_id}/review",
      "description": "Client leaves a rating and optional comment after contract completion",
      "file": "app/routes/review_routes.py"
    }
  ],
