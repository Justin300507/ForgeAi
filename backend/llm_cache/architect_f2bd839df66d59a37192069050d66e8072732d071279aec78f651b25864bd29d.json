{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and return JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Return current authenticated user profile.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "List public recipes with pagination and optional search query.",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Retrieve detailed information of a recipe, including ingredients and steps.",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe (title, description, visibility, image). Owner is the authenticated user.",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe owned by the user.",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe; regular users can delete own recipes, admins can delete any.",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{recipe_id}/ingredients",
      "description": "Add an ingredient with quantity and unit to a recipe.",
      "file": "app/routes/ingredient_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{recipe_id}/steps",
      "description": "Append a new ordered step to a recipe.",
      "file": "app/routes/step_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{recipe_id}/steps/{id}",
      "description": "Update step description or reorder step_number within a recipe.",
      "file": "app/routes/step_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{recipe_id}/steps/{id}",
      "description": "Remove a step from a recipe.",
      "file": "app/routes/step_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{recipe_id}/favorite",
      "description": "Toggle favorite status for the authenticated user on a recipe.",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me/favorites",
      "description": "List all recipes favorited by the authenticated user.",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/audit-logs",
      "description": "Admin endpoint to retrieve audit log entries of recipe deletions.",
      "file": "app/routes/audit_log_routes.py"
    }
  ],
