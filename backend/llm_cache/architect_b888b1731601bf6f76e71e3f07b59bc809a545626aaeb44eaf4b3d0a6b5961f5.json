{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Admin: retrieve paginated list of users with optional search by email or ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/accounts",
      "description": "Get paginated list of accounts for the current user, searchable by name",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "POST",
      "path": "/accounts",
      "description": "Create a new financial account for the current user",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "GET",
      "path": "/accounts/{id}",
      "description": "Retrieve details of a specific account belonging to the current user",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "PUT",
      "path": "/accounts/{id}",
      "description": "Update name, type, or currency of an existing account",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/accounts/{id}",
      "description": "Delete an account owned by the current user",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "GET",
      "path": "/transactions",
      "description": "Get paginated list of transactions for the current user, searchable by description or category",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "POST",
      "path": "/transactions",
      "description": "Create a new transaction manually",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "POST",
      "path": "/imports/transactions",
      "description": "Upload CSV file to bulk import transactions",
      "file": "app/routes/import_routes.py"
    },
    {
      "method": "GET",
      "path": "/budgets",
      "description": "Retrieve paginated list of budgets for the current user",
      "file": "app/routes/budget_routes.py"
    },
    {
      "method": "POST",
      "path": "/budgets",
      "description": "Create a monthly budget for a specific category",
      "file": "app/routes/budget_routes.py"
    },
    {
      "method": "GET",
      "path": "/alerts",
      "description": "Get list of budget alerts for the current user",
      "file": "app/routes/alert_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/spending",
      "description": "Generate spending report by category for a given date range",
      "file": "app/routes/report_routes.py"
    }
  ],
