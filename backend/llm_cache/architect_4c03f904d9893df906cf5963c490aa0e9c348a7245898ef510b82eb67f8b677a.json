          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "category_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "title",
