{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "List all users (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/roles",
      "description": "List all role definitions",
      "file": "app/routes/role_routes.py"
    },
    {
      "method": "POST",
      "path": "/leagues",
      "description": "Create a new league",
      "file": "app/routes/league_routes.py"
    },
    {
      "method": "POST",
      "path": "/leagues/{league_id}/seasons",
      "description": "Create a season for a league",
      "file": "app/routes/season_routes.py"
    },
    {
      "method": "POST",
      "path": "/seasons/{season_id}/teams",
      "description": "Add a team to a season",
      "file": "app/routes/team_routes.py"
    },
    {
      "method": "POST",
      "path": "/teams/{team_id}/players",
      "description": "Add a player to a team",
      "file": "app/routes/player_routes.py"
    },
    {
      "method": "GET",
      "path": "/teams/{team_id}/matches",
      "description": "Get upcoming matches for a team",
      "file": "app/routes/match_routes.py"
    },
    {
      "method": "POST",
      "path": "/matches",
      "description": "Schedule a new match",
      "file": "app/routes/match_routes.py"
    },
    {
      "method": "POST",
      "path": "/matches/{match_id}/result",
      "description": "Record result and player events for a match",
      "file": "app/routes/match_result_routes.py"
    },
    {
      "method": "GET",
      "path": "/seasons/{season_id}/standings",
      "description": "View current standings for a season",
      "file": "app/routes/standing_routes.py"
    },
    {
      "method": "GET",
      "path": "/seasons/{season_id}/report",
      "description": "Export season report as CSV",
      "file": "app/routes/report_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "List recent system notifications",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "GET",
      "path": "/health",
      "description": "Health check endpoint",
      "file": "app/routes/health_routes.py"
    }
  ],
