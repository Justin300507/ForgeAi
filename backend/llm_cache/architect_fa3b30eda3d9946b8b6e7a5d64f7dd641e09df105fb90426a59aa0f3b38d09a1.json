{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (owner, vet, or admin)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get current authenticated user's profile and pending notifications",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/pets",
      "description": "List pets owned by the current user with pagination and search",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "POST",
      "path": "/pets",
      "description": "Create a new pet profile with photo upload",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "GET",
      "path": "/pets/{id}",
      "description": "Retrieve detailed information for a specific pet",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "PUT",
      "path": "/pets/{id}",
      "description": "Update pet information and optionally replace photo",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/pets/{id}",
      "description": "Delete a pet profile",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "GET",
      "path": "/appointments",
      "description": "List appointments for the current user (owner or vet) with pagination",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "POST",
      "path": "/appointments",
      "description": "Book a new vet appointment, preventing double\u2011booking",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "GET",
      "path": "/appointments/{id}",
      "description": "Get details of a specific appointment",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/appointments/{id}",
      "description": "Cancel an appointment (sets status to cancelled)",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "GET",
      "path": "/vaccinations",
      "description": "List vaccination records for the current user's pets with pagination",
      "file": "app/routes/vaccination_routes.py"
    },
    {
      "method": "POST",
      "path": "/vaccinations",
      "description": "Create a vaccination record and upload certificate image",
      "file": "app/routes/vaccination_routes.py"
    },
    {
      "method": "GET",
      "path": "/vaccinations/{id}",
      "description": "Retrieve a specific vaccination record",
      "file": "app/routes/vaccination_routes.py"
    }
  ],
