{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/venues",
      "description": "Retrieve a list of all venues",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "GET",
      "path": "/venues/{id}",
      "description": "Retrieve details of a specific venue",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "POST",
      "path": "/venues",
      "description": "Create a new venue (admin only)",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "GET",
      "path": "/shows",
      "description": "Retrieve a list of upcoming shows",
      "file": "app/routes/show_routes.py"
    },
    {
      "method": "GET",
      "path": "/shows/{id}",
      "description": "Retrieve details of a specific show",
      "file": "app/routes/show_routes.py"
    },
    {
      "method": "POST",
      "path": "/shows",
      "description": "Create a new show (admin only)",
      "file": "app/routes/show_routes.py"
    },
    {
      "method": "GET",
      "path": "/shows/{id}/seats",
      "description": "Retrieve seat map and availability for a show",
      "file": "app/routes/show_routes.py"
    },
    {
      "method": "POST",
      "path": "/tickets/purchase",
      "description": "Purchase a ticket for a selected seat",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/{id}",
      "description": "Retrieve details of a specific ticket (owner only)",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/mine",
      "description": "List all tickets purchased by the authenticated user",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/auth_routes.py"
    }
  ],
