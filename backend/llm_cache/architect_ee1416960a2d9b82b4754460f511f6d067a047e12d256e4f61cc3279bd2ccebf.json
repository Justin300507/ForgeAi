{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Create a new user account and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/verify",
      "description": "Verify email using token query parameter and activate account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/profiles/me",
      "description": "Retrieve the authenticated candidate's profile",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/profiles/me",
      "description": "Update candidate profile fields and optionally upload resume URL",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies",
      "description": "Register a new company and associate it with the employer user",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Search and filter job listings with pagination",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies/{company_id}/jobs",
      "description": "Create a new job listing for the specified company",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{job_id}",
      "description": "Edit mutable fields of an existing job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{job_id}",
      "description": "Delete a job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs/{job_id}/applications",
      "description": "Submit an application for a job with resume URL and optional cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/me",
      "description": "List applications submitted by the authenticated candidate",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/employer/jobs/{job_id}/applications",
      "description": "Employer view of applications for a specific job with pagination",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{application_id}",
      "description": "Employer updates application status (Reviewed, Interview, Rejected)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications/me",
      "description": "Retrieve real\u2011time and email notifications for the authenticated user",
      "file": "app/routes/notification_routes.py"
    }
  ],
