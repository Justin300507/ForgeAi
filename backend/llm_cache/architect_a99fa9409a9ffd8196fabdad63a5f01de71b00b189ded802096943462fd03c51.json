{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/merchants",
      "description": "Retrieve list of all merchants",
      "file": "app/routes/merchant_routes.py"
    },
    {
      "method": "GET",
      "path": "/merchants/{id}",
      "description": "Retrieve details of a specific merchant",
      "file": "app/routes/merchant_routes.py"
    },
    {
      "method": "POST",
      "path": "/merchants",
      "description": "Create a new merchant (admin)",
      "file": "app/routes/merchant_routes.py"
    },
    {
      "method": "PUT",
      "path": "/merchants/{id}",
      "description": "Update an existing merchant (admin)",
      "file": "app/routes/merchant_routes.py"
    },
    {
      "method": "GET",
      "path": "/deals",
      "description": "Retrieve list of deals with optional filters (category, location, discount range, active status)",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "GET",
      "path": "/deals/{id}",
      "description": "Retrieve detailed information for a specific deal",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "POST",
      "path": "/deals",
      "description": "Create a new deal (admin)",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "PUT",
      "path": "/deals/{id}",
      "description": "Update an existing deal (admin)",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "Retrieve list of deal categories",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new category (admin)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "PUT",
      "path": "/categories/{id}",
      "description": "Update an existing category (admin)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth",
      "description": "User login or registration based on payload",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me/favorites",
      "description": "Get list of deals saved by the authenticated user",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/me/favorites",
      "description": "Add a deal to the authenticated user's favorites",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/users/me/favorites/{deal_id}",
      "description": "Remove a deal from the authenticated user's favorites",
      "file": "app/routes/favorite_routes.py"
    }
  ],
