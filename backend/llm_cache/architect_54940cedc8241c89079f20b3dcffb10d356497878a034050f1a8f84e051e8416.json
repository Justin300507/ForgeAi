{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve a list of all registered users",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve details of a specific user by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return an access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "Get all recipe categories for the authenticated user",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories/{id}",
      "description": "Get a single category by its ID",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new recipe category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "PUT",
      "path": "/categories/{id}",
      "description": "Update an existing category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/categories/{id}",
      "description": "Delete a category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Retrieve a list of recipes for the authenticated user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Retrieve detailed information for a specific recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/search",
      "description": "Search recipes by title, ingredient, or category",
      "file": "app/routes/recipe_routes.py"
    }
  ],
