{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new member account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "Retrieve paginated list of authors",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors/{id}",
      "description": "Get details of a specific author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PUT",
      "path": "/authors/{id}",
      "description": "Update an existing author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "Retrieve paginated list of books with optional search (title, ISBN, author name)",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record with total copies count",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Get detailed information for a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update book information",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book from the catalog",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Checkout an available book copy to a member (creates borrowing record)",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings/{id}/return",
      "description": "Process return of a borrowed copy (updates borrowing and copy status)",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a book with no available copies",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations",
      "description": "List reservations for the authenticated member or all reservations for librarians",
      "file": "app/routes/reservation_routes.py"
    }
  ],
