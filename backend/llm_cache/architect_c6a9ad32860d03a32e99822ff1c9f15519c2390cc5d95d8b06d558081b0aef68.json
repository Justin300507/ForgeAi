{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, password, full name and role",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update the authenticated user's profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies/me",
      "description": "Get the company profile owned by the authenticated employer",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies",
      "description": "Create a new company profile for the authenticated employer",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "PUT",
      "path": "/companies/me",
      "description": "Update the authenticated employer's company profile",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List active job postings with optional search, location and employment type filters",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job posting for the authenticated employer's company",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Retrieve detailed information for a specific job posting",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update an existing job posting owned by the authenticated employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Deactivate (soft\u2011delete) a job posting owned by the authenticated employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application for a job, including cover letter and optional resume URL",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications for the authenticated user (candidates see their submissions; employers see applications to their jobs)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PUT",
      "path": "/applications/{id}",
      "description": "Update the status of an application (e.g., reviewed, interviewed, rejected, hired)",
      "file": "app/routes/application_routes.py"
    }
  ],
