{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user (candidate, employer, or admin) and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access and refresh tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/verify-email",
      "description": "Verify email using token query parameter and activate user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the authenticated candidate's profile",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update candidate profile fields and optionally upload resume PDF",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employers/me",
      "description": "Update employer profile fields and optionally upload company logo",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Public job listings with full\u2011text search, filters (location, remote, salary, skills) and pagination",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/jobs/{id}",
      "description": "Edit job details or deactivate the listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job (candidate only) with optional cover letter and resume selection",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications: candidates see their own; employers see applications for their jobs; supports filters and pagination",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Employer updates the status of an application (e.g., Interview, Rejected, Hired)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "Retrieve paginated notifications for the authenticated user",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/jobs/pending",
      "description": "Admin view of job listings awaiting moderation",
      "file": "app/routes/admin_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/jobs/{id}/moderate",
      "description": "Admin approve, reject, or request edits for a pending job listing",
      "file": "app/routes/admin_routes.py"
    }
  ],
