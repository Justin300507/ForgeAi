{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and issue a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/profiles/{user_id}",
      "description": "Retrieve the public profile of a user",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts",
      "description": "Get a paginated list of published posts with optional category filter and search",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}",
      "description": "Get detailed information for a single post, including categories and approved comments",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts",
      "description": "Create a new draft post (author role required)",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "PUT",
      "path": "/posts/{id}",
      "description": "Update an existing post (author of the post or admin)",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/posts/{id}",
      "description": "Delete a post (author of the post or admin)",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all categories with post counts",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new category (admin role required)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "PUT",
      "path": "/categories/{id}",
      "description": "Rename or reparent an existing category (admin role required)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/categories/{id}",
      "description": "Delete a category after reassignment checks (admin role required)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{post_id}/comments",
      "description": "Get a paginated list of approved comments for a post",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{post_id}/comments",
      "description": "Add a new comment to a post (authenticated reader role required)",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "PUT",
      "path": "/comments/{id}",
      "description": "Moderate (approve/reject) or edit a comment (admin or comment author)",
      "file": "app/routes/comment_routes.py"
    }
  ],
