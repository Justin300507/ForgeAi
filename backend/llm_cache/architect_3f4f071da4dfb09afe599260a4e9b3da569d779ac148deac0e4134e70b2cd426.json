{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs",
      "description": "List public book clubs with pagination and filter options",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs",
      "description": "Create a new book club (organizer only)",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs/{id}",
      "description": "Retrieve details of a specific club",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "PUT",
      "path": "/clubs/{id}",
      "description": "Update club information (organizer only)",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs/{id}/join",
      "description": "Request to join a club as a member",
      "file": "app/routes/membership_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs/{id}/discussions",
      "description": "Create a new discussion thread within a club",
      "file": "app/routes/discussion_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs/{id}/discussions",
      "description": "List discussion threads for a club with pagination",
      "file": "app/routes/discussion_routes.py"
    },
    {
      "method": "POST",
      "path": "/discussions/{thread_id}/comments",
      "description": "Add a comment to a discussion thread",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "GET",
      "path": "/discussions/{thread_id}/comments",
      "description": "Retrieve comments for a discussion thread in chronological order",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "GET",
      "path": "/reading-list",
      "description": "Get the authenticated user's reading list items",
      "file": "app/routes/readinglist_routes.py"
    },
    {
      "method": "POST",
      "path": "/reading-list",
      "description": "Add a book to the user's reading list",
      "file": "app/routes/readinglist_routes.py"
    },
    {
      "method": "POST",
      "path": "/books/{id}/reviews",
      "description": "Submit a star rating and optional text review for a finished book",
      "file": "app/routes/review_routes.py"
    }
  ],
