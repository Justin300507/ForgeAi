{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Request password reset or submit new password using token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/profile/me",
      "description": "Retrieve the authenticated user's candidate or employer profile",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/profile/me",
      "description": "Update the authenticated user's profile fields",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Public job search with keyword, filters and pagination",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update a job listing owned by the employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Delete a job listing owned by the employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application with resume upload and cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/me",
      "description": "List applications submitted by the authenticated candidate",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{job_id}/applications",
      "description": "Employer view of applications for a specific job",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PUT",
      "path": "/applications/{id}",
      "description": "Employer updates application status and optional message",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/admin/users/{id}",
      "description": "Admin suspends or deletes a user account",
      "file": "app/routes/admin_routes.py"
    }
  ],
