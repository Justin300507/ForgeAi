{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user details by ID (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/goals",
      "description": "List all savings goals for the current user",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals",
      "description": "Create a new savings goal",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "GET",
      "path": "/goals/{id}",
      "description": "Get detailed information for a specific goal",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "PUT",
      "path": "/goals/{id}",
      "description": "Update an existing goal (title, target amount, dates, etc.)",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/goals/{id}",
      "description": "Delete a goal",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals/{id}/milestones",
      "description": "Add a progress milestone to a goal",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "GET",
      "path": "/goals/{id}/milestones",
      "description": "List all milestones for a specific goal",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "GET",
      "path": "/goals/{goal_id}/contributions",
      "description": "List contributions made to a specific goal",
      "file": "app/routes/contribution_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals/{goal_id}/contributions",
      "description": "Record a one\u2011time contribution toward a goal",
      "file": "app/routes/contribution_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard",
      "description": "Get summary of all active goals and overall savings progress",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
