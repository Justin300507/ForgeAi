{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with role assignment",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve list of all users (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve details of a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/events",
      "description": "List all upcoming events for browsing",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{id}",
      "description": "Get detailed information of a specific event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event (organizer only)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "PUT",
      "path": "/events/{id}",
      "description": "Update an existing event (organizer only)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/events/{id}",
      "description": "Delete an event (organizer only)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events/{id}/register",
      "description": "Register the authenticated attendee for the event and issue a ticket",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets",
      "description": "List tickets belonging to the authenticated user",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/{id}",
      "description": "Retrieve details of a specific ticket",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tickets/{id}",
      "description": "Cancel a ticket (if allowed by event policy)",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/organizer",
      "description": "Provide registration statistics for events owned by the organizer",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "name",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "password_hash",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "role",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "events",
      "columns": [
