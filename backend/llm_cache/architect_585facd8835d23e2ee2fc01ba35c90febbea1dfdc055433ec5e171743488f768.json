          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "description",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "location",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "start_time",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "end_time",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "capacity",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "organizer_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "updated_at",
