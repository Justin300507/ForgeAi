          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "tickets",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "event_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "status",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "purchased_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "ticket_code",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "app/models",
      "app/schemas",
      "app/services",
      "app/routes",
      "app/utils",
      "app/config"
    ]
  },
  "frontend_structure": {
    "pages": [
      "Login",
      "Organizer Dashboard",
      "Event Catalog",
      "Event Detail",
      "Ticket Management"
    ],
    "components": [
      "Header",
      "Footer",
      "EventCard",
      "EventList",
      "EventForm",
      "TicketList",
      "TicketItem",
      "LoginForm",
      "DashboardStats",
      "Pagination",
      "SearchBar",
