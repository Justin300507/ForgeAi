{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get current authenticated user's profile (includes role and basic info)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts",
      "description": "List workouts for the current user with pagination and optional filters (date range, exercise name)",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "POST",
      "path": "/workouts",
      "description": "Create a new workout session",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts/{id}",
      "description": "Retrieve detailed view of a specific workout, including exercises and sets",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "PUT",
      "path": "/workouts/{id}",
      "description": "Update workout details (date, type, notes)",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/workouts/{id}",
      "description": "Delete a workout session",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "POST",
      "path": "/workouts/{id}/exercises",
      "description": "Add an exercise entry to a workout (select existing exercise or create new)",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "POST",
      "path": "/exercise_entries/{id}/sets",
      "description": "Add a set (reps and weight) to a specific exercise entry",
      "file": "app/routes/set_routes.py"
    },
    {
      "method": "GET",
      "path": "/templates",
      "description": "List workout templates created by the trainer with pagination",
      "file": "app/routes/template_routes.py"
    },
    {
      "method": "POST",
      "path": "/templates",
      "description": "Create a new workout template (trainer only)",
      "file": "app/routes/template_routes.py"
    },
    {
      "method": "POST",
      "path": "/templates/{id}/share",
      "description": "Share a template with selected client(s)",
      "file": "app/routes/template_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "List notifications for the current user with pagination",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "GET",
      "path": "/exercises",
      "description": "Search exercises by name (supports query param ?q=)",
      "file": "app/routes/exercise_routes.py"
    }
  ],
