{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/verify-email",
      "description": "Verify email using token query parameter",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Reset password using token and new password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/profiles",
      "description": "Retrieve the authenticated user's profile (candidate or employer)",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "POST",
      "path": "/profiles",
      "description": "Create a profile for the authenticated user (candidate or employer)",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/profiles",
      "description": "Update the authenticated user's profile",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Public job feed with pagination, keyword search, and filters (location, type, salary)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Employer creates a new job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/jobs/{id}",
      "description": "Employer updates job details or changes status (e.g., archive)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Candidate applies to a job with resume PDF upload",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "Candidate lists their own applications with pagination",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}",
      "description": "Employer updates application status (Interview, Offer, Rejected)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/audit-logs",
      "description": "Admin retrieves audit log entries with pagination",
      "file": "app/routes/admin_routes.py"
    }
  ],
