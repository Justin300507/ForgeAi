{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account and return a JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and issue a JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Return the profile of the currently authenticated user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "Paginated list of categories belonging to the user",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new category for organizing subscriptions",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions",
      "description": "Paginated and searchable list of the user's subscriptions",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "POST",
      "path": "/subscriptions",
      "description": "Create a new subscription record",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions/{id}",
      "description": "Retrieve details of a specific subscription",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "PUT",
      "path": "/subscriptions/{id}",
      "description": "Update an existing subscription's fields",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/subscriptions/{id}",
      "description": "Delete a subscription and cancel its reminder jobs",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions/export",
      "description": "Generate and download a CSV file containing all of the user's subscriptions",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "Paginated list of email reminder logs for the user",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "GET",
      "path": "/analytics/dashboard",
      "description": "Return total monthly spend, upcoming bills, and spend breakdown by category",
      "file": "app/routes/analytics_routes.py"
    }
  ],
