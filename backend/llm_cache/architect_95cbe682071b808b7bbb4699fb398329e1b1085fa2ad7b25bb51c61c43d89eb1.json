{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies",
      "description": "List companies for the authenticated user, supports pagination and search via query parameters",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies",
      "description": "Create a new company for the authenticated user",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies/{id}",
      "description": "Retrieve details of a specific company owned by the user",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "PUT",
      "path": "/companies/{id}",
      "description": "Update an existing company owned by the user",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/companies/{id}",
      "description": "Delete a company owned by the user",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications for the authenticated user, supports pagination and search via query parameters",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Create a new application linked to a company",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{id}",
      "description": "Retrieve details of a specific application owned by the user",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/applications/{id}",
      "description": "Delete an application owned by the user",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{app_id}/interviews",
      "description": "List interviews scheduled for a specific application",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications/{app_id}/interviews",
      "description": "Create a new interview for a specific application",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications/{app_id}/status",
      "description": "Record a status change for an application",
      "file": "app/routes/status_update_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications/{app_id}/documents",
      "description": "Upload a document (resume, cover letter, etc.) for an application",
      "file": "app/routes/document_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{app_id}/documents",
      "description": "List documents attached to an application",
      "file": "app/routes/document_routes.py"
    }
  ],
