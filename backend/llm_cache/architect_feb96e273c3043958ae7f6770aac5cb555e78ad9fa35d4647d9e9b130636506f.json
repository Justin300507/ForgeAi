{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update profile information of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all product categories with optional pagination",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/products",
      "description": "List products with filtering by category, full\u2011text search, and pagination",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Get detailed information for a single product, including images",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/cart/items",
      "description": "Add a product to the authenticated user's cart",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "GET",
      "path": "/cart/items",
      "description": "Retrieve all cart items for the authenticated user",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "PUT",
      "path": "/cart/items/{item_id}",
      "description": "Update quantity of a specific cart item",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/cart/items/{item_id}",
      "description": "Remove a specific item from the cart",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "POST",
      "path": "/orders",
      "description": "Create a new order from the current cart (checkout)",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders",
      "description": "List orders of the authenticated user with pagination",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders/{order_id}",
      "description": "Get detailed information for a specific order",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/orders/{order_id}/status",
      "description": "Admin updates the status of an order (e.g., Pending \u2192 Shipped)",
      "file": "app/routes/order_routes.py"
    }
  ],
