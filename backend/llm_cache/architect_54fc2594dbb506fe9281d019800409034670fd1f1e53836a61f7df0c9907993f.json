{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account and return a JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Paginated list of recipes with optional search filters (name, ingredient, tag)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a single recipe, including nutrition facts and ingredients",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe (admin only)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe (admin only)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe (admin only)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/meal-plans",
      "description": "List all meal plans belonging to the authenticated user",
      "file": "app/routes/meal_plan_routes.py"
    },
    {
      "method": "POST",
      "path": "/meal-plans",
      "description": "Create a new weekly meal plan for the user",
      "file": "app/routes/meal_plan_routes.py"
    },
    {
      "method": "GET",
      "path": "/meal-plans/{id}",
      "description": "Retrieve a specific meal plan with its assigned recipes and meal slots",
      "file": "app/routes/meal_plan_routes.py"
    },
    {
      "method": "POST",
      "path": "/meal-plans/{id}/shopping-list",
      "description": "Generate a consolidated shopping list for the given meal plan",
      "file": "app/routes/meal_plan_routes.py"
    },
    {
      "method": "GET",
      "path": "/favorites",
      "description": "List the authenticated user's favorite recipes",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "POST",
      "path": "/favorites",
      "description": "Add a recipe to the user's favorites (body: {\"recipe_id\": int})",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "List upcoming push\u2011notification reminders for the user",
      "file": "app/routes/notification_routes.py"
    }
  ],
