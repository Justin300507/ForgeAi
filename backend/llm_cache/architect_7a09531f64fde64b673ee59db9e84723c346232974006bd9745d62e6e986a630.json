{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new member account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/courts",
      "description": "Retrieve list of courts with current availability",
      "file": "app/routes/court_routes.py"
    },
    {
      "method": "GET",
      "path": "/courts/{id}",
      "description": "Retrieve detailed information for a specific court",
      "file": "app/routes/court_routes.py"
    },
    {
      "method": "POST",
      "path": "/courts",
      "description": "Create a new court (admin only)",
      "file": "app/routes/court_routes.py"
    },
    {
      "method": "PUT",
      "path": "/courts/{id}",
      "description": "Update court details (admin only)",
      "file": "app/routes/court_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/courts/{id}",
      "description": "Delete a court (admin only)",
      "file": "app/routes/court_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/me",
      "description": "Get the authenticated member's profile",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/me",
      "description": "Update the authenticated member's profile",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/me/bookings",
      "description": "List booking history for the authenticated member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/bookings",
      "description": "Create a new booking for a court",
      "file": "app/routes/booking_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/bookings/{id}",
      "description": "Cancel an existing booking",
      "file": "app/routes/booking_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/reports/usage",
      "description": "Generate usage statistics for courts and bookings (admin only)",
      "file": "app/routes/admin_routes.py"
    }
  ],
