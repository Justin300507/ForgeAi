{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users/register",
      "description": "Register a new user and create account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/users/me",
      "description": "Update profile fields of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me/streak",
      "description": "Get current streak count and last practice date",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/sets",
      "description": "List vocabulary sets accessible to the user",
      "file": "app/routes/set_routes.py"
    },
    {
      "method": "POST",
      "path": "/sets",
      "description": "Create a new vocabulary set",
      "file": "app/routes/set_routes.py"
    },
    {
      "method": "GET",
      "path": "/sets/{id}",
      "description": "Retrieve details of a specific vocabulary set",
      "file": "app/routes/set_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/sets/{id}",
      "description": "Update metadata of a vocabulary set",
      "file": "app/routes/set_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/sets/{id}",
      "description": "Delete a vocabulary set owned by the user",
      "file": "app/routes/set_routes.py"
    },
    {
      "method": "GET",
      "path": "/sets/{id}/exercises",
      "description": "List all exercises belonging to a vocabulary set",
      "file": "app/routes/set_routes.py"
    },
    {
      "method": "POST",
      "path": "/exercises",
      "description": "Create a new exercise (admin/author)",
      "file": "app/routes/exercise_routes.py"
    },
    {
      "method": "GET",
      "path": "/exercises/{id}",
      "description": "Retrieve a specific exercise definition",
      "file": "app/routes/exercise_routes.py"
    },
    {
      "method": "POST",
      "path": "/exercises/{id}/submit",
      "description": "Submit user's answer for an exercise and receive result",
      "file": "app/routes/exercise_routes.py"
    }
  ],
