{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new member with username, email, and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate member and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "Retrieve a paginated list of books with optional filters",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{book_id}",
      "description": "Get detailed information for a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/search",
      "description": "Search books by title, author, or ISBN using query parameters",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{book_id}/reviews",
      "description": "List all reviews for a given book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books/{book_id}/reviews",
      "description": "Create a new review for a book by the authenticated member",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/{member_id}",
      "description": "Retrieve public profile information of a member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/{member_id}/reading-list",
      "description": "Get the list of books saved in the member's reading list",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members/{member_id}/reading-list/{book_id}",
      "description": "Add a book to the member's reading list",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/members/{member_id}/reading-list/{book_id}",
      "description": "Remove a book from the member's reading list",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members/{member_id}/follow/{target_id}",
      "description": "Member starts following another member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/members/{member_id}/follow/{target_id}",
      "description": "Member stops following another member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{book_id}/discussions",
      "description": "Retrieve discussion threads associated with a book",
      "file": "app/routes/discussion_routes.py"
    },
    {
      "method": "POST",
      "path": "/books/{book_id}/discussions",
      "description": "Create a new discussion thread for a book",
      "file": "app/routes/discussion_routes.py"
    }
  ],
