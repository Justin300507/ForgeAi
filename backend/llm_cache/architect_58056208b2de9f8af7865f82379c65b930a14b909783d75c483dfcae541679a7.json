{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "Get paginated list of authors",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors/{id}",
      "description": "Retrieve author details by ID",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PUT",
      "path": "/authors/{id}",
      "description": "Update author information",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/authors/{id}",
      "description": "Delete an author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "Get paginated list of books with optional search",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book with cover image upload",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve book details by ID",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update book information",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Member borrows an available book",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "GET",
      "path": "/borrowings",
      "description": "List borrowings (librarian view or member\u2011filtered)",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Member places a reservation on a checked\u2011out book",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/most-borrowed",
      "description": "Report of top borrowed books within a date range",
      "file": "app/routes/report_routes.py"
    }
  ],
