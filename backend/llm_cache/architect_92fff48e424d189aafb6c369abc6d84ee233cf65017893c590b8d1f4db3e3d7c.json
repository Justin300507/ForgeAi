{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve a list of all users (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve profile details for a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update profile information for a user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/users/{id}",
      "description": "Delete a user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "List recipes with optional search filters",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Retrieve detailed information for a specific recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/mealplans",
      "description": "List meal plans for the authenticated user",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "GET",
      "path": "/mealplans/{id}",
      "description": "Retrieve a specific weekly meal plan with nutrition summary",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/mealplans",
      "description": "Create a new weekly meal plan",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "PUT",
      "path": "/mealplans/{id}",
      "description": "Update an existing weekly meal plan",
      "file": "app/routes/mealplan_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "password_hash",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "name",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "dietary_preferences",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
