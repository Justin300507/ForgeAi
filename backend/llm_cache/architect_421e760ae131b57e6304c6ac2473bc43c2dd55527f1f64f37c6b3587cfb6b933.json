{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/tables",
      "description": "Retrieve list of tables",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "POST",
      "path": "/tables",
      "description": "Create a new table",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "GET",
      "path": "/tables/{id}",
      "description": "Retrieve details of a specific table",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tables/{id}",
      "description": "Update information of a specific table",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tables/{id}",
      "description": "Delete (deactivate) a specific table",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations",
      "description": "List all reservations",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a new reservation and assign a table",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations/{id}",
      "description": "Get details of a specific reservation",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "PUT",
      "path": "/reservations/{id}",
      "description": "Update reservation details (status, time, etc.)",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reservations/{id}",
      "description": "Cancel a reservation",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/waitlist",
      "description": "List all waitlist entries",
      "file": "app/routes/waitlist_routes.py"
    },
    {
      "method": "POST",
      "path": "/waitlist",
      "description": "Add a customer to the waitlist",
      "file": "app/routes/waitlist_routes.py"
    },
    {
      "method": "GET",
      "path": "/waitlist/{id}",
      "description": "Retrieve details of a specific waitlist entry",
      "file": "app/routes/waitlist_routes.py"
    },
    {
      "method": "PUT",
      "path": "/waitlist/{id}",
      "description": "Update waitlist entry status or details",
      "file": "app/routes/waitlist_routes.py"
    }
  ],
