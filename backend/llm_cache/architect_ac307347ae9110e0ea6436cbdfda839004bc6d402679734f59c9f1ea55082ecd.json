{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users/register",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get profile of authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips",
      "description": "List all trips for the authenticated user",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips",
      "description": "Create a new trip",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{id}",
      "description": "Retrieve details of a specific trip",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "PUT",
      "path": "/trips/{id}",
      "description": "Update an existing trip",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/trips/{id}",
      "description": "Delete a trip",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{id}/budget",
      "description": "Get budget summary for a trip",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips/{id}/share",
      "description": "Generate a shareable link for the itinerary",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{trip_id}/activities",
      "description": "List activities for a specific trip",
      "file": "app/routes/activity_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips/{trip_id}/activities",
      "description": "Create a new activity within a trip",
      "file": "app/routes/activity_routes.py"
    },
    {
      "method": "GET",
      "path": "/activities/{id}",
      "description": "Retrieve details of a specific activity",
      "file": "app/routes/activity_routes.py"
    },
    {
      "method": "PUT",
      "path": "/activities/{id}",
      "description": "Update an existing activity",
      "file": "app/routes/activity_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/activities/{id}",
      "description": "Delete an activity",
      "file": "app/routes/activity_routes.py"
    }
  ],
