{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Authenticate user and issue JWT access and refresh tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/auth/refresh",
      "description": "Refresh access token using a valid refresh token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/users",
      "description": "List all users (admin only) with pagination and optional filters",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/users",
      "description": "Create a new user account and assign role",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/api/users/{user_id}",
      "description": "Update user details, including role and activation status",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/api/users/{user_id}",
      "description": "Deactivate or permanently delete a user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/projects",
      "description": "List projects with pagination, search, and filter by manager",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/projects",
      "description": "Create a new project with metadata and assign creator as manager",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/projects/{project_id}",
      "description": "Retrieve detailed information for a specific project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "PUT",
      "path": "/api/projects/{project_id}",
      "description": "Update project fields such as name, description, dates",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/projects/{project_id}/members",
      "description": "Add one or more users to a project with assigned role (manager/member)",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/tasks",
      "description": "List tasks across projects with pagination, search, and optional assignee filter",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/tasks",
      "description": "Create a new task within a project; body includes project_id, title, deadline, etc.",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/tasks/{task_id}",
      "description": "Get full details of a specific task, including attachments",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/tasks/{task_id}",
      "description": "Partial update of a task (status change, assignee reassignment, description edit)",
      "file": "app/routes/task_routes.py"
    }
  ],
