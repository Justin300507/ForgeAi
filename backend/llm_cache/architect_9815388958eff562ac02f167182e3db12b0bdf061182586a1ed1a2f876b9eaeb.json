{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and issue JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile and dietary preferences of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "List recipes with pagination, full\u2011text search and filter support",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a recipe, including ingredients and nutrition",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe (optionally with image upload)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/meal-plans",
      "description": "List meal plans owned or shared with the authenticated user",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/meal-plans",
      "description": "Create a new weekly meal plan",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "GET",
      "path": "/meal-plans/{id}",
      "description": "Retrieve a meal plan with its assigned recipes and sharing settings",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "PUT",
      "path": "/meal-plans/{id}",
      "description": "Update a meal plan (add/remove items, change collaborators, edit dates)",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "GET",
      "path": "/meal-plans/{id}/shopping-list",
      "description": "Generate or fetch the consolidated shopping list for the specified meal plan",
      "file": "app/routes/shoppinglist_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/meal-plans/{id}/shopping-list",
      "description": "Edit shopping list items (add, remove, adjust quantities)",
      "file": "app/routes/shoppinglist_routes.py"
    },
    {
      "method": "GET",
      "path": "/favorites",
      "description": "List the authenticated user's favorite recipes",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "POST",
      "path": "/favorites",
      "description": "Add a recipe to favorites with optional personal notes",
      "file": "app/routes/favorite_routes.py"
    }
  ],
