{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with optional search (title or author) and pagination.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book with associated author IDs and optional cover image URL.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{book_id}",
      "description": "Retrieve detailed information for a specific book, including its authors.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{book_id}",
      "description": "Update fields of an existing book (e.g., title, ISBN, cover image).",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{book_id}",
      "description": "Delete a book from the catalog.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author record.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/members",
      "description": "List library members with pagination.",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Register a new library member (creates Member and associated User with role=member).",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/{member_id}",
      "description": "Update member details such as email, name, or activation status.",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members/{member_id}/avatar",
      "description": "Upload a profile picture for a member; returns the stored avatar URL.",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Create a borrowing record for an available book; sets due_date 14 days from now.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a currently borrowed book; assigns queue position.",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reservations/{reservation_id}",
      "description": "Cancel a reservation and shift subsequent queue positions.",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/overdue",
      "description": "Return a list of overdue borrowings; supports CSV export via ?format=csv.",
      "file": "app/routes/report_routes.py"
    }
  ],
