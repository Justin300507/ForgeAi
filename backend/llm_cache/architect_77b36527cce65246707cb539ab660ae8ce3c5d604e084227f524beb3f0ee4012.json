{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/songs",
      "description": "List all songs owned by the user with optional pagination",
      "file": "app/routes/song_routes.py"
    },
    {
      "method": "POST",
      "path": "/songs",
      "description": "Create a new song in the user's library",
      "file": "app/routes/song_routes.py"
    },
    {
      "method": "GET",
      "path": "/songs/{id}",
      "description": "Get detailed information for a specific song",
      "file": "app/routes/song_routes.py"
    },
    {
      "method": "PUT",
      "path": "/songs/{id}",
      "description": "Update metadata of an existing song",
      "file": "app/routes/song_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/songs/{id}",
      "description": "Remove a song from the user's library",
      "file": "app/routes/song_routes.py"
    },
    {
      "method": "GET",
      "path": "/songs/search",
      "description": "Search songs by title, artist, album, or genre",
      "file": "app/routes/song_routes.py"
    },
    {
      "method": "GET",
      "path": "/playlists",
      "description": "List all playlists owned by the user",
      "file": "app/routes/playlist_routes.py"
    },
    {
      "method": "POST",
      "path": "/playlists",
      "description": "Create a new playlist",
      "file": "app/routes/playlist_routes.py"
    },
    {
      "method": "GET",
      "path": "/playlists/{id}",
      "description": "Retrieve details and songs of a specific playlist",
      "file": "app/routes/playlist_routes.py"
    },
    {
      "method": "PUT",
      "path": "/playlists/{id}",
      "description": "Update playlist name or description",
      "file": "app/routes/playlist_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/playlists/{id}",
      "description": "Delete a playlist",
      "file": "app/routes/playlist_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/playlists/{id}/songs",
      "description": "Add or remove songs in a playlist (request body specifies action)",
      "file": "app/routes/playlist_routes.py"
    }
  ],
