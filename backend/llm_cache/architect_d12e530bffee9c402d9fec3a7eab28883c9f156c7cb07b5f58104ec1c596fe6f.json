{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/products",
      "description": "Retrieve list of all products",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/products",
      "description": "Create a new product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Retrieve details of a specific product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "PUT",
      "path": "/products/{id}",
      "description": "Update an existing product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/products/{id}",
      "description": "Delete a product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/suppliers",
      "description": "Retrieve list of all suppliers",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "POST",
      "path": "/suppliers",
      "description": "Create a new supplier",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "GET",
      "path": "/suppliers/{id}",
      "description": "Retrieve details of a specific supplier",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "PUT",
      "path": "/suppliers/{id}",
      "description": "Update an existing supplier",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/suppliers/{id}",
      "description": "Delete a supplier",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "GET",
      "path": "/transactions",
      "description": "Retrieve list of stock in/out transactions",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "POST",
      "path": "/transactions",
      "description": "Record a stock in or out transaction",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/stock",
      "description": "Get stock overview for dashboard",
      "file": "app/routes/report_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/low-stock",
      "description": "Get list of products below reorder level",
      "file": "app/routes/report_routes.py"
    }
  ],
