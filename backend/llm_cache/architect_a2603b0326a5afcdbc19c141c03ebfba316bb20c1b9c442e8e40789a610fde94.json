{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account (diner role by default)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/restaurants",
      "description": "List restaurants with pagination and optional search filters (name, city, cuisine)",
      "file": "app/routes/restaurant_routes.py"
    },
    {
      "method": "POST",
      "path": "/restaurants",
      "description": "Create a new restaurant (admin or manager)",
      "file": "app/routes/restaurant_routes.py"
    },
    {
      "method": "PUT",
      "path": "/restaurants/{id}",
      "description": "Update restaurant details, including opening hours and image upload",
      "file": "app/routes/restaurant_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/restaurants/{id}",
      "description": "Delete a restaurant (admin only)",
      "file": "app/routes/restaurant_routes.py"
    },
    {
      "method": "GET",
      "path": "/restaurants/{id}/available-slots",
      "description": "Return time slots for a given date with remaining capacity",
      "file": "app/routes/restaurant_routes.py"
    },
    {
      "method": "GET",
      "path": "/restaurants/{id}/tables",
      "description": "List tables for the specified restaurant (manager view)",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "POST",
      "path": "/restaurants/{id}/tables",
      "description": "Create a new table with number and seat capacity",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "PUT",
      "path": "/restaurants/{id}/tables/{table_id}",
      "description": "Edit table number or capacity",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/restaurants/{id}/tables/{table_id}",
      "description": "Delete a table if no future reservations exist",
      "file": "app/routes/table_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations",
      "description": "List reservations for the authenticated diner with pagination",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a selected time slot and party size",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "PUT",
      "path": "/reservations/{id}",
      "description": "Modify reservation date, time slot or party size (subject to constraints)",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reservations/{id}",
      "description": "Cancel a reservation within allowed time window",
      "file": "app/routes/reservation_routes.py"
    }
  ],
