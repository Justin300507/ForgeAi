{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, password and role (candidate or employer)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the authenticated candidate's profile",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update the authenticated candidate's profile information",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List job listings with pagination and optional filters (status, location, tags)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update a job listing (employer only, must own the job)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Archive (soft\u2011delete) a job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job with selected resume and optional cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/job/{job_id}",
      "description": "List applications for a specific job with optional status filter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Change the status of an application (e.g., Reviewed, Interview, Rejected, Hired)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "POST",
      "path": "/resumes",
      "description": "Upload a resume file (PDF or DOCX) for the authenticated candidate",
      "file": "app/routes/resume_routes.py"
    },
    {
      "method": "GET",
      "path": "/search/candidates",
      "description": "Search candidate profiles by keyword, location, skills, and experience with pagination",
      "file": "app/routes/search_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "Retrieve recent notifications for the authenticated user",
      "file": "app/routes/notification_routes.py"
    }
  ],
