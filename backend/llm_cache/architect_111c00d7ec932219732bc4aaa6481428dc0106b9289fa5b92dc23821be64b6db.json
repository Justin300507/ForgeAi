{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new library member and create associated user credentials.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "Retrieve a paginated list of books with optional keyword search (title, author, ISBN).",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Get detailed information for a single book, including linked authors.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record with cover image upload and associate authors.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update an existing book's data; supports cover image replacement while preserving author links.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book from the catalog.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List all authors with pagination.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author record.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PUT",
      "path": "/authors/{id}",
      "description": "Update author details.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Create a borrowing record for an available book; sets due date 14 days ahead and marks book as checked_out.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings/{id}/return",
      "description": "Mark a borrowing as returned; updates book status to available and calculates any overdue fine.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a checked\u2011out book; adds member to the queue ordered by request timestamp.",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/overdue",
      "description": "Return a paginated list of overdue borrowings with member contact info and days overdue.",
      "file": "app/routes/reports_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/members/{id}",
      "description": "Deactivate a member account (status='inactive'); prevents future logins.",
      "file": "app/routes/member_routes.py"
    }
  ],
