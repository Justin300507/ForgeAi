{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies",
      "description": "List companies with search and pagination",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies",
      "description": "Create a new company record",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "PUT",
      "path": "/companies/{id}",
      "description": "Update company details",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/companies/{id}",
      "description": "Delete a company",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications with filters and pagination",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Create a new job application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PUT",
      "path": "/applications/{id}",
      "description": "Update application details",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/interviews",
      "description": "List upcoming interviews",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "POST",
      "path": "/interviews",
      "description": "Schedule a new interview for an application",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "GET",
      "path": "/interviews/{id}",
      "description": "Get interview details",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "PUT",
      "path": "/interviews/{id}",
      "description": "Edit interview details",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications/{app_id}/status_updates",
      "description": "Add a status update to an application",
      "file": "app/routes/status_update_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications/{app_id}/documents",
      "description": "Upload a document (resume or cover letter) for an application",
      "file": "app/routes/document_routes.py"
    }
  ],
