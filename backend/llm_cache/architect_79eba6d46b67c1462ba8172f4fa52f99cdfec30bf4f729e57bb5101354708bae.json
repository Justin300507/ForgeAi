{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/books",
      "description": "Retrieve a list of all books",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve details of a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update information of a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a specific book from the catalog",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/search",
      "description": "Search books by title, author, or ISBN",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/members",
      "description": "Retrieve a list of all library members",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Register a new library member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/{id}",
      "description": "Retrieve details of a specific member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/{id}",
      "description": "Update information of a specific member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/members/{id}",
      "description": "Deactivate or delete a specific member",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/loans",
      "description": "Retrieve a list of all loan records",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "GET",
      "path": "/loans/{id}",
      "description": "Retrieve details of a specific loan",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "POST",
      "path": "/loans/checkout",
      "description": "Checkout a book to a member (create loan)",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "POST",
      "path": "/loans/return",
      "description": "Return a book (update loan status)",
      "file": "app/routes/loan_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "book",
      "columns": [
