{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user, store hashed password, send email verification link, and return 200 OK",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/verify",
      "description": "Verify user's email using token query parameter, activate account, and return confirmation",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials, issue JWT access token (24h) and refresh token, return tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "description": "Invalidate current JWT (e.g., add to blacklist) and return logout confirmation",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Return profile of the authenticated user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "List tasks belonging to the authenticated user with pagination, priority filter, due date range, and search on title/description",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new task for the authenticated user with title, optional description, priority, and due date",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Retrieve a single task by ID if it belongs to the authenticated user",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tasks/{id}",
      "description": "Update title, description, priority, or due date of an owned task; reject past due dates",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tasks/{id}",
      "description": "Delete an owned task and return 204 No Content",
      "file": "app/routes/task_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "hashed_password",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "is_active",
          "type": "BOOLEAN",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "tasks",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "title",
          "type": "VARCHAR(200)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "description",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "priority",
          "type": "VARCHAR(10)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "due_date",
          "type": "DATE",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "updated_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "email_verifications",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "token",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "expires_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "app",
      "app/models",
      "app/schemas",
      "app/routes",
      "app/services",
      "app/utils",
      "app/core",
      "app/dependencies",
      "app/config"
    ]
  },
  "frontend_structure": {
    "pages": [
      "SignUpPage",
      "LoginPage",
      "TaskListPage",
      "TaskDetailPage",
      "TaskCreatePage"
    ],
    "components": [
      "Header",
      "Footer",
      "TaskCard",
      "TaskForm",
      "PaginationControls",
      "SearchBar",
      "PriorityBadge",
      "DatePicker",
      "ProtectedRoute",
      "NotificationToast"
    ]
  }
}