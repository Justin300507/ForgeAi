{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/accounts",
      "description": "Retrieve list of accounts for the authenticated user",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "POST",
      "path": "/accounts",
      "description": "Create a new financial account",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "PUT",
      "path": "/accounts/{id}",
      "description": "Update account details",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/accounts/{id}",
      "description": "Delete an account",
      "file": "app/routes/account_routes.py"
    },
    {
      "method": "GET",
      "path": "/transactions",
      "description": "List transactions for the authenticated user with optional filters",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "POST",
      "path": "/transactions",
      "description": "Record a new transaction",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "PUT",
      "path": "/transactions/{id}",
      "description": "Update an existing transaction",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/transactions/{id}",
      "description": "Delete a transaction",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "Retrieve list of expense categories for the user",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new expense category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/budgets",
      "description": "Get budget limits per category for the current month",
      "file": "app/routes/budget_routes.py"
    },
    {
      "method": "POST",
      "path": "/budgets",
      "description": "Set or update a budget limit for a category",
      "file": "app/routes/budget_routes.py"
    }
  ],
