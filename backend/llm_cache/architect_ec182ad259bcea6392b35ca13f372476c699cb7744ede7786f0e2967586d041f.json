{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Create a new user account with email, password, and role (mentor or mentee). Returns JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile, including role\u2011specific details.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update personal information and upload a profile picture for the authenticated user.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/mentor_applications",
      "description": "Submit a mentor application with resume URL and optional certification documents.",
      "file": "app/routes/mentor_application_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/mentor_applications",
      "description": "Admin view of pending mentor applications with pagination.",
      "file": "app/routes/mentor_application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/mentor_applications/{id}",
      "description": "Admin approves or rejects a mentor application, optionally adding a comment.",
      "file": "app/routes/mentor_application_routes.py"
    },
    {
      "method": "GET",
      "path": "/goals",
      "description": "List the authenticated mentee's goals with pagination and optional status filter.",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals",
      "description": "Create a new learning goal for the authenticated mentee.",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "PUT",
      "path": "/goals/{id}",
      "description": "Update title, description, target date, or status of an existing goal.",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/goals/{id}",
      "description": "Delete a goal owned by the authenticated mentee.",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Book a session by selecting a mentor, a time slot, and duration (30, 60, 90 minutes). Sends email and in\u2011app notifications.",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions/{id}/feedback",
      "description": "Submit session notes and a rating (1\u20115) after a session ends. Feedback is immutable.",
      "file": "app/routes/feedback_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "Retrieve paginated list of notifications for the authenticated user.",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/notifications/{id}",
      "description": "Mark a notification as read or unread.",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "GET",
      "path": "/search/mentors",
      "description": "Search mentors by skill, industry, and next available slot with pagination.",
      "file": "app/routes/search_routes.py"
    }
  ],
