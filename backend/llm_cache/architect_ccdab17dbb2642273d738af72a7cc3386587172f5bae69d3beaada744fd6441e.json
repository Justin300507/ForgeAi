{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users/register",
      "description": "Register a new user with email, name, password and timezone",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}/meetings",
      "description": "List meetings organized by the specified user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/meetings",
      "description": "Create a new meeting with title, description, time range and location",
      "file": "app/routes/meeting_routes.py"
    },
    {
      "method": "GET",
      "path": "/meetings/{id}",
      "description": "Get detailed information of a meeting",
      "file": "app/routes/meeting_routes.py"
    },
    {
      "method": "PUT",
      "path": "/meetings/{id}",
      "description": "Update meeting details such as title, time, location or status",
      "file": "app/routes/meeting_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/meetings/{id}",
      "description": "Cancel a meeting and notify participants",
      "file": "app/routes/meeting_routes.py"
    },
    {
      "method": "POST",
      "path": "/meetings/{id}/participants",
      "description": "Add participants to a meeting invitation list",
      "file": "app/routes/meeting_routes.py"
    },
    {
      "method": "GET",
      "path": "/meetings/{id}/participants",
      "description": "Retrieve list of participants and their response status",
      "file": "app/routes/meeting_routes.py"
    },
    {
      "method": "POST",
      "path": "/meetings/{id}/availability",
      "description": "Submit availability time slots for a participant",
      "file": "app/routes/meeting_routes.py"
    },
    {
      "method": "GET",
      "path": "/meetings/{id}/availability",
      "description": "View aggregated availability and suggested common free slots",
      "file": "app/routes/meeting_routes.py"
    },
    {
      "method": "POST",
      "path": "/integrations",
      "description": "Create a calendar integration record for a user (Google or Outlook)",
      "file": "app/routes/calendarintegration_routes.py"
    },
    {
      "method": "GET",
      "path": "/integrations",
      "description": "List all calendar integrations for the authenticated user",
      "file": "app/routes/calendarintegration_routes.py"
    },
    {
      "method": "POST",
      "path": "/integrations/{id}/sync",
      "description": "Trigger two-way synchronization of meetings with the external calendar provider",
      "file": "app/routes/calendarintegration_routes.py"
    }
  ],
