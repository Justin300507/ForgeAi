{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register new user (member or librarian) and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination and optional search query",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book with author reference and upload cover image",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{book_id}",
      "description": "Retrieve detailed information of a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{book_id}",
      "description": "Update book details and optionally replace cover image",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{book_id}",
      "description": "Delete a book record",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List authors with pagination and optional search",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/{member_id}/dashboard",
      "description": "Return member's active borrowings and reservations with real\u2011time status",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Record borrowing of a book, calculate due date, and update availability",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "GET",
      "path": "/borrowings",
      "description": "List borrowings filtered by status (e.g., overdue) with pagination",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a checked\u2011out book and return queue position",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations",
      "description": "List reservations for the authenticated member with pagination",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/monthly",
      "description": "Generate monthly report of top borrowed books and active members",
      "file": "app/routes/report_routes.py"
    },
    {
      "method": "POST",
      "path": "/notifications/reminders",
      "description": "Send reminder emails to members with overdue borrowings and return summary count",
      "file": "app/routes/notification_routes.py"
    }
  ],
