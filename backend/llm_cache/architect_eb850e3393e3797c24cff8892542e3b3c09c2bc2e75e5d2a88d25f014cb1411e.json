{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account (patient, doctor, or admin)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Retrieve profile of the currently authenticated user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Admin list of all users with pagination",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/doctors",
      "description": "Search and filter doctors by specialty, location, and availability",
      "file": "app/routes/doctor_routes.py"
    },
    {
      "method": "GET",
      "path": "/doctors/{id}",
      "description": "Get detailed information for a specific doctor",
      "file": "app/routes/doctor_routes.py"
    },
    {
      "method": "GET",
      "path": "/availability",
      "description": "Doctor view of their weekly availability slots",
      "file": "app/routes/availability_routes.py"
    },
    {
      "method": "POST",
      "path": "/availability",
      "description": "Create a new availability slot for the authenticated doctor",
      "file": "app/routes/availability_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/availability/{id}",
      "description": "Delete an availability slot (only if no confirmed appointments exist)",
      "file": "app/routes/availability_routes.py"
    },
    {
      "method": "GET",
      "path": "/appointments",
      "description": "List appointments for the authenticated user (patient or doctor) with pagination",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "POST",
      "path": "/appointments",
      "description": "Book an appointment slot; creates a confirmed appointment and notifies both parties",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/appointments/{id}",
      "description": "Cancel an appointment (patient or doctor) and free the slot",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "GET",
      "path": "/health_records",
      "description": "Patient list of their health records with pagination",
      "file": "app/routes/health_record_routes.py"
    },
    {
      "method": "POST",
      "path": "/health_records",
      "description": "Upload a new health record file (PDF/image) linked to the patient",
      "file": "app/routes/health_record_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/appointment_utilization",
      "description": "Admin report of appointment utilization per specialty with optional date range filters",
      "file": "app/routes/report_routes.py"
    }
  ],
