{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get the profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Retrieve a paginated list of public recipes (query params: page, size)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Retrieve detailed information for a specific recipe, including ingredients and steps",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe with title, description, image upload, visibility, ingredients and steps",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe owned by the authenticated user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe owned by the authenticated user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/search",
      "description": "Search public recipes by title or ingredient name (query param: q, pagination params: page, size)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/favorites/{recipe_id}",
      "description": "Add a recipe to the authenticated user's favorites",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/favorites/{recipe_id}",
      "description": "Remove a recipe from the authenticated user's favorites",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "GET",
      "path": "/favorites",
      "description": "List the authenticated user's favorited recipes, ordered by most recent",
      "file": "app/routes/favorite_routes.py"
    }
  ],
