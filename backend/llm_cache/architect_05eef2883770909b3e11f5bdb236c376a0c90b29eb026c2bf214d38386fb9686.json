{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, password and role",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve current authenticated user's basic info",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Get the logged\u2011in candidate's profile",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update candidate profile fields (headline, location, summary)",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidates/me/resume",
      "description": "Upload or replace candidate's resume file (PDF/DOCX \u22645\u202fMB)",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List public job postings with pagination, filters and keyword search",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Retrieve detailed information for a specific job",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update an existing job posting (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Retire or delete a job listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job (candidate only)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/employer/applications",
      "description": "List applications for jobs owned by the authenticated employer, filterable by job_id",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Change the status of an application (employer only)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "POST",
      "path": "/admin/users/{id}/deactivate",
      "description": "Deactivate a user account and revoke all JWT tokens (admin only)",
      "file": "app/routes/admin_routes.py"
    }
  ],
