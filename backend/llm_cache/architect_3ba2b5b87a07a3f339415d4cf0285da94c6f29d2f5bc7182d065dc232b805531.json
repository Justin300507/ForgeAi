{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/vehicles",
      "description": "Retrieve a list of all vehicles",
      "file": "app/routes/vehicle_routes.py"
    },
    {
      "method": "POST",
      "path": "/vehicles",
      "description": "Create a new vehicle record",
      "file": "app/routes/vehicle_routes.py"
    },
    {
      "method": "GET",
      "path": "/vehicles/{id}",
      "description": "Get details of a specific vehicle",
      "file": "app/routes/vehicle_routes.py"
    },
    {
      "method": "PUT",
      "path": "/vehicles/{id}",
      "description": "Update an existing vehicle, including driver assignment",
      "file": "app/routes/vehicle_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/vehicles/{id}",
      "description": "Delete a vehicle record",
      "file": "app/routes/vehicle_routes.py"
    },
    {
      "method": "GET",
      "path": "/drivers",
      "description": "Retrieve a list of all drivers",
      "file": "app/routes/driver_routes.py"
    },
    {
      "method": "POST",
      "path": "/drivers",
      "description": "Create a new driver profile",
      "file": "app/routes/driver_routes.py"
    },
    {
      "method": "GET",
      "path": "/drivers/{id}",
      "description": "Get details of a specific driver",
      "file": "app/routes/driver_routes.py"
    },
    {
      "method": "PUT",
      "path": "/drivers/{id}",
      "description": "Update an existing driver profile",
      "file": "app/routes/driver_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/drivers/{id}",
      "description": "Delete a driver profile",
      "file": "app/routes/driver_routes.py"
    },
    {
      "method": "GET",
      "path": "/maintenancelogs",
      "description": "Retrieve a list of maintenance logs",
      "file": "app/routes/maintenancelog_routes.py"
    },
    {
      "method": "POST",
      "path": "/maintenancelogs",
      "description": "Create a new maintenance log entry",
      "file": "app/routes/maintenancelog_routes.py"
    },
    {
      "method": "GET",
      "path": "/maintenancelogs/{id}",
      "description": "Get details of a specific maintenance log",
      "file": "app/routes/maintenancelog_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/metrics",
      "description": "Provide key fleet metrics for the dashboard",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
