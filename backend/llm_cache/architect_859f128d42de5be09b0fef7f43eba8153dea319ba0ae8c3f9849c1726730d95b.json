{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/books",
      "description": "Retrieve a list of books with optional search filters",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve detailed information for a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record (admin only)",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update an existing book record (admin only)",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book record (admin only)",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/loans",
      "description": "Retrieve a list of all loan records (admin view)",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "GET",
      "path": "/loans/{id}",
      "description": "Retrieve details of a specific loan",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "POST",
      "path": "/loans/borrow",
      "description": "Borrow a book for the authenticated member",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "POST",
      "path": "/loans/return",
      "description": "Return a borrowed book",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new library member",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a member and issue a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Get profile of the currently authenticated member",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/{id}",
      "description": "Retrieve member profile information",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/{id}",
      "description": "Update member profile details",
      "file": "app/routes/member_routes.py"
    }
  ],
