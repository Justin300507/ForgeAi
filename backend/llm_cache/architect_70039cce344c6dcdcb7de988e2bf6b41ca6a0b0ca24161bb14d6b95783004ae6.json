{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account and return JWT tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return JWT tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs",
      "description": "Search and paginate clubs based on genre, location, or keyword",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs",
      "description": "Create a new book club with optional cover image and schedule",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs/{club_id}",
      "description": "Get detailed information of a specific club, including reading schedule and members",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/clubs/{club_id}",
      "description": "Update club metadata or schedule; only organizer or admin can modify",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs/{club_id}/join",
      "description": "Add the authenticated user as a member of the specified club",
      "file": "app/routes/membership_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/clubs/{club_id}/leave",
      "description": "Remove the authenticated user from the club membership",
      "file": "app/routes/membership_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination and optional search filters",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{book_id}",
      "description": "Retrieve detailed information for a single book, including reviews",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/reading-list/items",
      "description": "Add a book to the user's personal reading list or to a club schedule",
      "file": "app/routes/readinglist_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/reading-list/items/{item_id}",
      "description": "Update progress status, start/end dates, or remove the item from the list",
      "file": "app/routes/readinglist_routes.py"
    },
    {
      "method": "POST",
      "path": "/discussions/threads",
      "description": "Create a new discussion thread within a club",
      "file": "app/routes/discussion_routes.py"
    },
    {
      "method": "POST",
      "path": "/discussions/threads/{thread_id}/comments",
      "description": "Post a comment to a discussion thread; broadcast via WebSocket",
      "file": "app/routes/comment_routes.py"
    }
  ],
