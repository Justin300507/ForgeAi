{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/users/{id}/role",
      "description": "Update role of a user (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects",
      "description": "List all projects visible to the authenticated user (paginated)",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects",
      "description": "Create a new project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{id}",
      "description": "Get detailed information of a specific project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/projects/{id}",
      "description": "Update project fields or archive the project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{project_id}/issues",
      "description": "List issues for a project with optional filters and pagination",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects/{project_id}/issues",
      "description": "Create a new issue within a project",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "GET",
      "path": "/issues/{id}",
      "description": "Retrieve detailed information of a specific issue",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/issues/{id}",
      "description": "Update issue fields such as status, priority, assignee, or description",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "GET",
      "path": "/issues/{issue_id}/comments",
      "description": "List comments for an issue (threaded, paginated)",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/issues/{issue_id}/comments",
      "description": "Add a new comment to an issue",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/issues/{issue_id}/attachments",
      "description": "Upload an attachment file to an issue",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/attachments/{id}",
      "description": "Download an attachment file",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/search",
      "description": "Full\u2011text search across projects and issues with filters",
      "file": "app/routes/search_routes.py"
    }
  ],
