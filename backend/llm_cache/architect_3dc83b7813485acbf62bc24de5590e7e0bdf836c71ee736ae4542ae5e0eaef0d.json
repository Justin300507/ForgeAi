{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/households",
      "description": "Create a new household and assign the creator as owner",
      "file": "app/routes/household_routes.py"
    },
    {
      "method": "POST",
      "path": "/households/{id}/invite",
      "description": "Send an invitation to join a household with a specific role",
      "file": "app/routes/invitation_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List categories for the current household or personal scope with pagination and search",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new expense category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/categories/{id}",
      "description": "Delete a category; reassign its expenses to the default \"Uncategorized\" category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/expenses",
      "description": "Retrieve paginated list of expenses with optional search filters",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "POST",
      "path": "/expenses",
      "description": "Create a new expense record",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "PUT",
      "path": "/expenses/{id}",
      "description": "Update an existing expense",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/expenses/{id}",
      "description": "Delete an expense record",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "POST",
      "path": "/budgets",
      "description": "Set or update a monthly budget limit for a category",
      "file": "app/routes/budget_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/summary",
      "description": "Return monthly summary of spend vs. budget per category",
      "file": "app/routes/dashboard_routes.py"
    },
    {
      "method": "POST",
      "path": "/expenses/import",
      "description": "Upload a CSV file to bulk import expenses; returns a job identifier",
      "file": "app/routes/expense_routes.py"
    }
  ],
