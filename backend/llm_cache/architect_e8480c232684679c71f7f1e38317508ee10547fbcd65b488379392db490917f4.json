{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account (musician or teacher)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/instruments",
      "description": "List all instruments belonging to the current musician",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "POST",
      "path": "/instruments",
      "description": "Create a new instrument for the current musician",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/instruments/{id}",
      "description": "Delete an instrument owned by the current musician",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions",
      "description": "List practice sessions for the current musician with pagination",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Record a new practice session (date, instrument, duration, pieces)",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "GET",
      "path": "/goals",
      "description": "List time\u2011based goals for the current musician",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals",
      "description": "Create a new practice goal for a specific instrument",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "GET",
      "path": "/notes",
      "description": "List progress notes for the current musician (searchable)",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "POST",
      "path": "/notes",
      "description": "Add a progress note linked to a practice session",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "POST",
      "path": "/attachments",
      "description": "Upload an audio/video file and associate it with a practice session",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "POST",
      "path": "/teacher/invite",
      "description": "Teacher sends an invitation link to a new student",
      "file": "app/routes/teacher_routes.py"
    },
    {
      "method": "GET",
      "path": "/teacher/students",
      "description": "Teacher retrieves list of assigned students with summary stats",
      "file": "app/routes/teacher_routes.py"
    }
  ],
  "database_schema": [
