{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/properties",
      "description": "Search properties with full\u2011text, faceted filters, pagination and sorting",
      "file": "app/routes/property_routes.py"
    },
    {
      "method": "GET",
      "path": "/properties/{id}",
      "description": "Get detailed information for a single property",
      "file": "app/routes/property_routes.py"
    },
    {
      "method": "POST",
      "path": "/properties",
      "description": "Create a new property listing (agent only)",
      "file": "app/routes/property_routes.py"
    },
    {
      "method": "PUT",
      "path": "/properties/{id}",
      "description": "Update an existing property listing (owner agent)",
      "file": "app/routes/property_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/properties/{id}",
      "description": "Delete a property listing and its photos (owner agent)",
      "file": "app/routes/property_routes.py"
    },
    {
      "method": "POST",
      "path": "/photos",
      "description": "Upload one or more photos for a property (multipart/form-data)",
      "file": "app/routes/photo_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/photos/{id}",
      "description": "Delete a photo from a property",
      "file": "app/routes/photo_routes.py"
    },
    {
      "method": "GET",
      "path": "/favorites",
      "description": "List the authenticated user's saved favorite properties",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "POST",
      "path": "/favorites",
      "description": "Add a property to the user's favorites",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/favorites/{property_id}",
      "description": "Remove a property from the user's favorites",
      "file": "app/routes/favorite_routes.py"
    },
    {
      "method": "GET",
      "path": "/agents/{id}",
      "description": "Retrieve an agent's profile and their active listings",
      "file": "app/routes/agent_routes.py"
    },
    {
      "method": "POST",
      "path": "/contact_requests",
      "description": "Send a contact request/message from a buyer to an agent about a property",
      "file": "app/routes/contactrequest_routes.py"
    }
  ],
