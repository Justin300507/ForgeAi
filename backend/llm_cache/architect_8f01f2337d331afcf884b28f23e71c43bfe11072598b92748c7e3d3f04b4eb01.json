{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "List users with pagination and optional search by email",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users",
      "description": "Create a new user (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects",
      "description": "List projects with pagination and name search",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects",
      "description": "Create a new project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{project_id}",
      "description": "Get detailed information of a project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{project_id}/issues",
      "description": "List issues for a project with filters, pagination, and search",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects/{project_id}/issues",
      "description": "Create a new issue in a project (default status Open, priority Medium)",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/issues/{issue_id}",
      "description": "Update mutable fields of an issue (status, assignee, priority, title, description)",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "GET",
      "path": "/issues/{issue_id}",
      "description": "Retrieve detailed information of an issue",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "POST",
      "path": "/issues/{issue_id}/comments",
      "description": "Add a comment to an issue, optionally with file attachments",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/issues/{issue_id}/attachments",
      "description": "Upload an attachment to an issue (max 5\u202fMB, stored with UUID filename)",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{project_id}/workflow",
      "description": "Get the ordered workflow steps for a project",
      "file": "app/routes/workflow_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects/{project_id}/workflow",
      "description": "Define or replace the workflow steps for a project",
      "file": "app/routes/workflow_routes.py"
    }
  ],
