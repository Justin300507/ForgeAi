{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account with email, password, and role.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile information.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update the authenticated user's profile (e.g., email, password).",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/instruments",
      "description": "List all instruments belonging to the authenticated musician.",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "POST",
      "path": "/instruments",
      "description": "Create a new instrument for the authenticated musician.",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "PUT",
      "path": "/instruments/{id}",
      "description": "Update name or type of an existing instrument.",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/instruments/{id}",
      "description": "Delete an instrument owned by the authenticated musician.",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions",
      "description": "Paginated list of practice sessions for the authenticated user, with optional filters.",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Log a new practice session (instrument, date, duration, optional notes).",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "GET",
      "path": "/goals",
      "description": "List all practice goals for the authenticated musician.",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals",
      "description": "Create a new practice goal for a specific instrument.",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "GET",
      "path": "/teachers/students",
      "description": "Retrieve the list of students assigned to the authenticated teacher.",
      "file": "app/routes/teacher_routes.py"
    },
    {
      "method": "POST",
      "path": "/teachers/students",
      "description": "Assign a musician as a student to the authenticated teacher.",
      "file": "app/routes/teacher_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/summary",
      "description": "Provide aggregated practice statistics and goal progress for the dashboard view.",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
