{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/register",
      "description": "Create a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Get public information of a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile details",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "List tasks for the authenticated user (optional tag filter)",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Retrieve details of a specific task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tasks/{id}",
      "description": "Update an existing task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tasks/{id}",
      "description": "Delete a task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks?tag={tag_id}",
      "description": "List tasks filtered by tag",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tags",
      "description": "List all tags for the authenticated user",
      "file": "app/routes/tag_routes.py"
    },
    {
      "method": "POST",
      "path": "/tags",
      "description": "Create a new tag",
      "file": "app/routes/tag_routes.py"
    },
    {
      "method": "GET",
      "path": "/tags/{id}",
      "description": "Retrieve details of a specific tag",
      "file": "app/routes/tag_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tags/{id}",
      "description": "Update tag name or color",
      "file": "app/routes/tag_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "hashed_password",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "full_name",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "tasks",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "title",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "description",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "due_date",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "priority",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "completed",
          "type": "BOOLEAN",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "tag_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "tags",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "name",
          "type": "VARCHAR(100)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "color",
          "type": "VARCHAR(7)",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
