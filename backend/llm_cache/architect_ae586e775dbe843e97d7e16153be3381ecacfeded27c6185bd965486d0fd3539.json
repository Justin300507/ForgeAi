{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user (librarian can create members)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "Get paginated list of books with optional search query",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve detailed information for a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record with cover image upload",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update an existing book's details",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book from the catalog",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "Get paginated list of authors",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors/{id}",
      "description": "Retrieve details of a specific author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author record",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PUT",
      "path": "/authors/{id}",
      "description": "Update author information",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/borrowings",
      "description": "List borrowings (filterable by member or overdue)",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Create a borrowing record when a member checks out a book",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings/{id}/return",
      "description": "Process return of a borrowed book and calculate late fee if applicable",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a currently borrowed book and assign queue position",
      "file": "app/routes/reservation_routes.py"
    }
  ],
