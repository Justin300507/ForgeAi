{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user (candidate, employer, or admin) and return a JWT.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and issue a JWT.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Initiate password reset flow (send reset email).",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the authenticated candidate's profile.",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update the authenticated candidate's profile (including skills and picture).",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/employers/me",
      "description": "Retrieve the authenticated employer's profile.",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employers/me",
      "description": "Update the authenticated employer's profile (company info, logo, etc.).",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (employer only).",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Search and filter active job listings with pagination.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update a job listing (owner employer) including status (active/inactive).",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit a job application with resume upload and optional cover letter.",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications: candidates see their own; employers see applications for their jobs (supports pagination and job filter).",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PUT",
      "path": "/applications/{id}",
      "description": "Employer updates application status (reviewed, interview, rejected, hired).",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/logs",
      "description": "Admin retrieves audit logs of moderation actions with pagination.",
      "file": "app/routes/admin_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/users/{id}",
      "description": "Admin deactivates a user account (candidate or employer).",
      "file": "app/routes/admin_routes.py"
    }
  ],
