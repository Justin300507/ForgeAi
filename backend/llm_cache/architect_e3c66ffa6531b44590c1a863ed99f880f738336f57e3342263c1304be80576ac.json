{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions",
      "description": "List subscriptions with pagination, search by service name and optional filters",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "POST",
      "path": "/subscriptions",
      "description": "Create a new subscription record",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions/{id}",
      "description": "Retrieve details of a specific subscription",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "PUT",
      "path": "/subscriptions/{id}",
      "description": "Update an existing subscription",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/subscriptions/{id}",
      "description": "Delete a subscription",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List user-defined categories",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/analytics/monthly-spend",
      "description": "Return aggregated monthly spending totals and trends for the past year",
      "file": "app/routes/analytics_routes.py"
    },
    {
      "method": "POST",
      "path": "/imports/subscriptions",
      "description": "Upload a CSV file to bulk import subscriptions",
      "file": "app/routes/import_routes.py"
    },
    {
      "method": "GET",
      "path": "/exports/subscriptions",
      "description": "Download all user subscriptions as a CSV file",
      "file": "app/routes/export_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "List notification configurations for the authenticated user",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "POST",
      "path": "/notifications",
      "description": "Create or update a reminder notification for a subscription",
      "file": "app/routes/notification_routes.py"
    }
  ],
