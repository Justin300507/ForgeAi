{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account with email, password and role (candidate, employer, admin). Sends verification email.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the authenticated candidate's profile details.",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update the authenticated candidate's profile fields (name, headline, location, summary, etc.).",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidates/me/resume",
      "description": "Upload or replace the candidate's resume PDF (max 5\u202fMB). Stores file URL in profile.",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/employers/me",
      "description": "Retrieve the authenticated employer's company profile.",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employers/me",
      "description": "Update the employer's company profile fields and optionally upload a logo image (PNG/JPG \u2264\u202f2\u202fMB).",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Public job listings with search (keyword), filters (location, type, salary range) and pagination (20 per page).",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job listing.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (employer only). Requires title, description, location, employment type, salary range, required skills, and optional tags.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update an existing job listing owned by the employer. Allowed within 24\u202fhours of posting.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Delete a job listing owned by the employer.",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications for the employer's jobs. Supports query parameter ?job_id= to filter by specific job.",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}",
      "description": "Update the status of a specific application (e.g., Under Review, Interview, Rejected, Hired).",
      "file": "app/routes/application_routes.py"
    }
  ],
