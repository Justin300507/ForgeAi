{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/users",
      "description": "List users with pagination (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/users/{user_id}",
      "description": "Update user role or activation status (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/courses",
      "description": "Create a new course (instructor)",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/courses",
      "description": "List courses with pagination and keyword search",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/courses/{course_id}",
      "description": "Retrieve detailed information of a specific course",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "PUT",
      "path": "/api/courses/{course_id}",
      "description": "Update course metadata (owner only)",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/api/courses/{course_id}",
      "description": "Delete a course (owner only)",
      "file": "app/routes/course_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/courses/{course_id}/lessons",
      "description": "Add an ordered lesson to a course with optional asset upload",
      "file": "app/routes/lesson_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/courses/{course_id}/lessons",
      "description": "List lessons of a course sorted by order",
      "file": "app/routes/lesson_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/quizzes",
      "description": "Create a quiz linked to a lesson with questions and answer options",
      "file": "app/routes/quiz_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/quizzes/{quiz_id}/attempts",
      "description": "Submit answers for a quiz attempt and receive a score",
      "file": "app/routes/quiz_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/enrollments",
      "description": "Enroll the authenticated student in a course",
      "file": "app/routes/enrollment_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/dashboard",
      "description": "Get progress summary for the authenticated user across enrolled courses",
      "file": "app/routes/progress_routes.py"
    }
  ],
