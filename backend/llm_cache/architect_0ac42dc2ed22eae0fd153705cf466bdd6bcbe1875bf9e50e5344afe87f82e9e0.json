{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts",
      "description": "List recent posts (used for general browsing)",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts",
      "description": "Create a new post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}",
      "description": "Retrieve a single post with details",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "PUT",
      "path": "/posts/{id}",
      "description": "Edit an existing post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/posts/{id}",
      "description": "Delete a post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/follow",
      "description": "Follow another user (requires follower_id and following_id in body)",
      "file": "app/routes/follow_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/follow",
      "description": "Unfollow a user (requires follower_id and following_id in body)",
      "file": "app/routes/follow_routes.py"
    },
    {
      "method": "GET",
      "path": "/feed",
      "description": "Get personalized feed of posts from followed users",
      "file": "app/routes/feed_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{id}/like",
      "description": "Like a post",
      "file": "app/routes/like_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/posts/{id}/like",
      "description": "Remove like from a post",
      "file": "app/routes/like_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{id}/comment",
      "description": "Add a comment to a post",
      "file": "app/routes/comment_routes.py"
    }
  ],
