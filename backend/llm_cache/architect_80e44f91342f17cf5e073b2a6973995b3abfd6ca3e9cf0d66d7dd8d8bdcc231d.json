{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve a list of all users (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve details of a specific user by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users",
      "description": "Create a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile information and bot preferences",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/users/{id}",
      "description": "Delete a user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and create initial profile",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions",
      "description": "Get all chat sessions for the authenticated user",
      "file": "app/routes/chat_session_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Create a new chat session",
      "file": "app/routes/chat_session_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions/{id}",
      "description": "Retrieve a specific chat session by ID",
      "file": "app/routes/chat_session_routes.py"
    },
    {
      "method": "PUT",
      "path": "/sessions/{id}",
      "description": "Update chat session metadata (e.g., title)",
      "file": "app/routes/chat_session_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/sessions/{id}",
      "description": "Delete a chat session and its messages",
      "file": "app/routes/chat_session_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions/{session_id}/messages",
      "description": "Retrieve all messages for a given chat session",
      "file": "app/routes/message_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions/{session_id}/messages",
      "description": "Add a new message to a chat session (user or bot)",
      "file": "app/routes/message_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/messages/{id}",
      "description": "Delete a specific message by ID",
      "file": "app/routes/message_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
