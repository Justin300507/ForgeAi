{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and receive a JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and set an HttpOnly JWT cookie.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/refresh",
      "description": "Refresh the access token using a valid refresh token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts",
      "description": "Retrieve a paginated list of the authenticated user's workouts.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "POST",
      "path": "/workouts",
      "description": "Create a new workout with nested exercises and sets.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts/{id}",
      "description": "Get details of a specific workout, including its exercises and sets.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "PUT",
      "path": "/workouts/{id}",
      "description": "Update workout information or modify its exercises/sets.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/workouts/{id}",
      "description": "Delete a workout and all associated exercise and set entries.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/search/workouts",
      "description": "Search workouts by exercise name (case\u2011insensitive) with pagination.",
      "file": "app/routes/search_routes.py"
    },
    {
      "method": "GET",
      "path": "/personal-records",
      "description": "List the user's personal records for each exercise.",
      "file": "app/routes/personal_record_routes.py"
    },
    {
      "method": "GET",
      "path": "/reminders",
      "description": "Retrieve all reminders set by the authenticated user.",
      "file": "app/routes/reminder_routes.py"
    },
    {
      "method": "POST",
      "path": "/reminders",
      "description": "Create a new daily workout reminder.",
      "file": "app/routes/reminder_routes.py"
    },
    {
      "method": "PUT",
      "path": "/reminders/{id}",
      "description": "Update an existing reminder's time, days, or enabled status.",
      "file": "app/routes/reminder_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reminders/{id}",
      "description": "Delete a reminder.",
      "file": "app/routes/reminder_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Return the profile of the currently authenticated user.",
      "file": "app/routes/user_routes.py"
    }
  ],
