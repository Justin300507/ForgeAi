{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Retrieve a paginated list of all recipes for browsing",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Retrieve detailed information for a single recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe (future contribution feature)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/search",
      "description": "Search recipes by keyword query parameter",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all recipe categories",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories/{id}",
      "description": "Get details of a specific category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and issue a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/favourites",
      "description": "List the authenticated user's favourite recipes",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/favourites/{recipe_id}",
      "description": "Add a recipe to the authenticated user's favourites",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/users/favourites/{recipe_id}",
      "description": "Remove a recipe from the authenticated user's favourites",
      "file": "app/routes/user_routes.py"
    }
  ],
