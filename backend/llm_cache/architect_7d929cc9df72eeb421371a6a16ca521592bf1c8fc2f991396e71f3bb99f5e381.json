{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and issue access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/transactions",
      "description": "Create a new income or expense transaction",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "GET",
      "path": "/transactions",
      "description": "List all transactions for the authenticated user",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "GET",
      "path": "/transactions/{id}",
      "description": "Retrieve details of a specific transaction",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "PUT",
      "path": "/transactions/{id}",
      "description": "Update an existing transaction",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/transactions/{id}",
      "description": "Delete a transaction",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new budget category with limit",
      "file": "app/routes/budgetcategory_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all budget categories for the user",
      "file": "app/routes/budgetcategory_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories/{id}",
      "description": "Retrieve a specific budget category",
      "file": "app/routes/budgetcategory_routes.py"
    },
    {
      "method": "PUT",
      "path": "/categories/{id}",
      "description": "Update budget category details or limit",
      "file": "app/routes/budgetcategory_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/categories/{id}",
      "description": "Remove a budget category",
      "file": "app/routes/budgetcategory_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/summary",
      "description": "Get income, expense totals and budget utilization for the current month",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
