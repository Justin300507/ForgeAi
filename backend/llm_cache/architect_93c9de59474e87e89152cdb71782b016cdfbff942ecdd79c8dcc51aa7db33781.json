{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve current user's profile including mentor/mentee details",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update current user's profile (bio, interests, expertise)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/mentors",
      "description": "Search and filter mentor profiles with pagination and match score",
      "file": "app/routes/mentorprofile_routes.py"
    },
    {
      "method": "GET",
      "path": "/mentees/{id}",
      "description": "View read-only mentee profile with goals and availability",
      "file": "app/routes/menteeprofile_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals",
      "description": "Create a new goal for the current mentee",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "PUT",
      "path": "/goals/{id}",
      "description": "Update goal status or details",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Request a mentorship session with selected mentor and time slot",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/sessions/{id}/status",
      "description": "Accept or decline a session request, updating status",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "POST",
      "path": "/feedback",
      "description": "Submit feedback and rating for a completed session",
      "file": "app/routes/feedback_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/analytics",
      "description": "Retrieve platform usage statistics for admin dashboard",
      "file": "app/routes/admin_routes.py"
    }
  ],
