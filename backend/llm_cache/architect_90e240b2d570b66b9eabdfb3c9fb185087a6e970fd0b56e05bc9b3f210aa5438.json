{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/clients",
      "description": "Retrieve a list of all clients",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "POST",
      "path": "/clients",
      "description": "Create a new client record",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "GET",
      "path": "/clients/{id}",
      "description": "Retrieve details of a specific client",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "PUT",
      "path": "/clients/{id}",
      "description": "Update an existing client record",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/clients/{id}",
      "description": "Delete a client record",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "GET",
      "path": "/invoices",
      "description": "Retrieve a list of all invoices",
      "file": "app/routes/invoice_routes.py"
    },
    {
      "method": "POST",
      "path": "/invoices",
      "description": "Create a new invoice with line items",
      "file": "app/routes/invoice_routes.py"
    },
    {
      "method": "GET",
      "path": "/invoices/{id}",
      "description": "Retrieve details of a specific invoice, including line items",
      "file": "app/routes/invoice_routes.py"
    },
    {
      "method": "PUT",
      "path": "/invoices/{id}",
      "description": "Update an existing invoice and its line items",
      "file": "app/routes/invoice_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/invoices/{id}",
      "description": "Delete an invoice and its associated line items",
      "file": "app/routes/invoice_routes.py"
    },
    {
      "method": "GET",
      "path": "/invoices/{id}/pdf",
      "description": "Generate and download a PDF version of the invoice",
      "file": "app/routes/invoice_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return an access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/line-items/{id}",
      "description": "Retrieve a specific line item",
      "file": "app/routes/line_item_routes.py"
    },
    {
      "method": "PUT",
      "path": "/line-items/{id}",
      "description": "Update a specific line item",
      "file": "app/routes/line_item_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/line-items/{id}",
      "description": "Delete a specific line item",
      "file": "app/routes/line_item_routes.py"
    }
  ],
