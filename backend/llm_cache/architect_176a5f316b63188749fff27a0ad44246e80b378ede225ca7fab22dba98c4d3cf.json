{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Request password reset email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Get profile of the authenticated user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all categories (default and user\u2011created)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a custom category for the authenticated user",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/expenses",
      "description": "Create a new expense record",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "GET",
      "path": "/expenses",
      "description": "Get paginated list of expenses with optional month, category_id, and full\u2011text search (q) filters",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "GET",
      "path": "/expenses/{id}",
      "description": "Retrieve a single expense by its ID",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "PUT",
      "path": "/expenses/{id}",
      "description": "Update an existing expense record",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/expenses/{id}",
      "description": "Delete an expense record",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "GET",
      "path": "/expenses/export",
      "description": "Export expenses for a date range to CSV",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "POST",
      "path": "/budgets",
      "description": "Create or update a monthly budget limit for a category",
      "file": "app/routes/budget_routes.py"
    },
    {
      "method": "GET",
      "path": "/budgets",
      "description": "List all budgets for the authenticated user",
      "file": "app/routes/budget_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/trends",
      "description": "Return aggregated monthly totals per category for a date range",
      "file": "app/routes/report_routes.py"
    }
  ],
