{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve public profile of a user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "List all recipes with pagination",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a specific recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{id}/rating",
      "description": "Submit a rating for a recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/search",
      "description": "Search recipes by title, ingredients, or cuisine",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/mealplans",
      "description": "Retrieve list of meal plans for the authenticated user",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/mealplans",
      "description": "Create a new meal plan",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "GET",
      "path": "/mealplans/{id}",
      "description": "Get details of a specific meal plan",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/mealplans/{id}/add_recipe",
      "description": "Add a recipe to the specified meal plan",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/mealplans/{id}/remove_recipe",
      "description": "Remove a recipe from the specified meal plan",
      "file": "app/routes/mealplan_routes.py"
    }
  ],
