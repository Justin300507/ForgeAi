{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/tickets",
      "description": "Retrieve a list of all tickets with optional filters",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/{id}",
      "description": "Retrieve detailed information for a specific ticket",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "POST",
      "path": "/tickets",
      "description": "Create a new support ticket",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tickets/{id}",
      "description": "Update ticket fields (status, priority, assignment, SLA, etc.)",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tickets/{id}",
      "description": "Delete a ticket (soft\u2011delete for audit)",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/agents",
      "description": "List all support agents and their workload status",
      "file": "app/routes/agent_routes.py"
    },
    {
      "method": "GET",
      "path": "/agents/{id}",
      "description": "Get detailed information for a specific agent",
      "file": "app/routes/agent_routes.py"
    },
    {
      "method": "PUT",
      "path": "/agents/{id}",
      "description": "Update agent details (e.g., activation status, role)",
      "file": "app/routes/agent_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "Retrieve all ticket categories",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories/{id}",
      "description": "Retrieve details of a specific category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new ticket category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/login",
      "description": "Authenticate user and issue JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/logout",
      "description": "Invalidate user session / token",
      "file": "app/routes/auth_routes.py"
    }
  ],
