{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users/register",
      "description": "Register a new user and store hashed password",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve list of all users (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve profile and quiz history for a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/questions",
      "description": "Get all questions with optional filters",
      "file": "app/routes/question_routes.py"
    },
    {
      "method": "GET",
      "path": "/questions/{id}",
      "description": "Get details of a single question",
      "file": "app/routes/question_routes.py"
    },
    {
      "method": "POST",
      "path": "/questions",
      "description": "Create a new question within a question bank",
      "file": "app/routes/question_routes.py"
    },
    {
      "method": "PUT",
      "path": "/questions/{id}",
      "description": "Update an existing question",
      "file": "app/routes/question_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/questions/{id}",
      "description": "Delete a question",
      "file": "app/routes/question_routes.py"
    },
    {
      "method": "GET",
      "path": "/questions/bank/{bank_name}",
      "description": "List all questions belonging to a specific bank",
      "file": "app/routes/question_routes.py"
    },
    {
      "method": "POST",
      "path": "/attempts/start",
      "description": "Initialize a quiz attempt and return selected question IDs",
      "file": "app/routes/quizattempt_routes.py"
    },
    {
      "method": "POST",
      "path": "/attempts/submit",
      "description": "Submit answers, calculate score, and store attempt",
      "file": "app/routes/quizattempt_routes.py"
    },
    {
      "method": "GET",
      "path": "/attempts",
      "description": "Retrieve list of quiz attempts for the authenticated user",
      "file": "app/routes/quizattempt_routes.py"
    },
    {
      "method": "GET",
      "path": "/attempts/{id}",
      "description": "Retrieve detailed results of a specific quiz attempt",
      "file": "app/routes/quizattempt_routes.py"
    }
  ],
  "database_schema": [
