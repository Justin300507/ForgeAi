{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Create a new user account (candidate, employer, or admin) and issue JWT tokens.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Request a password reset; sends email with reset link.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's basic info (email, role, active status).",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update the authenticated user's email, password, or activation status.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidate_profiles",
      "description": "Create a candidate profile for the authenticated candidate user.",
      "file": "app/routes/candidate_profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidate_profiles/me",
      "description": "Get the authenticated candidate's profile details.",
      "file": "app/routes/candidate_profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidate_profiles/me",
      "description": "Update the authenticated candidate's profile fields (name, headline, location, bio).",
      "file": "app/routes/candidate_profile_routes.py"
    },
    {
      "method": "POST",
      "path": "/resumes",
      "description": "Upload a resume file (PDF/Docx \u22645\u202fMB) and link it to the candidate profile.",
      "file": "app/routes/resume_routes.py"
    },
    {
      "method": "GET",
      "path": "/resumes/{id}",
      "description": "Download a previously uploaded resume file.",
      "file": "app/routes/resume_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (title, description, location, salary range, tags) for the authenticated employer.",
      "file": "app/routes/job_listing_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List job listings with pagination, keyword search, location filter, and tag filter.",
      "file": "app/routes/job_listing_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Retrieve detailed information for a specific job listing.",
      "file": "app/routes/job_listing_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job listing with optional cover letter and selected resume.",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}",
      "description": "Update the status of an application (e.g., Reviewed, Interview, Rejected, Hired).",
      "file": "app/routes/application_routes.py"
    }
  ],
