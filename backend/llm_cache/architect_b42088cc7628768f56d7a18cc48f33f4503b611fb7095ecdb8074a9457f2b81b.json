{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, username, and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Paginated list of recipes with optional filters (ingredient, cuisine, rating) and full\u2011text search via query parameters",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a single recipe, including ingredients, tags, average rating and photo URL",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe (author must be authenticated); supports photo upload, ingredient list, steps, tags, and cuisine",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe owned by the authenticated user; allows editing of all mutable fields",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/ingredients",
      "description": "List all available ingredients for filter dropdowns and ingredient selection components",
      "file": "app/routes/ingredient_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{id}/ratings",
      "description": "Create a rating (1\u20115 stars) with optional comment for a specific recipe by the authenticated user",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "PUT",
      "path": "/ratings/{id}",
      "description": "Edit a rating owned by the authenticated user",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/ratings/{id}",
      "description": "Delete a rating owned by the authenticated user",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "GET",
      "path": "/collections",
      "description": "Retrieve paginated list of the authenticated user's collections",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections",
      "description": "Create a new named collection for the authenticated user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/collections/{id}",
      "description": "Add or remove recipes from a collection (request body contains arrays of recipe IDs to add or remove)",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/recipes/{id}/moderate",
      "description": "Admin action to change recipe status (e.g., approved, removed) and optionally add a moderation comment",
      "file": "app/routes/admin_routes.py"
    }
  ],
