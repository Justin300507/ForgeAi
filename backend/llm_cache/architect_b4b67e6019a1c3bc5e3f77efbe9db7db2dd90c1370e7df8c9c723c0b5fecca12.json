{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (candidate or employer) and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the authenticated candidate's profile",
      "file": "app/routes/candidate_profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Create or update the authenticated candidate's profile",
      "file": "app/routes/candidate_profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employers/me",
      "description": "Create or update the authenticated employer's company profile",
      "file": "app/routes/employer_profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Public job listings with pagination and filter support",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Employer creates a new job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Retrieve detailed information for a specific job",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Employer updates a job listing (including status changes)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs/{id}/apply",
      "description": "Candidate applies to a job with resume upload and optional cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me/applications",
      "description": "List all applications submitted by the authenticated candidate",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/employers/me/jobs/{job_id}/applications",
      "description": "Employer views applications for one of their job postings",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Employer updates the status of a specific application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "Retrieve notifications for the authenticated user",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/notifications/{id}/read",
      "description": "Mark a specific notification as read",
      "file": "app/routes/notification_routes.py"
    }
  ],
