{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and issue JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get current authenticated user profile",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/profile",
      "description": "Retrieve candidate's profile",
      "file": "app/routes/candidateprofile_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidates/profile",
      "description": "Create candidate profile with resume upload",
      "file": "app/routes/candidateprofile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/profile",
      "description": "Update candidate profile fields",
      "file": "app/routes/candidateprofile_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Search and paginate public job listings with facet filters",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Employer creates a new job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Employer edits an existing job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Employer deactivates a job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Candidate applies to a job with cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "Employer lists applications with filtering options",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Employer updates application status and triggers notification",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "Retrieve paginated list of user notifications",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/users",
      "description": "Admin views paginated list of all users and their roles",
      "file": "app/routes/admin_routes.py"
    }
  ],
