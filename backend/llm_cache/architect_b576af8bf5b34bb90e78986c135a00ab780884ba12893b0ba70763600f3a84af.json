{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/locations",
      "description": "Retrieve list of all warehouse locations",
      "file": "app/routes/location_routes.py"
    },
    {
      "method": "POST",
      "path": "/locations",
      "description": "Create a new warehouse location",
      "file": "app/routes/location_routes.py"
    },
    {
      "method": "GET",
      "path": "/locations/{id}",
      "description": "Get details of a specific location",
      "file": "app/routes/location_routes.py"
    },
    {
      "method": "PUT",
      "path": "/locations/{id}",
      "description": "Update an existing location",
      "file": "app/routes/location_routes.py"
    },
    {
      "method": "GET",
      "path": "/bins",
      "description": "Retrieve list of all bins across locations",
      "file": "app/routes/bin_routes.py"
    },
    {
      "method": "POST",
      "path": "/bins",
      "description": "Create a new bin within a location",
      "file": "app/routes/bin_routes.py"
    },
    {
      "method": "GET",
      "path": "/bins/{id}",
      "description": "Get details of a specific bin",
      "file": "app/routes/bin_routes.py"
    },
    {
      "method": "PUT",
      "path": "/bins/{id}",
      "description": "Update bin information or inventory quantity",
      "file": "app/routes/bin_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders",
      "description": "Retrieve list of pick\u2011and\u2011pack orders",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "POST",
      "path": "/orders",
      "description": "Create a new order with items",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders/{id}",
      "description": "Get details and status of a specific order",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "PUT",
      "path": "/orders/{id}",
      "description": "Update order status or items",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders/{id}/picklist",
      "description": "Generate pick list for the order",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/inventory",
      "description": "Provide inventory summary per bin",
      "file": "app/routes/report_routes.py"
    }
  ],
