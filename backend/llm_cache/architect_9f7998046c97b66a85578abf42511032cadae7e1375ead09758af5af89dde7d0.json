{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user (candidate or employer) and create associated profile placeholder",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access and refresh tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset-request",
      "description": "Send password\u2011reset email with one\u2011time token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Reset password using token supplied in request body",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Return authenticated user details including role",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the candidate profile of the logged\u2011in user",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Create or update candidate profile; supports PDF resume upload (max 5\u202fMB)",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/employers/me",
      "description": "Retrieve the employer profile of the logged\u2011in user",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employers/me",
      "description": "Create or update employer profile",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List job listings with pagination, keyword search, location and salary filters",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update job details or archive the listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job; includes cover letter and optional resume upload",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "Employer view of applications for their jobs; supports status filter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{id}",
      "description": "Retrieve details of a specific application (candidate or employer authorized)",
      "file": "app/routes/application_routes.py"
    }
  ],
