{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access and refresh tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/refresh",
      "description": "Refresh access token using a valid refresh token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/health",
      "description": "Health check endpoint returning service status",
      "file": "app/routes/health_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all expense categories available to the user",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new expense category",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/expenses",
      "description": "Create a new expense record linked to the authenticated user",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "GET",
      "path": "/expenses",
      "description": "Get a paginated list of expenses with optional filters (month, year, category_id) and search by note via 'q' query parameter",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "GET",
      "path": "/expenses/{id}",
      "description": "Retrieve details of a specific expense belonging to the authenticated user",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "PUT",
      "path": "/expenses/{id}",
      "description": "Update an existing expense record owned by the authenticated user",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/expenses/{id}",
      "description": "Delete an expense record owned by the authenticated user",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "GET",
      "path": "/expenses/export",
      "description": "Export expenses for a given month and year as a CSV file",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "PUT",
      "path": "/budgets/{category_id}",
      "description": "Set or update the monthly budget limit for a specific category for the authenticated user",
      "file": "app/routes/budget_routes.py"
    },
    {
      "method": "GET",
      "path": "/budgets",
      "description": "List all budget limits for the authenticated user",
      "file": "app/routes/budget_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/trends",
      "description": "Return spending totals per category for the last six months for the authenticated user",
      "file": "app/routes/report_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "user",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "hashed_password",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "category",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "name",
          "type": "VARCHAR(100)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "icon",
          "type": "VARCHAR(100)",
          "is_primary_key": false,
          "is_nullable": true
        }
      ]
    },
    {
      "table_name": "expense",
