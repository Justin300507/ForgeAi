{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies",
      "description": "List companies with pagination and optional search",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies",
      "description": "Create a new company record",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies/{id}",
      "description": "Retrieve details of a specific company",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "PUT",
      "path": "/companies/{id}",
      "description": "Update an existing company",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications with pagination and filters",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Create a new job application linked to a company",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{id}",
      "description": "Get detailed information for a specific application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PUT",
      "path": "/applications/{id}",
      "description": "Update application fields (e.g., position title, notes)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/applications/{id}",
      "description": "Delete an application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{app_id}/interviews",
      "description": "List interviews scheduled for an application",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications/{app_id}/interviews",
      "description": "Schedule a new interview for an application",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications/{app_id}/documents",
      "description": "Upload a document (resume, cover letter, etc.) for an application",
      "file": "app/routes/document_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Change application status and add an optional comment",
      "file": "app/routes/status_update_routes.py"
    }
  ],
