{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve a list of all users (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve profile details for a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/movies",
      "description": "Get a paginated list of movies in the catalog",
      "file": "app/routes/movie_routes.py"
    },
    {
      "method": "GET",
      "path": "/movies/{id}",
      "description": "Get detailed information for a specific movie",
      "file": "app/routes/movie_routes.py"
    },
    {
      "method": "GET",
      "path": "/movies/search",
      "description": "Search movies by title, genre, director, or year (query param: q)",
      "file": "app/routes/movie_routes.py"
    },
    {
      "method": "POST",
      "path": "/reviews",
      "description": "Create a new review and rating for a watched movie",
      "file": "app/routes/review_routes.py"
    },
    {
      "method": "GET",
      "path": "/reviews/{id}",
      "description": "Retrieve a specific review by its ID",
      "file": "app/routes/review_routes.py"
    },
    {
      "method": "GET",
      "path": "/movies/{id}/reviews",
      "description": "List all reviews for a given movie",
      "file": "app/routes/review_routes.py"
    },
    {
      "method": "GET",
      "path": "/watchlist",
      "description": "Get the authenticated user's current watchlist",
      "file": "app/routes/watchlist_routes.py"
    },
    {
      "method": "POST",
      "path": "/watchlist",
      "description": "Add a movie to the authenticated user's watchlist",
      "file": "app/routes/watchlist_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/watchlist/{movie_id}",
      "description": "Remove a movie from the authenticated user's watchlist",
      "file": "app/routes/watchlist_routes.py"
    }
  ],
  "database_schema": [
