{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new member (creates User and Member records).",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "Get a paginated list of authors.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/authors/{id}",
      "description": "Update author details.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/authors/{id}",
      "description": "Delete an author (only if no books are linked).",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination, optional search (title or author).",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book with ISBN, title, authors and optional cover image upload.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve detailed information for a single book.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/books/{id}",
      "description": "Update book fields, including replacing the cover image.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book if it has no active borrowings or reservations.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Borrow an available book; returns due date (14 days).",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "GET",
      "path": "/borrowings",
      "description": "List borrowings; supports ?overdue=true and pagination. Export CSV with ?export=csv.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/borrowings/{id}",
      "description": "Mark a borrowing as returned; records return date.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for an unavailable book; returns queue position.",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations",
      "description": "List reservations for the authenticated member with pagination.",
      "file": "app/routes/reservation_routes.py"
    }
  ],
