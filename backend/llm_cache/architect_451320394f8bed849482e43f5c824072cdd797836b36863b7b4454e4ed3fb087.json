{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the logged\u2011in user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update profile information of the logged\u2011in user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "List recipes with optional filters (cuisine, difficulty, diet) and pagination",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a specific recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe with ingredients, steps, and optional image",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/ingredients",
      "description": "Searchable list of ingredients for autocomplete and selection",
      "file": "app/routes/ingredient_routes.py"
    },
    {
      "method": "GET",
      "path": "/collections",
      "description": "List collections owned by the logged\u2011in user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections",
      "description": "Create a new collection for the logged\u2011in user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections/{id}/recipes",
      "description": "Add a recipe to a collection (recipe_id in request body)",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/collections/{id}/recipes/{recipe_id}",
      "description": "Remove a recipe from a collection",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{id}/ratings",
      "description": "Submit a star rating (1\u20115) and optional comment for a recipe",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "GET",
      "path": "/search",
      "description": "Full\u2011text search across recipes, ingredients, and collections (query param q)",
      "file": "app/routes/search_routes.py"
    },
    {
      "method": "POST",
      "path": "/moderation/flags",
      "description": "Create a moderation flag for a recipe, ingredient, or comment",
      "file": "app/routes/moderation_routes.py"
    }
  ],
