{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}/subscriptions",
      "description": "List all shows the user is subscribed to",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/{id}/subscriptions",
      "description": "Subscribe the user to a show",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/users/{id}/subscriptions/{show_id}",
      "description": "Unsubscribe the user from a show",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}/play-history",
      "description": "Get the user's episode play history",
      "file": "app/routes/playhistory_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/{id}/play-history",
      "description": "Add or update a play history entry for an episode",
      "file": "app/routes/playhistory_routes.py"
    },
    {
      "method": "GET",
      "path": "/shows",
      "description": "Discover and search podcast shows",
      "file": "app/routes/show_routes.py"
    },
    {
      "method": "GET",
      "path": "/shows/{id}",
      "description": "Get detailed information for a specific show",
      "file": "app/routes/show_routes.py"
    },
    {
      "method": "GET",
      "path": "/shows/{id}/episodes",
      "description": "List episodes belonging to a specific show",
      "file": "app/routes/episode_routes.py"
    },
    {
      "method": "GET",
      "path": "/episodes/{id}",
      "description": "Retrieve metadata for a single episode",
      "file": "app/routes/episode_routes.py"
    },
    {
      "method": "POST",
      "path": "/episodes",
      "description": "Create a new episode (admin operation)",
      "file": "app/routes/episode_routes.py"
    },
    {
      "method": "GET",
      "path": "/search/shows",
      "description": "Search shows by title or description",
      "file": "app/routes/search_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/{user_id}",
      "description": "Get personalized dashboard data with latest episodes from subscriptions",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
