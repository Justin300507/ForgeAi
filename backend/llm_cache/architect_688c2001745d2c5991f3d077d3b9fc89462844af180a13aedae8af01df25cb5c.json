{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/products",
      "description": "Retrieve list of all products with current stock levels",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/products",
      "description": "Create a new product record",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Get detailed information for a specific product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "PUT",
      "path": "/products/{id}",
      "description": "Update product details such as quantity or reorder point",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/products/{id}",
      "description": "Remove a product from the catalog",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/suppliers",
      "description": "Retrieve list of all suppliers",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "POST",
      "path": "/suppliers",
      "description": "Create a new supplier entry",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "GET",
      "path": "/suppliers/{id}",
      "description": "Get details of a specific supplier",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "PUT",
      "path": "/suppliers/{id}",
      "description": "Update supplier contact information",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "GET",
      "path": "/purchase_orders",
      "description": "List all purchase orders with status",
      "file": "app/routes/purchase_order_routes.py"
    },
    {
      "method": "POST",
      "path": "/purchase_orders",
      "description": "Create a new purchase order",
      "file": "app/routes/purchase_order_routes.py"
    },
    {
      "method": "GET",
      "path": "/purchase_orders/{id}",
      "description": "Retrieve details of a specific purchase order",
      "file": "app/routes/purchase_order_routes.py"
    },
    {
      "method": "PUT",
      "path": "/purchase_orders/{id}",
      "description": "Update status or details of a purchase order",
      "file": "app/routes/purchase_order_routes.py"
    },
    {
      "method": "POST",
      "path": "/login",
      "description": "Authenticate user and issue JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard",
      "description": "Provide aggregated inventory metrics and low\u2011stock alerts",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "product",
