{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{user_id}/albums",
      "description": "List all albums belonging to a specific user",
      "file": "app/routes/album_routes.py"
    },
    {
      "method": "POST",
      "path": "/albums",
      "description": "Create a new album",
      "file": "app/routes/album_routes.py"
    },
    {
      "method": "GET",
      "path": "/albums/{id}",
      "description": "Get detailed information of an album",
      "file": "app/routes/album_routes.py"
    },
    {
      "method": "PUT",
      "path": "/albums/{id}",
      "description": "Update album details",
      "file": "app/routes/album_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/albums/{id}",
      "description": "Delete an album",
      "file": "app/routes/album_routes.py"
    },
    {
      "method": "POST",
      "path": "/photos",
      "description": "Upload a new photo to an album",
      "file": "app/routes/photo_routes.py"
    },
    {
      "method": "GET",
      "path": "/photos/{id}",
      "description": "Retrieve photo details by ID",
      "file": "app/routes/photo_routes.py"
    },
    {
      "method": "GET",
      "path": "/albums/{album_id}/photos",
      "description": "List all photos within a specific album",
      "file": "app/routes/photo_routes.py"
    },
    {
      "method": "POST",
      "path": "/photos/{id}/like",
      "description": "Add a like to a photo",
      "file": "app/routes/photo_routes.py"
    },
    {
      "method": "POST",
      "path": "/photos/{id}/comment",
      "description": "Add a comment to a photo",
      "file": "app/routes/photo_routes.py"
    }
  ],
