{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (candidate or employer) and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/verify-email",
      "description": "Verify email using token query parameter and activate account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the authenticated candidate's profile",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update candidate profile fields and upload resume PDF",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/employers/me",
      "description": "Retrieve the authenticated employer's company profile",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employers/me",
      "description": "Update employer profile fields and upload company logo",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job posting (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List jobs with pagination, search by keyword, and filter by location, type, salary",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update or deactivate a job posting (owner employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job with optional cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/me",
      "description": "List applications submitted by the authenticated candidate",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Employer updates the status of a candidate's application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications/me",
      "description": "Retrieve unread notifications for the authenticated user",
      "file": "app/routes/notification_routes.py"
    }
  ],
