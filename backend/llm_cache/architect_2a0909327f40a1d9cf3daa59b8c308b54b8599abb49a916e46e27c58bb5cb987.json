{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/books",
      "description": "Retrieve a list of books with optional search filters",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Get details of a specific book by ID",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update book information",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/members",
      "description": "Retrieve a list of library members",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Create a new member record",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/members/{id}",
      "description": "Get details of a specific member by ID",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/{id}",
      "description": "Update member information or deactivate the account",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "GET",
      "path": "/loans",
      "description": "Retrieve all loan records",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "POST",
      "path": "/loans",
      "description": "Create a new loan (process book checkout)",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "GET",
      "path": "/loans/{id}",
      "description": "Get details of a specific loan by ID",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "PUT",
      "path": "/loans/{id}",
      "description": "Update loan status (e.g., record return)",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "GET",
      "path": "/loans/overdue",
      "description": "List all overdue loans",
      "file": "app/routes/loan_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/overdue",
      "description": "Generate a report of overdue books and associated members",
      "file": "app/routes/report_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and issue access token",
      "file": "app/routes/auth_routes.py"
    }
  ],
  "database_schema": [
