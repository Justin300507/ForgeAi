{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/auth/register",
      "description": "Create a new user (manager role required)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/users",
      "description": "List users with pagination (manager only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/users/{id}",
      "description": "Get user details by ID (manager only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/api/users/{id}",
      "description": "Update user role or status (manager only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/products",
      "description": "Retrieve paginated list of products with optional search by name or SKU",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/products/{id}",
      "description": "Get detailed information for a single product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/products",
      "description": "Create a new product with initial inventory quantity",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "PUT",
      "path": "/api/products/{id}",
      "description": "Update product fields including low\u2011stock threshold",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/api/products/{id}",
      "description": "Delete a product if no pending orders exist",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/products/{id}/quantity",
      "description": "Adjust the inventory quantity for a product and create an audit log entry",
      "file": "app/routes/inventory_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/alerts",
      "description": "List low\u2011stock alerts for the authenticated user",
      "file": "app/routes/alert_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/products/import",
      "description": "Bulk import products and initial inventory from a CSV file",
      "file": "app/routes/import_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/audit-logs",
      "description": "Retrieve audit log entries with pagination and optional filtering by user or entity",
      "file": "app/routes/auditlog_routes.py"
    }
  ],
