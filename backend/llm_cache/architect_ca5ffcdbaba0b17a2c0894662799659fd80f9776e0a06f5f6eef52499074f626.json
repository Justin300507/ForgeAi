{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/users/{id}/status",
      "description": "Update user's presence status (online, offline, typing)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and create session",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "description": "Terminate user session",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/rooms",
      "description": "List all chat rooms",
      "file": "app/routes/room_routes.py"
    },
    {
      "method": "POST",
      "path": "/rooms",
      "description": "Create a new chat room",
      "file": "app/routes/room_routes.py"
    },
    {
      "method": "GET",
      "path": "/rooms/{id}",
      "description": "Get details of a specific chat room",
      "file": "app/routes/room_routes.py"
    },
    {
      "method": "POST",
      "path": "/rooms/{id}/join",
      "description": "Join a chat room",
      "file": "app/routes/room_routes.py"
    },
    {
      "method": "POST",
      "path": "/rooms/{id}/leave",
      "description": "Leave a chat room",
      "file": "app/routes/room_routes.py"
    },
    {
      "method": "GET",
      "path": "/rooms/{room_id}/messages",
      "description": "Retrieve paginated messages for a room",
      "file": "app/routes/message_routes.py"
    },
    {
      "method": "POST",
      "path": "/rooms/{room_id}/messages",
      "description": "Send a new message to a room",
      "file": "app/routes/message_routes.py"
    },
    {
      "method": "GET",
      "path": "/direct/{user_id}/messages",
      "description": "Retrieve paginated direct messages with a user",
      "file": "app/routes/message_routes.py"
    },
    {
      "method": "POST",
      "path": "/direct/{user_id}/messages",
      "description": "Send a direct message to a user",
      "file": "app/routes/message_routes.py"
    }
  ],
