{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account with email and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/portfolios",
      "description": "List portfolios belonging to the authenticated user (supports pagination)",
      "file": "app/routes/portfolio_routes.py"
    },
    {
      "method": "POST",
      "path": "/portfolios",
      "description": "Create a new portfolio for the authenticated user",
      "file": "app/routes/portfolio_routes.py"
    },
    {
      "method": "GET",
      "path": "/holdings",
      "description": "Get paginated list of holdings with optional ticker search",
      "file": "app/routes/holding_routes.py"
    },
    {
      "method": "POST",
      "path": "/holdings",
      "description": "Add a new holding (stock, quantity, purchase price) to a portfolio",
      "file": "app/routes/holding_routes.py"
    },
    {
      "method": "PUT",
      "path": "/holdings/{id}",
      "description": "Update quantity or average cost of an existing holding",
      "file": "app/routes/holding_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/holdings/{id}",
      "description": "Remove a holding from a portfolio",
      "file": "app/routes/holding_routes.py"
    },
    {
      "method": "POST",
      "path": "/transactions",
      "description": "Record a buy or sell transaction; adjusts related holding automatically",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "GET",
      "path": "/transactions",
      "description": "Retrieve paginated transaction history with optional ticker filter",
      "file": "app/routes/transaction_routes.py"
    },
    {
      "method": "POST",
      "path": "/dividends",
      "description": "Log a dividend payout for a stock in a portfolio",
      "file": "app/routes/dividend_routes.py"
    },
    {
      "method": "GET",
      "path": "/dividends",
      "description": "List dividends with optional ticker search and pagination",
      "file": "app/routes/dividend_routes.py"
    },
    {
      "method": "POST",
      "path": "/shares",
      "description": "Generate a read\u2011only share token for a portfolio with expiration",
      "file": "app/routes/share_routes.py"
    },
    {
      "method": "POST",
      "path": "/import/transactions",
      "description": "Upload CSV file to bulk import past transactions; returns validation errors per line",
      "file": "app/routes/import_routes.py"
    }
  ],
