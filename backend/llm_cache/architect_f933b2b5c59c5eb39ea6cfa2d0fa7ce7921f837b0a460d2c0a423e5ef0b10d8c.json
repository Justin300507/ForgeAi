{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/products",
      "description": "Retrieve list of products with optional search and category filter",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Retrieve detailed information for a specific product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/customers/register",
      "description": "Create a new customer account",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "POST",
      "path": "/customers/login",
      "description": "Authenticate customer and return access token",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "GET",
      "path": "/customers/me",
      "description": "Get authenticated customer's profile",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "PUT",
      "path": "/customers/me",
      "description": "Update authenticated customer's profile",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "POST",
      "path": "/orders",
      "description": "Create a new order from the current cart (checkout)",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders",
      "description": "List orders of the authenticated customer",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders/{id}",
      "description": "Get details of a specific order",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/cart/items",
      "description": "Retrieve items in the authenticated customer's cart",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "POST",
      "path": "/cart/items",
      "description": "Add a product to the cart or increase quantity",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "PUT",
      "path": "/cart/items/{product_id}",
      "description": "Update quantity of a product in the cart",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/cart/items/{product_id}",
      "description": "Remove a product from the cart",
      "file": "app/routes/cart_routes.py"
    }
  ],
