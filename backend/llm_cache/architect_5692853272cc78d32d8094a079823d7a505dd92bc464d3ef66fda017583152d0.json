{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/users/{id}",
      "description": "Delete a user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and issue JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "description": "Invalidate user session / token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "List all tasks for the authenticated user",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Retrieve a specific task by ID",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tasks/{id}",
      "description": "Update task details",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tasks/{id}",
      "description": "Delete a task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions",
      "description": "List all Pomodoro sessions for the authenticated user",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Create a new Pomodoro session record",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions/{id}",
      "description": "Retrieve a specific session by ID",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "PUT",
      "path": "/sessions/{id}",
      "description": "Update session details (e.g., mark as break, adjust duration)",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/sessions/{id}",
      "description": "Delete a session record",
      "file": "app/routes/session_routes.py"
    }
  ],
