{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve list of all users",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve public profile of a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}/posts",
      "description": "Retrieve posts authored by the specified user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts",
      "description": "Retrieve paginated list of recent posts for home feed",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}",
      "description": "Retrieve details of a single post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts",
      "description": "Create a new post (authenticated users)",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "PUT",
      "path": "/posts/{id}",
      "description": "Update an existing post owned by the requester",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/posts/{id}",
      "description": "Delete a post owned by the requester",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{post_id}/comments",
      "description": "List comments for a specific post",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{post_id}/comments",
      "description": "Add a comment to a specific post (authenticated users)",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "PUT",
      "path": "/comments/{id}",
      "description": "Update a comment owned by the requester",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/comments/{id}",
      "description": "Delete a comment owned by the requester",
      "file": "app/routes/comment_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
