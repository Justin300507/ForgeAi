{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Employer creates a new job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Retrieve paginated list of active job listings with optional filters",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Employer updates an existing job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Employer deletes a job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/profiles",
      "description": "Candidate creates a new profile (draft)",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/profiles/me",
      "description": "Retrieve the authenticated candidate's own profile",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/profiles/me",
      "description": "Candidate updates their own profile and can publish it",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "POST",
      "path": "/uploads/resume",
      "description": "Upload a resume file (PDF/DOC/DOCX) for later use in applications",
      "file": "app/routes/upload_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Candidate submits an application for a job listing",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Employer updates the status of a candidate's application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/search/jobs",
      "description": "Full\u2011text search for job listings with filters (keyword, location, type, experience)",
      "file": "app/routes/search_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/users/{id}/deactivate",
      "description": "Admin deactivates a user account and revokes access",
      "file": "app/routes/admin_routes.py"
    }
  ],
