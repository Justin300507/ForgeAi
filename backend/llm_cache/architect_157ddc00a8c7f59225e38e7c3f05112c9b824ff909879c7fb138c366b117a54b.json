{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/events",
      "description": "Retrieve a list of all events with basic details.",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event.",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{event_id}",
      "description": "Get detailed information for a specific event.",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "PUT",
      "path": "/events/{event_id}",
      "description": "Update an existing event.",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/events/{event_id}",
      "description": "Delete an event.",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{event_id}/tickets",
      "description": "List all ticket types for a specific event.",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "POST",
      "path": "/events/{event_id}/tickets",
      "description": "Create a new ticket type for an event.",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/{ticket_id}",
      "description": "Retrieve details of a specific ticket type.",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tickets/{ticket_id}",
      "description": "Update a ticket type (price, quantity, etc.).",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tickets/{ticket_id}",
      "description": "Delete a ticket type.",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "POST",
      "path": "/tickets/{ticket_id}/attendees",
      "description": "Register an attendee and purchase a ticket.",
      "file": "app/routes/attendee_routes.py"
    },
    {
      "method": "GET",
      "path": "/attendees/{attendee_id}",
      "description": "Get attendee registration and check\u2011in status.",
      "file": "app/routes/attendee_routes.py"
    },
    {
      "method": "PUT",
      "path": "/checkin/{attendee_id}",
      "description": "Mark an attendee as checked\u2011in using QR code data.",
      "file": "app/routes/attendee_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (organizer, attendee, or staff).",
      "file": "app/routes/auth_routes.py"
    }
  ],
