{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user (candidate, employer, or admin) and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Request a password\u2011reset email for the given user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/profiles/me",
      "description": "Retrieve the authenticated candidate's profile",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "POST",
      "path": "/profiles",
      "description": "Create a new profile for the authenticated candidate",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/profiles",
      "description": "Update the authenticated candidate's profile information",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies",
      "description": "Create a company record for the authenticated employer",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "PUT",
      "path": "/companies/me",
      "description": "Update the authenticated employer's company details and logo",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Search and filter job listings with pagination (keyword, location, job type, remote)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing for the authenticated employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update an existing job listing owned by the authenticated employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application (cover letter + resume) for a specific job",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/me",
      "description": "List all applications submitted by the authenticated candidate",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/admin/users/{id}",
      "description": "Admin deletes or deactivates a user account",
      "file": "app/routes/admin_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/admin/jobs/{id}",
      "description": "Admin removes a job listing that violates policies",
      "file": "app/routes/admin_routes.py"
    }
  ],
