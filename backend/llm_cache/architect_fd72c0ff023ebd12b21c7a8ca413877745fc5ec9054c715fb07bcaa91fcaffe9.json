{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and return confirmation",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/notebooks",
      "description": "Retrieve a paginated list of notebooks belonging to the authenticated user",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "POST",
      "path": "/notebooks",
      "description": "Create a new notebook for the authenticated user",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/notebooks/{id}",
      "description": "Rename an existing notebook owned by the user",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/notebooks/{id}",
      "description": "Delete a notebook and all its associated notes",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "GET",
      "path": "/notes",
      "description": "Retrieve a paginated list of notes with optional notebook_id and tag filters",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "POST",
      "path": "/notes",
      "description": "Create a new note inside a specified notebook",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "PUT",
      "path": "/notes/{id}",
      "description": "Update the title and content of an existing note",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/notes/{id}",
      "description": "Delete a note owned by the user",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "POST",
      "path": "/notes/{id}/tags",
      "description": "Associate an existing tag with the specified note",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "GET",
      "path": "/tags",
      "description": "List all tags created by the authenticated user",
      "file": "app/routes/tag_routes.py"
    },
    {
      "method": "POST",
      "path": "/tags",
      "description": "Create a new tag for the user",
      "file": "app/routes/tag_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tags/{id}",
      "description": "Delete a tag owned by the user",
      "file": "app/routes/tag_routes.py"
    },
    {
      "method": "GET",
      "path": "/search",
      "description": "Full\u2011text search across the user's notes by keyword",
      "file": "app/routes/search_routes.py"
    }
  ],
