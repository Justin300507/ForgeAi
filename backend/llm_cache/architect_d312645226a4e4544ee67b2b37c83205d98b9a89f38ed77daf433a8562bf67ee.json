{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/products",
      "description": "Retrieve a list of all products, optionally filtered by query parameters",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/products",
      "description": "Create a new product record",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Retrieve details of a specific product by its ID",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "PUT",
      "path": "/products/{id}",
      "description": "Update an existing product's information",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/products/{id}",
      "description": "Delete a product from the catalog",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/suppliers",
      "description": "Retrieve a list of all suppliers",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "POST",
      "path": "/suppliers",
      "description": "Create a new supplier record",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "GET",
      "path": "/suppliers/{id}",
      "description": "Retrieve details of a specific supplier by its ID",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "PUT",
      "path": "/suppliers/{id}",
      "description": "Update an existing supplier's information",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/suppliers/{id}",
      "description": "Delete a supplier from the system",
      "file": "app/routes/supplier_routes.py"
    },
    {
      "method": "GET",
      "path": "/stock_movements",
      "description": "Retrieve stock movement records, optionally filtered by date range or product",
      "file": "app/routes/stockmovement_routes.py"
    },
    {
      "method": "POST",
      "path": "/stock_movements",
      "description": "Record a new inbound or outbound stock movement",
      "file": "app/routes/stockmovement_routes.py"
    },
    {
      "method": "GET",
      "path": "/stock_movements/{id}",
      "description": "Retrieve details of a specific stock movement by its ID",
      "file": "app/routes/stockmovement_routes.py"
    },
    {
      "method": "PUT",
      "path": "/stock_movements/{id}",
      "description": "Update an existing stock movement record",
      "file": "app/routes/stockmovement_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/stock_movements/{id}",
      "description": "Delete a stock movement entry",
      "file": "app/routes/stockmovement_routes.py"
    }
  ],
