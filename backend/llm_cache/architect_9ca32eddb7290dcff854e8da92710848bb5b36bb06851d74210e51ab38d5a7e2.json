{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user with email and password.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update profile fields (e.g., email, password) of the authenticated user.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/habits",
      "description": "List habits of the authenticated user with pagination and optional search by name or tags.",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "POST",
      "path": "/habits",
      "description": "Create a new habit for the authenticated user.",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "GET",
      "path": "/habits/{id}",
      "description": "Retrieve details of a specific habit belonging to the authenticated user.",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "PUT",
      "path": "/habits/{id}",
      "description": "Update name, description, frequency, or tags of a habit owned by the authenticated user.",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/habits/{id}",
      "description": "Delete a habit owned by the authenticated user.",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "POST",
      "path": "/habit-logs",
      "description": "Record completion of a habit for the current day; prevents duplicate logs for the same habit/date.",
      "file": "app/routes/habit_log_routes.py"
    },
    {
      "method": "POST",
      "path": "/reminders",
      "description": "Create a reminder (push or email) for a habit at a specific time of day.",
      "file": "app/routes/reminder_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reminders/{id}",
      "description": "Delete an existing reminder.",
      "file": "app/routes/reminder_routes.py"
    },
    {
      "method": "POST",
      "path": "/coach-shares",
      "description": "Coach requests read\u2011only access to a client\u2019s habits (or client shares with a coach).",
      "file": "app/routes/coach_share_routes.py"
    },
    {
      "method": "GET",
      "path": "/coach-shares/client/{client_id}/habits",
      "description": "Coach retrieves read\u2011only list of habits and streaks for a specific client.",
      "file": "app/routes/coach_share_routes.py"
    }
  ],
  "database_schema": [
