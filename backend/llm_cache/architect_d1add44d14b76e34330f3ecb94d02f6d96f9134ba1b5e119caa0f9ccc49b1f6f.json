{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/register",
      "description": "Register a new user with email and password, returns JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Authenticate user credentials and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/auth/me",
      "description": "Get current authenticated user's profile",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/users/me",
      "description": "Retrieve profile of the logged\u2011in user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/tasks",
      "description": "List paginated tasks for the authenticated user, supports search, hide completed, ordered by priority then due date",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/tasks",
      "description": "Create a new task for the authenticated user",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/tasks/{id}",
      "description": "Retrieve a single task belonging to the authenticated user",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/api/tasks/{id}",
      "description": "Replace an existing task's details (title, description, priority, due date)",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/tasks/{id}/complete",
      "description": "Mark the specified task as completed or uncompleted",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/api/tasks/{id}",
      "description": "Delete a task owned by the authenticated user",
      "file": "app/routes/task_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "user",
      "columns": [
        {
          "name": "id",
          "type": "Integer",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "String",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "password_hash",
          "type": "String",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "task",
      "columns": [
        {
          "name": "id",
          "type": "Integer",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "Integer",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "title",
          "type": "String",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "description",
          "type": "Text",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "priority",
          "type": "Enum('Low','Medium','High')",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "completed",
          "type": "Boolean",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "due_date",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": true
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "app",
      "app/models",
      "app/schemas",
      "app/routes",
      "app/services",
      "app/utils",
      "app/dependencies",
      "app/config"
    ]
  },
  "frontend_structure": {
    "pages": [
      "LoginPage",
      "RegisterPage",
      "TaskListPage",
      "TaskCreatePage",
      "TaskEditPage",
      "ProfilePage"
    ],
    "components": [
      "Header",
      "Footer",
      "TaskItem",
      "TaskForm",
      "PaginationControls",
      "SearchBar",
      "PriorityFilter",
      "HideCompletedToggle",
      "ProtectedRoute",
      "NotificationToast"
    ]
  }
}