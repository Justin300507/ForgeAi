{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve profile information for a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update profile details of a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/products",
      "description": "List all available products",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Get detailed information for a single product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/products",
      "description": "Create a new product (admin operation)",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "PUT",
      "path": "/products/{id}",
      "description": "Update an existing product's information",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/orders",
      "description": "Create a new order from the current cart (checkout)",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders",
      "description": "List all orders belonging to the authenticated user",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/orders/{id}",
      "description": "Retrieve detailed information for a specific order",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "GET",
      "path": "/cart",
      "description": "Get the current user's cart contents",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "POST",
      "path": "/cart/items",
      "description": "Add a product to the cart or update its quantity",
      "file": "app/routes/cart_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/cart/items/{product_id}",
      "description": "Remove a product from the cart",
      "file": "app/routes/cart_routes.py"
    }
  ],
  "database_schema": [
