{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account (teacher or student)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/classes",
      "description": "List classes owned by the authenticated teacher",
      "file": "app/routes/class_routes.py"
    },
    {
      "method": "POST",
      "path": "/classes",
      "description": "Create a new class with a name, description and assign the teacher as owner",
      "file": "app/routes/class_routes.py"
    },
    {
      "method": "PUT",
      "path": "/classes/{id}",
      "description": "Update class details (name, description) for the teacher's own class",
      "file": "app/routes/class_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/classes/{id}",
      "description": "Delete a class owned by the teacher",
      "file": "app/routes/class_routes.py"
    },
    {
      "method": "POST",
      "path": "/classes/{id}/enrollments",
      "description": "Bulk add or manually add students to a class via CSV or JSON payload",
      "file": "app/routes/enrollment_routes.py"
    },
    {
      "method": "GET",
      "path": "/classes/{id}/students",
      "description": "Retrieve the roster of active students for a class",
      "file": "app/routes/enrollment_routes.py"
    },
    {
      "method": "GET",
      "path": "/classes/{id}/assignments",
      "description": "List assignments for a class ordered by due date",
      "file": "app/routes/assignment_routes.py"
    },
    {
      "method": "POST",
      "path": "/classes/{id}/assignments",
      "description": "Create a new assignment for a class with title, description and due date",
      "file": "app/routes/assignment_routes.py"
    },
    {
      "method": "POST",
      "path": "/assignments/{id}/submissions",
      "description": "Upload a file (PDF/DOCX/Image) as a submission for an assignment",
      "file": "app/routes/submission_routes.py"
    },
    {
      "method": "POST",
      "path": "/submissions/{id}/grade",
      "description": "Assign a numeric score and optional feedback to a student's submission",
      "file": "app/routes/grade_routes.py"
    },
    {
      "method": "POST",
      "path": "/classes/{id}/attendance",
      "description": "Record attendance for a class session on a specific date",
      "file": "app/routes/attendance_routes.py"
    },
    {
      "method": "GET",
      "path": "/classes/{id}/attendance",
      "description": "Retrieve attendance records for a class session",
      "file": "app/routes/attendance_routes.py"
    },
    {
      "method": "GET",
      "path": "/search/classes",
      "description": "Search classes by name with optional pagination",
      "file": "app/routes/search_routes.py"
    }
  ],
