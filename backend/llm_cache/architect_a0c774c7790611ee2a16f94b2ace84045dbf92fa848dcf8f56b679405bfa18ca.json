{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/events",
      "description": "Retrieve a list of all events",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{id}",
      "description": "Retrieve details of a specific event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "PUT",
      "path": "/events/{id}",
      "description": "Update an existing event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/events/{id}",
      "description": "Delete an event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/{id}",
      "description": "Retrieve details of a specific ticket type",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "POST",
      "path": "/tickets",
      "description": "Create a new ticket type for an event",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tickets/{id}",
      "description": "Update an existing ticket type",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tickets/{id}",
      "description": "Delete a ticket type",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/attendees",
      "description": "List attendees for a given event (query param event_id)",
      "file": "app/routes/attendee_routes.py"
    },
    {
      "method": "POST",
      "path": "/attendees",
      "description": "Register an attendee and purchase a ticket",
      "file": "app/routes/attendee_routes.py"
    },
    {
      "method": "PUT",
      "path": "/attendees/{id}/checkin",
      "description": "Mark an attendee as checked\u2011in",
      "file": "app/routes/attendee_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and issue a JWT",
      "file": "app/routes/auth_routes.py"
    }
  ],
