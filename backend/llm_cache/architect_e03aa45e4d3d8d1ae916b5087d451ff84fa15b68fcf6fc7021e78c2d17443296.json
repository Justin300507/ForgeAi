{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user with unique email and password; returns JWT token on success.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and issue a JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile information.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "Get a paginated list of the authenticated user's tasks, ordered by priority (High\u2192Medium\u2192Low) then creation date; supports optional search query `q`.",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{task_id}",
      "description": "Retrieve a single task belonging to the authenticated user.",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new task for the authenticated user; title required, description optional, priority defaults to Medium.",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tasks/{task_id}",
      "description": "Update title, description, or priority of an existing task owned by the authenticated user.",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tasks/{task_id}",
      "description": "Delete a task owned by the authenticated user.",
      "file": "app/routes/task_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "UUID",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "String(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "password_hash",
          "type": "String(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "tasks",
      "columns": [
        {
          "name": "id",
          "type": "UUID",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "UUID",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "title",
          "type": "String(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "description",
          "type": "Text",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "priority",
          "type": "Enum('Low','Medium','High')",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "updated_at",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "app",
      "app/models",
      "app/schemas",
      "app/routes",
      "app/services",
      "app/utils",
      "app/dependencies",
      "app/config"
    ]
  },
  "frontend_structure": {
    "pages": [
      "LoginPage",
      "SignupPage",
      "TaskDashboard",
      "TaskCreatePage",
      "TaskEditPage"
    ],
    "components": [
      "Header",
      "Footer",
      "TaskList",
      "TaskItem",
      "TaskForm",
      "SearchBar",
      "Pagination",
      "PriorityBadge",
      "ProtectedRoute",
      "LogoutButton"
    ]
  }
}