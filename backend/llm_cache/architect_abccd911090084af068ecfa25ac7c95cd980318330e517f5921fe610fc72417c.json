{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/notebooks",
      "description": "Retrieve list of notebooks belonging to the authenticated user",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "POST",
      "path": "/notebooks",
      "description": "Create a new notebook for the authenticated user",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "GET",
      "path": "/notebooks/{id}",
      "description": "Get details of a specific notebook",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "PUT",
      "path": "/notebooks/{id}",
      "description": "Update title of a notebook",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/notebooks/{id}",
      "description": "Delete a notebook and its associated notes",
      "file": "app/routes/notebook_routes.py"
    },
    {
      "method": "GET",
      "path": "/notes",
      "description": "Retrieve list of notes, optionally filtered by notebook or tags",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "POST",
      "path": "/notes",
      "description": "Create a new note within a notebook",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "GET",
      "path": "/notes/{id}",
      "description": "Get full details of a note, including its tags",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "PUT",
      "path": "/notes/{id}",
      "description": "Update note title, content, or tags",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/notes/{id}",
      "description": "Delete a note",
      "file": "app/routes/note_routes.py"
    },
    {
      "method": "GET",
      "path": "/tags",
      "description": "List all tags available to the user",
      "file": "app/routes/tag_routes.py"
    },
    {
      "method": "POST",
      "path": "/tags",
      "description": "Create a new tag",
      "file": "app/routes/tag_routes.py"
    },
    {
      "method": "GET",
      "path": "/search",
      "description": "Full\u2011text search across notes of the authenticated user",
      "file": "app/routes/search_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
