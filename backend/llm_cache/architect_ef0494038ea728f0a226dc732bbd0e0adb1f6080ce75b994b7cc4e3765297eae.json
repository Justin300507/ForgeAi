{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/decks",
      "description": "List all decks belonging to the authenticated user",
      "file": "app/routes/deck_routes.py"
    },
    {
      "method": "POST",
      "path": "/decks",
      "description": "Create a new deck for the authenticated user",
      "file": "app/routes/deck_routes.py"
    },
    {
      "method": "GET",
      "path": "/decks/{id}",
      "description": "Get details of a specific deck",
      "file": "app/routes/deck_routes.py"
    },
    {
      "method": "PUT",
      "path": "/decks/{id}",
      "description": "Update title or description of a deck",
      "file": "app/routes/deck_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/decks/{id}",
      "description": "Delete a deck and its associated cards",
      "file": "app/routes/deck_routes.py"
    },
    {
      "method": "GET",
      "path": "/decks/{id}/cards",
      "description": "List all cards within a specific deck",
      "file": "app/routes/deck_routes.py"
    },
    {
      "method": "POST",
      "path": "/decks/{deck_id}/cards",
      "description": "Create a new card inside a deck",
      "file": "app/routes/card_routes.py"
    },
    {
      "method": "GET",
      "path": "/cards/{id}",
      "description": "Retrieve a single card by its ID",
      "file": "app/routes/card_routes.py"
    },
    {
      "method": "PUT",
      "path": "/cards/{id}",
      "description": "Update front or back text of a card",
      "file": "app/routes/card_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/cards/{id}",
      "description": "Delete a card",
      "file": "app/routes/card_routes.py"
    },
    {
      "method": "POST",
      "path": "/cards/{id}/review",
      "description": "Submit a review rating for a card and update spaced\u2011repetition schedule",
      "file": "app/routes/card_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
