          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "hashed_password",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "full_name",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
