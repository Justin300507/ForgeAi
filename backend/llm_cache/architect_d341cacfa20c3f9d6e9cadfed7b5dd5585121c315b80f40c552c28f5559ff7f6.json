{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/equipment",
      "description": "Retrieve list of all equipment items with their current status",
      "file": "app/routes/equipment_routes.py"
    },
    {
      "method": "POST",
      "path": "/equipment",
      "description": "Create a new equipment record",
      "file": "app/routes/equipment_routes.py"
    },
    {
      "method": "GET",
      "path": "/equipment/{id}",
      "description": "Get details of a specific equipment item",
      "file": "app/routes/equipment_routes.py"
    },
    {
      "method": "PUT",
      "path": "/equipment/{id}",
      "description": "Update information of an existing equipment item",
      "file": "app/routes/equipment_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/equipment/{id}",
      "description": "Remove an equipment item from inventory",
      "file": "app/routes/equipment_routes.py"
    },
    {
      "method": "GET",
      "path": "/rentals",
      "description": "Retrieve list of all rental contracts",
      "file": "app/routes/rental_routes.py"
    },
    {
      "method": "POST",
      "path": "/rentals",
      "description": "Create a new rental contract",
      "file": "app/routes/rental_routes.py"
    },
    {
      "method": "GET",
      "path": "/rentals/{id}",
      "description": "Get details of a specific rental contract",
      "file": "app/routes/rental_routes.py"
    },
    {
      "method": "PUT",
      "path": "/rentals/{id}",
      "description": "Update an existing rental contract (e.g., extend due date)",
      "file": "app/routes/rental_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/rentals/{id}",
      "description": "Delete a rental contract",
      "file": "app/routes/rental_routes.py"
    },
    {
      "method": "POST",
      "path": "/customers",
      "description": "Create a new customer record",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "GET",
      "path": "/customers/{id}",
      "description": "Retrieve details of a specific customer",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "PUT",
      "path": "/customers/{id}",
      "description": "Update information of an existing customer",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "POST",
      "path": "/login",
      "description": "Authenticate user and issue JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/overdue",
      "description": "List rentals that are overdue and trigger reminder notifications",
      "file": "app/routes/report_routes.py"
    }
  ],
