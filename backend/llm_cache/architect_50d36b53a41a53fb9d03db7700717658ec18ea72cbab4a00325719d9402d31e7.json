{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Get a paginated list of recipes with optional search, cuisine and dietary filters",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a single recipe, including ingredients, steps, ratings and comments",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe (authenticated users only)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe owned by the authenticated user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe owned by the authenticated user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{id}/ratings",
      "description": "Add a rating (and optional comment) to a recipe",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "PUT",
      "path": "/ratings/{id}",
      "description": "Edit a rating within the allowed time window",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/ratings/{id}",
      "description": "Delete a rating within the allowed time window",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections",
      "description": "Create a new personal collection of recipes",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections/{id}/recipes/{recipe_id}",
      "description": "Add a recipe to a specific collection",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "GET",
      "path": "/collections",
      "description": "List all collections belonging to the authenticated user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/moderation",
      "description": "Admin dashboard endpoint to list flagged recipes, comments, and users with pagination",
      "file": "app/routes/admin_routes.py"
    }
  ],
