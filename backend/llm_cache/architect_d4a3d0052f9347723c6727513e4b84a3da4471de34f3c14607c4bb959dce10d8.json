{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and return confirmation",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and issue JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies",
      "description": "List companies owned by the user with pagination and optional search",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "POST",
      "path": "/companies",
      "description": "Create a new company record for the user",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies/{company_id}",
      "description": "Get detailed information of a specific company",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "PUT",
      "path": "/companies/{company_id}",
      "description": "Update fields of an existing company",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/companies/{company_id}",
      "description": "Delete a company owned by the user",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications with filters (company, status, search) and pagination",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Create a new application, linking to a company and uploading a resume file",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{application_id}",
      "description": "Retrieve details of a specific application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PUT",
      "path": "/applications/{application_id}",
      "description": "Update status or other mutable fields of an application",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/applications/{application_id}",
      "description": "Delete an application record",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{application_id}/interviews",
      "description": "List all interviews associated with a given application",
      "file": "app/routes/interview_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications/{application_id}/interviews",
      "description": "Add a new interview event to an application",
      "file": "app/routes/interview_routes.py"
    }
  ],
