{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips",
      "description": "Get paginated list of trips owned or collaborated on by the current user",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips",
      "description": "Create a new trip with name, date range, and primary destination",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{trip_id}",
      "description": "Retrieve details of a specific trip",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "PUT",
      "path": "/trips/{trip_id}",
      "description": "Update trip information (name, dates, primary destination)",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/trips/{trip_id}",
      "description": "Delete a trip owned by the current user",
      "file": "app/routes/trip_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{trip_id}/destinations",
      "description": "List destinations associated with a trip",
      "file": "app/routes/destination_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips/{trip_id}/destinations",
      "description": "Add a new destination (name, latitude, longitude) to a trip",
      "file": "app/routes/destination_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{trip_id}/itinerary",
      "description": "List itinerary items for a trip ordered chronologically",
      "file": "app/routes/itinerary_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips/{trip_id}/itinerary",
      "description": "Create a new itinerary item (date, start/end time, title, notes)",
      "file": "app/routes/itinerary_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/itinerary/{item_id}",
      "description": "Delete an itinerary item",
      "file": "app/routes/itinerary_routes.py"
    },
    {
      "method": "GET",
      "path": "/trips/{trip_id}/packing",
      "description": "List packing items for a trip",
      "file": "app/routes/packing_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips/{trip_id}/packing",
      "description": "Add a new packing item (name, quantity, checked flag) to a trip",
      "file": "app/routes/packing_routes.py"
    },
    {
      "method": "POST",
      "path": "/trips/{trip_id}/collaborators",
      "description": "Invite a user to collaborate on a trip (adds a TripCollaborator record)",
      "file": "app/routes/collaborator_routes.py"
    }
  ],
