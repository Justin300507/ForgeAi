{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, password and role",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's basic information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidates",
      "description": "Create candidate profile with resume upload (PDF/DOCX up to 5\u202fMB)",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update the authenticated candidate's profile fields",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "POST",
      "path": "/employers",
      "description": "Create employer profile for a user with role Employer",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employers/me",
      "description": "Update the authenticated employer's profile",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job posting (title, description, location, type, salary range, tags)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List active jobs with filter parameters and pagination (20 per page)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update an existing job posting owned by the employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Retire a job posting, setting its status to 'retired'",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Apply to a job using the saved candidate profile and optional cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Employer updates the status of an application (new, reviewed, interviewed, rejected, hired)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/search/jobs",
      "description": "Full\u2011text search for jobs with faceted filters (keyword, location, type, salary range)",
      "file": "app/routes/search_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/moderate",
      "description": "Admin flags or approves job or candidate content (sets moderation_status)",
      "file": "app/routes/admin_routes.py"
    }
  ],
