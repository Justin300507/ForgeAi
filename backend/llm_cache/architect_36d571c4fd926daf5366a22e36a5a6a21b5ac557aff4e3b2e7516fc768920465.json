{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile and preferences",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/users/me",
      "description": "Update user preferences such as reminder settings",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts",
      "description": "List workouts for the authenticated user with pagination (query: page, size)",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "POST",
      "path": "/workouts",
      "description": "Create a new workout (date, notes) for the authenticated user",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts/{id}",
      "description": "Retrieve a specific workout with its exercises and sets",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "PUT",
      "path": "/workouts/{id}",
      "description": "Update workout details (date, notes) for the owner",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/workouts/{id}",
      "description": "Delete a workout and all its related exercise entries and sets",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "POST",
      "path": "/workouts/{workout_id}/exercises",
      "description": "Add an exercise entry (name) to a workout",
      "file": "app/routes/exercise_entry_routes.py"
    },
    {
      "method": "POST",
      "path": "/exercises/{exercise_id}/sets",
      "description": "Add a set (set_number, reps, weight) to an exercise entry",
      "file": "app/routes/set_routes.py"
    },
    {
      "method": "GET",
      "path": "/personal_records",
      "description": "List personal records for the authenticated user",
      "file": "app/routes/personal_record_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/personal_records/{id}",
      "description": "Edit a personal record (max_weight, max_reps, record_date)",
      "file": "app/routes/personal_record_routes.py"
    },
    {
      "method": "GET",
      "path": "/stats/weekly_volume",
      "description": "Return total volume per week for the past 8 weeks for charting",
      "file": "app/routes/stats_routes.py"
    },
    {
      "method": "GET",
      "path": "/stats/exercise_aggregates",
      "description": "Return max weight, max reps, and total volume per exercise for the authenticated user",
      "file": "app/routes/stats_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "Integer",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "String",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "hashed_password",
          "type": "String",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "reminder_enabled",
          "type": "Boolean",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "reminder_time",
          "type": "String",
          "is_primary_key": false,
          "is_nullable": true
        }
      ]
    },
    {
      "table_name": "workouts",
      "columns": [
        {
          "name": "id",
          "type": "Integer",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "Integer",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "date",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "notes",
          "type": "Text",
          "is_primary_key": false,
          "is_nullable": true
        }
      ]
    },
    {
      "table_name": "exercise_entries",
      "columns": [
        {
          "name": "id",
          "type": "Integer",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "workout_id",
          "type": "Integer",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "exercise_name",
          "type": "String",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "sets",
      "columns": [
        {
          "name": "id",
          "type": "Integer",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "exercise_entry_id",
          "type": "Integer",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "set_number",
          "type": "Integer",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "reps",
          "type": "Integer",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "weight",
          "type": "Float",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "personal_records",
      "columns": [
        {
          "name": "id",
          "type": "Integer",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "Integer",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "exercise_name",
          "type": "String",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "max_weight",
          "type": "Float",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "max_reps",
          "type": "Integer",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "record_date",
          "type": "DateTime",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "app/models",
      "app/schemas",
      "app/routes",
      "app/services",
      "app/utils",
      "app/dependencies",
      "app/config"
    ]
  },
  "frontend_structure": {
    "pages": [
      "HomePage",
      "LoginPage",
      "RegisterPage",
      "WorkoutListPage",
      "WorkoutDetailPage",
      "NewWorkoutPage",
      "PersonalRecordsPage",
      "StatsPage",
      "SettingsPage"
    ],
    "components": [
      "Header",
      "Footer",
      "WorkoutCard",
      "ExerciseForm",
      "SetRow",
      "Chart",
      "SearchBar",
      "Pagination",
      "ReminderToggle",
      "Modal",
      "Timer"
    ]
  }
}