{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "List all users with pagination (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users",
      "description": "Create a new user account and assign role (admin)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user details such as role or activation status (admin)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/events",
      "description": "Retrieve paginated list of events with search and filter options",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event with basic details (organizer)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "PUT",
      "path": "/events/{id}",
      "description": "Edit event information or publish/cancel the event (organizer)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/events/{id}",
      "description": "Cancel an event and cascade cancel its shifts (organizer)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{event_id}/shifts",
      "description": "List all shifts belonging to a specific event",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "POST",
      "path": "/events/{event_id}/shifts",
      "description": "Create a shift template for an event (organizer)",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "PUT",
      "path": "/shifts/{id}",
      "description": "Edit shift details such as time or required volunteers (organizer)",
      "file": "app/routes/shift_routes.py"
    },
    {
      "method": "POST",
      "path": "/shifts/{shift_id}/signup",
      "description": "Volunteer signs up for a shift; validates capacity",
      "file": "app/routes/volunteer_shift_routes.py"
    },
    {
      "method": "GET",
      "path": "/my/shifts",
      "description": "Retrieve upcoming shifts the logged\u2011in volunteer has signed up for",
      "file": "app/routes/volunteer_shift_routes.py"
    },
    {
      "method": "POST",
      "path": "/volunteer_shifts/{vs_id}/hour_logs",
      "description": "Log actual hours worked for a signed\u2011up shift with validation",
      "file": "app/routes/hour_log_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/event_hours",
      "description": "Generate CSV report of total volunteer hours for a given event and date range",
      "file": "app/routes/report_routes.py"
    }
  ],
