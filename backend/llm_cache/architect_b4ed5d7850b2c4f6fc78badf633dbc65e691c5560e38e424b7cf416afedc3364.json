{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/auth/register",
      "description": "Register a new user (librarian or member) and create associated profile",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/books",
      "description": "List books with pagination and optional search by title, ISBN, or author name",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/books",
      "description": "Create a new book with linked author IDs; sets status to 'available'",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/books/{id}",
      "description": "Retrieve detailed information for a specific book, including authors and cover URL",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/api/books/{id}",
      "description": "Update book details and associated authors",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/api/books/{id}",
      "description": "Delete a book record",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/books/{id}/cover",
      "description": "Upload a JPEG/PNG cover image (max 5\u202fMB) for the book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/authors",
      "description": "List authors with pagination",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/authors",
      "description": "Create a new author record",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/authors/{id}",
      "description": "Retrieve details of a specific author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/borrowings",
      "description": "Create a borrowing for an available book; sets due date 14 days ahead",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/borrowings/{id}",
      "description": "Record return of a borrowed book; calculates overdue days if returned late",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/reservations",
      "description": "Create a reservation for a currently borrowed book; status starts as 'pending'",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/reservations",
      "description": "List reservations for the authenticated member with pagination",
      "file": "app/routes/reservation_routes.py"
    }
  ],
