{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (driver or operator) and return JWT tokens.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and issue JWT access and refresh tokens.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/lots",
      "description": "Public listing of parking lots with pagination and optional search filters.",
      "file": "app/routes/lot_routes.py"
    },
    {
      "method": "POST",
      "path": "/lots",
      "description": "Create a new parking lot (operator role) including optional image upload.",
      "file": "app/routes/lot_routes.py"
    },
    {
      "method": "PUT",
      "path": "/lots/{lot_id}",
      "description": "Update parking lot details such as name, address, capacity or image.",
      "file": "app/routes/lot_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/lots/{lot_id}",
      "description": "Delete a parking lot and cascade removal of its spots.",
      "file": "app/routes/lot_routes.py"
    },
    {
      "method": "GET",
      "path": "/lots/{lot_id}/spots",
      "description": "List spots for a specific lot with pagination and filter by type or price.",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "POST",
      "path": "/spots",
      "description": "Create a new parking spot within a lot (operator role).",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "PUT",
      "path": "/spots/{spot_id}",
      "description": "Update spot attributes such as status, type or hourly rate.",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations",
      "description": "List reservations for the authenticated driver with pagination.",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a spot if the requested time window is free.",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reservations/{reservation_id}",
      "description": "Cancel a reservation before its start time and trigger a refund.",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/payments",
      "description": "Process payment for a reservation via Stripe and record the transaction.",
      "file": "app/routes/payment_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/reservations",
      "description": "Export reservation and payment data as CSV, filterable by date range and lot.",
      "file": "app/routes/report_routes.py"
    },
    {
      "method": "GET",
      "path": "/ws/occupancy",
      "description": "WebSocket endpoint that streams real\u2011time spot status updates to subscribed clients.",
      "file": "app/routes/notification_routes.py"
    }
  ],
