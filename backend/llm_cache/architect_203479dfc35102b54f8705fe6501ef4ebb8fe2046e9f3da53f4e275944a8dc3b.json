{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/projects",
      "description": "Retrieve a list of all projects",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects",
      "description": "Create a new project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{id}",
      "description": "Get detailed information of a specific project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "PUT",
      "path": "/projects/{id}",
      "description": "Update an existing project's data",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/projects/{id}",
      "description": "Delete a project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{id}/milestones",
      "description": "List milestones for a specific project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects/{id}/milestones",
      "description": "Create a new milestone within a project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "Retrieve a list of tasks (optionally filtered by project)",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Get details of a specific task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tasks/{id}",
      "description": "Update an existing task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tasks/{id}",
      "description": "Delete a task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve a list of all users",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Get detailed information of a specific user",
      "file": "app/routes/user_routes.py"
    }
  ],
