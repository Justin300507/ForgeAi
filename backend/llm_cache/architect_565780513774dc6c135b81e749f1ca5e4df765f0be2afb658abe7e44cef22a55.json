{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (organizer or attendee) and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event with title, description, dates, and assign to a venue",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events",
      "description": "List events with pagination, search by keyword, date range, or venue",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{event_id}",
      "description": "Retrieve detailed information for a specific event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "PUT",
      "path": "/events/{event_id}",
      "description": "Update event details (title, description, dates, venue)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/events/{event_id}",
      "description": "Delete an event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/venues",
      "description": "Create a new venue with optional floor\u2011plan PDF upload",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "GET",
      "path": "/venues",
      "description": "List venues with pagination",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "GET",
      "path": "/venues/{venue_id}",
      "description": "Retrieve venue details",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "POST",
      "path": "/venues/{venue_id}/seats",
      "description": "Bulk create seats for a venue (row, number, optional section)",
      "file": "app/routes/seat_routes.py"
    },
    {
      "method": "GET",
      "path": "/venues/{venue_id}/seats",
      "description": "List seats of a venue ordered by row and number",
      "file": "app/routes/seat_routes.py"
    },
    {
      "method": "POST",
      "path": "/events/{event_id}/ticket-types",
      "description": "Create a ticket type for an event with price and quantity limit",
      "file": "app/routes/ticket_type_routes.py"
    },
    {
      "method": "POST",
      "path": "/events/{event_id}/reserve",
      "description": "Reserve specific seats for a ticket type, returns reservation token valid for 10 minutes",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/orders",
      "description": "Create an order from a valid reservation token, generate QR codes for tickets",
      "file": "app/routes/order_routes.py"
    }
  ],
