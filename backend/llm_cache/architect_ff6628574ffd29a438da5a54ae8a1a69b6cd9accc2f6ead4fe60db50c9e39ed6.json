{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user (driver or operator)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Get current authenticated user profile",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/parking_lots",
      "description": "List all parking lots with pagination",
      "file": "app/routes/parkinglot_routes.py"
    },
    {
      "method": "POST",
      "path": "/parking_lots",
      "description": "Create a new parking lot (operator only)",
      "file": "app/routes/parkinglot_routes.py"
    },
    {
      "method": "GET",
      "path": "/spots",
      "description": "Search spots by location, price range, and type; supports pagination",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "POST",
      "path": "/spots",
      "description": "Create a new spot within a parking lot (operator only)",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "PUT",
      "path": "/spots/{id}",
      "description": "Update spot attributes or status (operator only)",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a spot with conflict detection",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations",
      "description": "List reservations for the authenticated driver (pagination)",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations/{id}",
      "description": "Get details of a specific reservation",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/payments",
      "description": "Process payment for a reservation via mock Stripe endpoint",
      "file": "app/routes/payment_routes.py"
    },
    {
      "method": "GET",
      "path": "/payments/{id}",
      "description": "Retrieve payment receipt and status",
      "file": "app/routes/payment_routes.py"
    },
    {
      "method": "POST",
      "path": "/images",
      "description": "Upload PNG/JPEG image for a parking lot layout (operator only)",
      "file": "app/routes/image_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/overview",
      "description": "Get occupancy and revenue summary for the current hour",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
