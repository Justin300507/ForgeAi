{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user (owner or veterinarian)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/pets",
      "description": "List pets of the owner with pagination and search by name or breed",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "POST",
      "path": "/pets",
      "description": "Create a new pet record with optional photo upload",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "GET",
      "path": "/pets/{pet_id}",
      "description": "Retrieve detailed information for a specific pet",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "GET",
      "path": "/appointments",
      "description": "List appointments for the owner with pagination and filter by clinic",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "POST",
      "path": "/appointments",
      "description": "Schedule a new vet appointment for a pet",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "GET",
      "path": "/appointments/{appointment_id}",
      "description": "Get details of a specific appointment",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "GET",
      "path": "/vaccinations",
      "description": "List vaccination records for the owner with pagination and search by vaccine name",
      "file": "app/routes/vaccination_routes.py"
    },
    {
      "method": "POST",
      "path": "/vaccinations",
      "description": "Add a vaccination record and calculate next due date",
      "file": "app/routes/vaccination_routes.py"
    },
    {
      "method": "GET",
      "path": "/feeding-schedules",
      "description": "List feeding schedules for a pet",
      "file": "app/routes/feeding_schedule_routes.py"
    },
    {
      "method": "POST",
      "path": "/feeding-schedules",
      "description": "Create a daily feeding schedule for a pet",
      "file": "app/routes/feeding_schedule_routes.py"
    },
    {
      "method": "POST",
      "path": "/feeding-logs",
      "description": "Log an actual feeding event based on a schedule",
      "file": "app/routes/feeding_log_routes.py"
    },
    {
      "method": "GET",
      "path": "/vet/patients",
      "description": "Veterinarian view of pets assigned to their clinic with upcoming appointments and vaccination status",
      "file": "app/routes/vet_portal_routes.py"
    }
  ],
