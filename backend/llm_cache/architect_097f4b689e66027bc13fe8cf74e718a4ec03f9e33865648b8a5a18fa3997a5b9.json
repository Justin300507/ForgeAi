{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/contacts",
      "description": "Retrieve a list of contacts with optional search and filter parameters",
      "file": "app/routes/contact_routes.py"
    },
    {
      "method": "POST",
      "path": "/contacts",
      "description": "Create a new contact record",
      "file": "app/routes/contact_routes.py"
    },
    {
      "method": "GET",
      "path": "/contacts/{id}",
      "description": "Retrieve details of a specific contact by ID",
      "file": "app/routes/contact_routes.py"
    },
    {
      "method": "PUT",
      "path": "/contacts/{id}",
      "description": "Update an existing contact's information",
      "file": "app/routes/contact_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/contacts/{id}",
      "description": "Delete a contact record",
      "file": "app/routes/contact_routes.py"
    },
    {
      "method": "GET",
      "path": "/deals",
      "description": "Retrieve a list of deals with optional stage and date filters",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "POST",
      "path": "/deals",
      "description": "Create a new deal linked to a contact",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "GET",
      "path": "/deals/{id}",
      "description": "Retrieve details of a specific deal by ID",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "PUT",
      "path": "/deals/{id}",
      "description": "Update deal information such as stage or amount",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/deals/{id}",
      "description": "Delete a deal record",
      "file": "app/routes/deal_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "Retrieve a list of tasks with optional status and due date filters",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new follow\u2011up task linked to a contact or deal",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Retrieve details of a specific task by ID",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tasks/{id}",
      "description": "Update task details such as status or due date",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    }
  ],
