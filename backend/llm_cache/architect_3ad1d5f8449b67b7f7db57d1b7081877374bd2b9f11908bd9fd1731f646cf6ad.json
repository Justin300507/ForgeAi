{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Retrieve a list of recipes with optional search and category filters",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a specific recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/ingredients",
      "description": "Retrieve a list of ingredients",
      "file": "app/routes/ingredient_routes.py"
    },
    {
      "method": "POST",
      "path": "/ingredients",
      "description": "Add a new ingredient to the library",
      "file": "app/routes/ingredient_routes.py"
    },
    {
      "method": "GET",
      "path": "/ingredients/{id}",
      "description": "Get details of a specific ingredient",
      "file": "app/routes/ingredient_routes.py"
    },
    {
      "method": "PUT",
      "path": "/ingredients/{id}",
      "description": "Update an existing ingredient",
      "file": "app/routes/ingredient_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/ingredients/{id}",
      "description": "Remove an ingredient from the library",
      "file": "app/routes/ingredient_routes.py"
    },
    {
      "method": "GET",
      "path": "/mealplans",
      "description": "Retrieve all meal plans",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/mealplans",
      "description": "Create a new weekly meal plan",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "GET",
      "path": "/mealplans/{id}",
      "description": "Get details of a specific meal plan",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "PUT",
      "path": "/mealplans/{id}",
      "description": "Update an existing meal plan",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    }
  ],
