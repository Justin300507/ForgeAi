{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account and return a JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/users/{id}",
      "description": "Admin updates a user's role or activation status.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/profiles/me",
      "description": "Retrieve the authenticated user's profile information.",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/profiles/me",
      "description": "Update the authenticated user's profile (display name, bio, avatar).",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts",
      "description": "Return a paginated list of published posts ordered by newest first.",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}",
      "description": "Retrieve detailed information for a single post, including categories and comments.",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts",
      "description": "Create a new post (author, title, body, optional featured image).",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "PUT",
      "path": "/posts/{id}",
      "description": "Update an existing post owned by the author.",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/posts/{id}",
      "description": "Delete a post and cascade remove its categories and comments.",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all categories in hierarchical order.",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{post_id}/comments",
      "description": "Return a paginated list of comments for a specific post.",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{post_id}/comments",
      "description": "Add a new comment to a post (authenticated readers only).",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/comments/{id}",
      "description": "Edit a comment's content or mark it as deleted.",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "GET",
      "path": "/search",
      "description": "Search posts by title/body and categories by name; results are paginated.",
      "file": "app/routes/search_routes.py"
    }
  ],
