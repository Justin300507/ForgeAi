{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve current authenticated user's profile",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "List recipes with pagination and optional search/filters",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a single recipe, including nutrition and ingredients",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe with optional image upload and nutrition data",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe's details",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe owned by the user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/meal_plans",
      "description": "Create a new weekly meal plan for the authenticated user",
      "file": "app/routes/meal_plan_routes.py"
    },
    {
      "method": "GET",
      "path": "/meal_plans/{id}",
      "description": "Retrieve a specific meal plan with its items and nutrition totals",
      "file": "app/routes/meal_plan_routes.py"
    },
    {
      "method": "PUT",
      "path": "/meal_plans/{id}",
      "description": "Update week start date or other mutable fields of a meal plan",
      "file": "app/routes/meal_plan_routes.py"
    },
    {
      "method": "POST",
      "path": "/meal_plans/{id}/items",
      "description": "Add a recipe to a specific day and meal type within a meal plan",
      "file": "app/routes/mealplanitem_routes.py"
    },
    {
      "method": "POST",
      "path": "/shopping_lists",
      "description": "Generate a shopping list by aggregating ingredients from a given meal plan",
      "file": "app/routes/shopping_list_routes.py"
    },
    {
      "method": "GET",
      "path": "/shopping_lists/{id}",
      "description": "Retrieve a generated shopping list with aggregated ingredient quantities",
      "file": "app/routes/shopping_list_routes.py"
    },
    {
      "method": "POST",
      "path": "/shared_plan_links",
      "description": "Create a secure, time\u2011limited share link for a meal plan (dietitian role)",
      "file": "app/routes/shared_plan_link_routes.py"
    },
    {
      "method": "GET",
      "path": "/shared_plan_links/{token}",
      "description": "Access a read\u2011only view of a shared meal plan using a token",
      "file": "app/routes/shared_plan_link_routes.py"
    }
  ],
