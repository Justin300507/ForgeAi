{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve a paginated list of users (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/events",
      "description": "List events with pagination and optional search filters",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event (organizer role)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{event_id}",
      "description": "Get detailed information for a specific event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "PUT",
      "path": "/events/{event_id}",
      "description": "Update an existing event's details (organizer role)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/events/{event_id}",
      "description": "Delete an event (organizer role)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/venues",
      "description": "Create a venue and upload a floor\u2011plan image (organizer role)",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "GET",
      "path": "/venues",
      "description": "List venues with pagination and search capability",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "GET",
      "path": "/venues/{venue_id}",
      "description": "Retrieve venue details, including floor\u2011plan URL",
      "file": "app/routes/venue_routes.py"
    },
    {
      "method": "POST",
      "path": "/seats/batch",
      "description": "Bulk create seats for a specific venue (organizer role)",
      "file": "app/routes/seat_routes.py"
    },
    {
      "method": "POST",
      "path": "/orders",
      "description": "Create an order with selected seat IDs and ticket type (attendee role)",
      "file": "app/routes/order_routes.py"
    },
    {
      "method": "POST",
      "path": "/payments",
      "description": "Process payment for a pending order and mark it as paid",
      "file": "app/routes/payment_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/sales",
      "description": "Return aggregated real\u2011time sales data for the organizer's events",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
