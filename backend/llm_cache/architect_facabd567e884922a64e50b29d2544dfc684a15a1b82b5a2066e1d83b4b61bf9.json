{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, username, and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Retrieve a paginated list of recipes with optional filters (cuisine, cooking time, rating) and full\u2011text search",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a single recipe, including ingredients, steps, image, and average rating",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe (authenticated users only) with title, description, ingredients, steps, cuisine, cooking time, and optional cover image",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe owned by the authenticated user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/recipes/{id}",
      "description": "Delete a recipe owned by the authenticated user and cascade removal of related ratings and comments",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{id}/ratings",
      "description": "Submit a star rating (1\u20115) and optional comment for a recipe (authenticated users only)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{id}/comments",
      "description": "Add a text comment to a recipe (authenticated users only)",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/collections",
      "description": "List all collections belonging to the authenticated user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections",
      "description": "Create a new named collection for the authenticated user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections/{id}/recipes",
      "description": "Add a recipe to a specific collection owned by the user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/collections/{id}/recipes/{recipe_id}",
      "description": "Remove a recipe from a specific collection owned by the user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "GET",
      "path": "/moderation/queue",
      "description": "Admin endpoint to retrieve a paginated queue of newly submitted recipes and flagged comments awaiting review",
      "file": "app/routes/moderation_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/moderation/queue/{id}",
      "description": "Admin action to approve, reject, or delete content identified by queue entry ID; logs the action",
      "file": "app/routes/moderation_routes.py"
    }
  ],
