{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Create a new user account and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/lots",
      "description": "Create a new parking lot (operator role)",
      "file": "app/routes/lot_routes.py"
    },
    {
      "method": "GET",
      "path": "/lots",
      "description": "List parking lots with geo\u2011search and pagination",
      "file": "app/routes/lot_routes.py"
    },
    {
      "method": "PUT",
      "path": "/lots/{lot_id}",
      "description": "Update lot details such as name, address, capacity, or image",
      "file": "app/routes/lot_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/lots/{lot_id}",
      "description": "Delete a parking lot and all its spots",
      "file": "app/routes/lot_routes.py"
    },
    {
      "method": "POST",
      "path": "/lots/{lot_id}/spots",
      "description": "Add a new spot to a specific lot",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "GET",
      "path": "/lots/{lot_id}/spots",
      "description": "List spots of a lot with availability filtering and pagination",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "PUT",
      "path": "/spots/{spot_id}",
      "description": "Edit spot attributes (price, status, level, etc.)",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/spots/{spot_id}",
      "description": "Remove a spot from its lot",
      "file": "app/routes/spot_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a spot after availability check",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations/me",
      "description": "List reservations belonging to the authenticated driver",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reservations/{reservation_id}",
      "description": "Cancel a reservation (if allowed) and trigger refund",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/payments",
      "description": "Process payment for a reservation and update reservation status",
      "file": "app/routes/payment_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/revenue",
      "description": "Generate revenue report for a date range, returned as CSV",
      "file": "app/routes/report_routes.py"
    }
  ],
