{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users/register",
      "description": "Register a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve profile information for a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "List all users (admin view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Create a new sleep session record",
      "file": "app/routes/sleepsession_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions/{id}",
      "description": "Retrieve details of a specific sleep session",
      "file": "app/routes/sleepsession_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions/user/{user_id}",
      "description": "List all sleep sessions for a given user",
      "file": "app/routes/sleepsession_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions/summary",
      "description": "Get daily or weekly sleep summary for a user (query params: user_id, type=daily|weekly)",
      "file": "app/routes/sleepsession_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions/export",
      "description": "Export a user's sleep data as CSV (query param: user_id)",
      "file": "app/routes/sleepsession_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions",
      "description": "List all sleep sessions (admin view)",
      "file": "app/routes/sleepsession_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "password_hash",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "name",
          "type": "VARCHAR(150)",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "timezone",
          "type": "VARCHAR(50)",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "sleep_sessions",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "start_time",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "end_time",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "duration_minutes",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "quality_rating",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "notes",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "app",
      "app/models",
      "app/schemas",
      "app/services",
      "app/routes",
      "app/utils",
      "app/dependencies",
      "app/config"
    ]
  },
  "frontend_structure": {
    "pages": [
      "Login",
      "Register",
      "Dashboard",
      "SleepLog",
      "SessionDetail"
    ],
    "components": [
      "Navbar",
      "Footer",
      "SleepForm",
      "SessionCard",
      "SummaryChart",
      "TrendChart",
      "ExportButton",
      "QualityRating",
      "DatePicker",
      "LoadingSpinner"
    ]
  }
}