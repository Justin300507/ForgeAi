{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new member and create associated User record",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination and optional search query",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book, upload cover image, and auto\u2011create authors if needed",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/books/{book_id}",
      "description": "Partially update book fields",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{book_id}",
      "description": "Delete a book record",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List authors with pagination",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/members",
      "description": "List all members (librarian view)",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Create a new member (admin or self\u2011registration)",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/members/{member_id}",
      "description": "Edit member details or deactivate account",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Borrow an available book, create active borrowing and decrement availability",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/borrowings/{borrowing_id}",
      "description": "Return a borrowed book, set status to returned and increment availability",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a loaned\u2011out book and assign queue position",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/overdue",
      "description": "Retrieve paginated list of overdue borrowings with member contact info",
      "file": "app/routes/report_routes.py"
    }
  ],
