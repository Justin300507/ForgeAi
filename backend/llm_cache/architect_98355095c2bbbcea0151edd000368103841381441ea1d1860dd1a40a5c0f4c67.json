{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, password and role (owner or vet). Returns JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and return a JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get profile of the currently authenticated user.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/pets",
      "description": "List pets belonging to the logged\u2011in owner with pagination and optional search by name or breed.",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "POST",
      "path": "/pets",
      "description": "Create a new pet record with details and optional photo upload.",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "GET",
      "path": "/pets/{id}",
      "description": "Retrieve detailed information for a specific pet, including vaccinations, appointments and feeding schedules.",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "PUT",
      "path": "/pets/{id}",
      "description": "Update pet information or replace the pet photo.",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/pets/{id}",
      "description": "Delete a pet record owned by the user.",
      "file": "app/routes/pet_routes.py"
    },
    {
      "method": "GET",
      "path": "/appointments",
      "description": "List upcoming appointments for the owner (or shared pets for vets) with pagination.",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "POST",
      "path": "/appointments",
      "description": "Create a new veterinary appointment for a selected pet.",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "PUT",
      "path": "/appointments/{id}",
      "description": "Edit appointment details such as date, time, clinic or notes.",
      "file": "app/routes/appointment_routes.py"
    },
    {
      "method": "GET",
      "path": "/feedings",
      "description": "List feeding schedules for the owner\u2019s pets with pagination.",
      "file": "app/routes/feeding_routes.py"
    },
    {
      "method": "POST",
      "path": "/feedings",
      "description": "Create a feeding schedule entry (meal time, food type, quantity, repeat pattern) for a pet.",
      "file": "app/routes/feeding_routes.py"
    },
    {
      "method": "POST",
      "path": "/documents",
      "description": "Upload a pet photo or document (PDF) and associate it with a pet or user.",
      "file": "app/routes/document_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "Retrieve a paginated list of push notifications for the logged\u2011in user.",
      "file": "app/routes/notification_routes.py"
    }
  ],
