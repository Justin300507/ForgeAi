{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the profile of the currently authenticated user.",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/exercises",
      "description": "List exercises with pagination and optional search by name or muscle group.",
      "file": "app/routes/exercise_routes.py"
    },
    {
      "method": "GET",
      "path": "/exercises/{id}",
      "description": "Get detailed information for a specific exercise.",
      "file": "app/routes/exercise_routes.py"
    },
    {
      "method": "POST",
      "path": "/exercises",
      "description": "Create a new exercise (trainer role).",
      "file": "app/routes/exercise_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts",
      "description": "Paginated list of the user's workouts, searchable by date or name.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/workouts/{id}",
      "description": "Retrieve a workout with its nested exercises and sets.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "POST",
      "path": "/workouts",
      "description": "Create a new workout including nested exercises and sets.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "PUT",
      "path": "/workouts/{id}",
      "description": "Update an existing workout and its nested data.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/workouts/{id}",
      "description": "Delete a workout owned by the user.",
      "file": "app/routes/workout_routes.py"
    },
    {
      "method": "GET",
      "path": "/personal_records",
      "description": "List personal records for the authenticated user.",
      "file": "app/routes/personalrecord_routes.py"
    },
    {
      "method": "POST",
      "path": "/personal_records",
      "description": "Create or update a personal record when a set is marked as a PR.",
      "file": "app/routes/personalrecord_routes.py"
    },
    {
      "method": "GET",
      "path": "/templates",
      "description": "List workout templates created by the trainer.",
      "file": "app/routes/template_routes.py"
    },
    {
      "method": "POST",
      "path": "/templates",
      "description": "Create a new workout template (trainer role).",
      "file": "app/routes/template_routes.py"
    },
    {
      "method": "POST",
      "path": "/templates/{id}/assign",
      "description": "Assign a template to a client, creating a pre\u2011filled workout for them.",
      "file": "app/routes/template_routes.py"
    }
  ],
