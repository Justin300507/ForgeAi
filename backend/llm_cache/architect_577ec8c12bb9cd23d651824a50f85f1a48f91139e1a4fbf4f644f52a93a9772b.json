{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "List all users with pagination (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/users",
      "description": "Create a new user and assign a role (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user details or role (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/users/{id}",
      "description": "Deactivate a user account (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/roles",
      "description": "Retrieve list of available roles",
      "file": "app/routes/role_routes.py"
    },
    {
      "method": "GET",
      "path": "/products",
      "description": "List products with pagination and search by name or SKU",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "POST",
      "path": "/products",
      "description": "Create a new product with initial stock and optional low\u2011stock threshold",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/products/{id}",
      "description": "Get detailed information for a single product",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "PUT",
      "path": "/products/{id}",
      "description": "Update product attributes, including low\u2011stock threshold",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/products/{id}",
      "description": "Delete a product from the catalog",
      "file": "app/routes/product_routes.py"
    },
    {
      "method": "GET",
      "path": "/stock_transactions",
      "description": "List stock transactions with pagination and optional product filter",
      "file": "app/routes/stock_transaction_routes.py"
    },
    {
      "method": "POST",
      "path": "/stock_transactions",
      "description": "Record a stock receipt or sale, adjusting product quantity",
      "file": "app/routes/stock_transaction_routes.py"
    },
    {
      "method": "GET",
      "path": "/alerts",
      "description": "Retrieve current low\u2011stock alerts for the manager",
      "file": "app/routes/alert_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard/summary",
      "description": "Provide inventory health summary for dashboard display",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
