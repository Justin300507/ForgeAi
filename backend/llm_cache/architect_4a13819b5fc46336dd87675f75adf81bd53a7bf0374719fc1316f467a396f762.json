{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve list of user profiles (admin or public view)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve a single user profile by ID",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "List recipes with optional pagination",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a specific recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes/{id}/rating",
      "description": "Submit a rating (and optional comment) for a recipe",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/search",
      "description": "Search recipes by keywords, ingredients, cuisine, or dietary tags",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/mealplans/{id}",
      "description": "Retrieve a specific meal plan with its assigned recipes",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "POST",
      "path": "/mealplans",
      "description": "Create a new weekly meal plan for the authenticated user",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "PUT",
      "path": "/mealplans/{id}",
      "description": "Update meal plan metadata (e.g., week start date)",
      "file": "app/routes/mealplan_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/mealplans/{id}/recipes",
      "description": "Add or remove a recipe assignment for a specific day and meal time within the plan",
      "file": "app/routes/mealplan_routes.py"
    }
  ],
