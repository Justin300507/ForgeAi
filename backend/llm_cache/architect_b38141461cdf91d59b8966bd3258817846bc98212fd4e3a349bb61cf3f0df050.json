{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/users",
      "description": "Register a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update the profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/events",
      "description": "List all events with optional search and filter parameters",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "GET",
      "path": "/events/{id}",
      "description": "Get detailed information for a specific event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/events",
      "description": "Create a new event (organizer role required)",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "PUT",
      "path": "/events/{id}",
      "description": "Update an existing event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/events/{id}",
      "description": "Delete an event",
      "file": "app/routes/event_routes.py"
    },
    {
      "method": "POST",
      "path": "/tickets",
      "description": "Purchase/register a ticket for an event",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets",
      "description": "List tickets belonging to the authenticated user",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/{id}",
      "description": "Retrieve ticket details including QR code",
      "file": "app/routes/ticket_routes.py"
    }
  ],
