{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/profiles/{username}",
      "description": "Retrieve public profile of a user by username",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts",
      "description": "List posts with pagination, optional category filter and search query",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts",
      "description": "Create a new blog post (author only, supports image upload)",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}",
      "description": "Retrieve a single post by its ID",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "PUT",
      "path": "/posts/{id}",
      "description": "Update an existing post owned by the author (supports image replacement)",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/posts/{id}",
      "description": "Delete a post owned by the author",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all categories in hierarchical order with pagination",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new category (admin only)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "PUT",
      "path": "/categories/{id}",
      "description": "Rename or reparent an existing category (admin only)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/categories/{id}",
      "description": "Delete a category if it has no associated posts (admin only)",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}/comments",
      "description": "List comments for a post with pagination",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{id}/comments",
      "description": "Add a new comment to a post (authenticated users)",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "PUT",
      "path": "/comments/{id}",
      "description": "Edit a comment owned by the author",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/comments/{id}",
      "description": "Delete a comment owned by the author",
      "file": "app/routes/comment_routes.py"
    }
  ],
