{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/users",
      "description": "Create a new user (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/users/{user_id}/role",
      "description": "Update a user's role (admin only)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/projects",
      "description": "List all projects accessible to the user",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/projects/{project_id}",
      "description": "Get project details and members",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/projects/{project_id}/dashboard",
      "description": "Return issue count per status for the project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/projects/{project_id}/issues",
      "description": "List issues in a project with filtering, pagination",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/projects/{project_id}/issues",
      "description": "Create a new issue in a project",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/issues/{issue_id}",
      "description": "Update issue fields, including allowed status transitions",
      "file": "app/routes/issue_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/issues/{issue_id}/comments",
      "description": "List comments for an issue with pagination",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/issues/{issue_id}/comments",
      "description": "Add a comment to an issue",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/comments/{comment_id}/attachments",
      "description": "Upload an attachment to a comment (max 5\u202fMB)",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/attachments/{attachment_id}",
      "description": "Download an attachment file",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/search",
      "description": "Full\u2011text search across projects and issues",
      "file": "app/routes/search_routes.py"
    },
    {
      "method": "WS",
      "path": "/ws/issues/{issue_id}/stream",
      "description": "WebSocket stream for real\u2011time comment and status events on an issue",
      "file": "app/routes/issue_routes.py"
    }
  ],
