{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/rooms",
      "description": "Retrieve a list of active rooms with optional search filters",
      "file": "app/routes/room_routes.py"
    },
    {
      "method": "GET",
      "path": "/rooms/{id}",
      "description": "Retrieve detailed information for a specific room",
      "file": "app/routes/room_routes.py"
    },
    {
      "method": "POST",
      "path": "/rooms",
      "description": "Create a new room (admin only)",
      "file": "app/routes/room_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations",
      "description": "List reservations for the authenticated guest",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a new reservation for a room",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reservations/{id}",
      "description": "Get details of a specific reservation",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "PUT",
      "path": "/reservations/{id}",
      "description": "Update reservation details (e.g., change dates or cancel)",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reservations/{id}",
      "description": "Delete (cancel) a reservation",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/guests",
      "description": "List all guests (admin view)",
      "file": "app/routes/guest_routes.py"
    },
    {
      "method": "GET",
      "path": "/guests/{id}",
      "description": "Retrieve profile information for a specific guest",
      "file": "app/routes/guest_routes.py"
    },
    {
      "method": "POST",
      "path": "/guests",
      "description": "Register a new guest account",
      "file": "app/routes/guest_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate guest and issue JWT token",
      "file": "app/routes/guest_routes.py"
    }
  ],
