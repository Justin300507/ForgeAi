{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email and password",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/habits",
      "description": "List all active habits for the authenticated user",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "POST",
      "path": "/habits",
      "description": "Create a new habit for the authenticated user",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "GET",
      "path": "/habits/{id}",
      "description": "Get details of a specific habit belonging to the user",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "PUT",
      "path": "/habits/{id}",
      "description": "Update name, description, or active status of a habit",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/habits/{id}",
      "description": "Delete a habit and its associated logs",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "GET",
      "path": "/habits/{id}/streak",
      "description": "Calculate and return the current streak for the habit",
      "file": "app/routes/habit_routes.py"
    },
    {
      "method": "POST",
      "path": "/habit-logs",
      "description": "Log completion status for a habit on a specific date",
      "file": "app/routes/habitlog_routes.py"
    },
    {
      "method": "GET",
      "path": "/habit-logs",
      "description": "Retrieve habit logs filtered by habit_id (and optional date range)",
      "file": "app/routes/habitlog_routes.py"
    },
    {
      "method": "GET",
      "path": "/habit-logs/{id}",
      "description": "Get a single habit log entry by its ID",
      "file": "app/routes/habitlog_routes.py"
    },
    {
      "method": "PUT",
      "path": "/habit-logs/{id}",
      "description": "Update the completion flag of an existing habit log",
      "file": "app/routes/habitlog_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/habit-logs/{id}",
      "description": "Remove a habit log entry",
      "file": "app/routes/habitlog_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "password_hash",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "habits",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "name",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "description",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "is_active",
          "type": "BOOLEAN",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "habit_logs",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "habit_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "log_date",
          "type": "DATE",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "completed",
          "type": "BOOLEAN",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "app",
      "app/models",
      "app/schemas",
      "app/services",
      "app/routes",
      "app/utils",
      "app/config",
      "app/dependencies"
    ]
  },
  "frontend_structure": {
    "pages": [
      "Login",
      "Register",
      "Dashboard",
      "HabitDetail",
      "Settings"
    ],
    "components": [
      "Header",
      "Footer",
      "Sidebar",
      "HabitCard",
      "HabitList",
      "HabitForm",
      "HabitLogEntry",
      "StreakBadge",
      "LoginForm",
      "RegisterForm",
      "DashboardChart",
      "ProfileForm",
      "LogoutButton",
      "ToggleSwitch",
      "DatePicker"
    ]
  }
}