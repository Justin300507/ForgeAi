{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and receive a JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and receive a JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "List tasks for the authenticated user with pagination, sorting by due date and priority, and optional completed filter",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new task for the authenticated user",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Retrieve a specific task belonging to the authenticated user",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/tasks/{id}",
      "description": "Update mutable fields of a task (title, description, priority, due_date, completed)",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tasks/{id}",
      "description": "Delete a task owned by the authenticated user",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks/{id}/complete",
      "description": "Toggle the completed flag of a task",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/search",
      "description": "Search tasks by keyword in title or description with pagination",
      "file": "app/routes/task_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "password_hash",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "updated_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "tasks",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "title",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "description",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "priority",
          "type": "VARCHAR(10)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "due_date",
          "type": "DATE",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "completed",
          "type": "BOOLEAN",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "updated_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "app",
      "app/models",
      "app/schemas",
      "app/routes",
      "app/services",
      "app/utils",
      "app/dependencies",
      "app/config",
      "app/main.py"
    ]
  },
  "frontend_structure": {
    "pages": [
      "LoginPage",
      "SignupPage",
      "TaskListPage",
      "TaskDetailPage",
      "TaskCreatePage",
      "TaskEditPage"
    ],
    "components": [
      "Header",
      "Footer",
      "TaskItem",
      "TaskForm",
      "PaginationControls",
      "SearchBar",
      "ProtectedRoute",
      "TaskPriorityBadge",
      "DatePicker",
      "LoadingSpinner"
    ]
  }
}