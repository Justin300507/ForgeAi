{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user (candidate, employer, or admin) and return JWT tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user credentials and issue JWT access and refresh tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Initiate password reset flow by sending a reset email to the user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the authenticated candidate's profile including resume URL",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Create or update the authenticated candidate's profile and upload resume",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/companies/me",
      "description": "Retrieve the authenticated employer's company profile including logo URL",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "PUT",
      "path": "/companies/me",
      "description": "Create or update the authenticated employer's company profile and upload logo",
      "file": "app/routes/company_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List job listings with pagination, keyword search, and filters (location, remote, employment type, salary range)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing for the authenticated employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update an existing job listing; can also change status to deactivate",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job, optionally uploading a new resume and cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications for the current user (candidates see own apps; employers see apps for their jobs) with optional status filter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}",
      "description": "Employer updates the status of an application (e.g., reviewed, interview, rejected)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/logs",
      "description": "Admin retrieves audit logs with filters for admin, action type, and date range",
      "file": "app/routes/admin_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/users/{id}/deactivate",
      "description": "Admin deactivates a user account identified by user ID",
      "file": "app/routes/admin_routes.py"
    }
  ],
