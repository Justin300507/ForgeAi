{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user with email, username, and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Request password reset email for a registered email address",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve the authenticated user's profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes",
      "description": "Get paginated list of published recipes with optional filters (cuisine, difficulty) and search query",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "GET",
      "path": "/recipes/{id}",
      "description": "Get detailed information for a specific recipe, including ingredients, steps, image, and average rating",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/recipes",
      "description": "Create a new recipe (title, description, ingredients, steps, optional image) for the authenticated user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "PUT",
      "path": "/recipes/{id}",
      "description": "Update an existing recipe owned by the authenticated user",
      "file": "app/routes/recipe_routes.py"
    },
    {
      "method": "POST",
      "path": "/ratings",
      "description": "Create or update a rating (1\u20115 stars) for a recipe by the authenticated user",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/ratings/{id}",
      "description": "Delete a rating owned by the authenticated user",
      "file": "app/routes/rating_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections",
      "description": "Create a new personal collection for the authenticated user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/collections/{id}/recipes",
      "description": "Add a recipe to the specified collection of the authenticated user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/collections/{id}/recipes/{recipe_id}",
      "description": "Remove a recipe from the specified collection of the authenticated user",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/flags",
      "description": "List flagged recipes for moderation (admin only) with pagination",
      "file": "app/routes/flag_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/flags/{id}",
      "description": "Update flag status (e.g., hide or delete the associated recipe) by an admin",
      "file": "app/routes/flag_routes.py"
    }
  ],
