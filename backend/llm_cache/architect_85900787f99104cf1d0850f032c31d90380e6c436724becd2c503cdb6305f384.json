{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and create credentials",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/clients",
      "description": "Retrieve list of all clients",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "POST",
      "path": "/clients",
      "description": "Create a new client record",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "GET",
      "path": "/clients/{id}",
      "description": "Get detailed information for a specific client",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "PUT",
      "path": "/clients/{id}",
      "description": "Update information of an existing client",
      "file": "app/routes/client_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects",
      "description": "Retrieve list of all projects",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "POST",
      "path": "/projects",
      "description": "Create a new project linked to a client",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{id}",
      "description": "Get detailed information for a specific project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "PUT",
      "path": "/projects/{id}",
      "description": "Update details of an existing project",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/projects/{id}/invoice",
      "description": "Generate an invoice for the project based on its time entries",
      "file": "app/routes/project_routes.py"
    },
    {
      "method": "GET",
      "path": "/time-entries",
      "description": "Retrieve list of time entries (optional filter by project via query param)",
      "file": "app/routes/timeentry_routes.py"
    },
    {
      "method": "POST",
      "path": "/time-entries",
      "description": "Log a new time entry for a project",
      "file": "app/routes/timeentry_routes.py"
    },
    {
      "method": "GET",
      "path": "/time-entries/{id}",
      "description": "Get details of a specific time entry",
      "file": "app/routes/timeentry_routes.py"
    },
    {
      "method": "PUT",
      "path": "/time-entries/{id}",
      "description": "Update an existing time entry",
      "file": "app/routes/timeentry_routes.py"
    }
  ],
