{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Register a new user and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset/request",
      "description": "Request a password reset email with token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset/confirm",
      "description": "Confirm password reset with token and set new password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve current user's profile information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update current user's profile settings",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me/saved-jobs",
      "description": "List jobs saved by the current job seeker",
      "file": "app/routes/saved_job_routes.py"
    },
    {
      "method": "GET",
      "path": "/employers/me",
      "description": "Retrieve the employer's company profile",
      "file": "app/routes/employer_profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List job posts with pagination and filters (keyword, location, category)",
      "file": "app/routes/job_post_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Get detailed information for a specific job post",
      "file": "app/routes/job_post_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job posting (employer only)",
      "file": "app/routes/job_post_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit a job application with resume upload",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/me",
      "description": "List applications submitted by the current job seeker",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications/{id}",
      "description": "View details of a specific application (employer view)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "POST",
      "path": "/admin/moderation/flags/{id}/action",
      "description": "Admin action to hide or delete flagged content",
      "file": "app/routes/admin_routes.py"
    }
  ],
