{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Create a new user account and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/password-reset",
      "description": "Request password reset token or reset password using token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Public job listings with keyword, location, job\u2011type filters and pagination",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Employer creates a new job posting",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Retrieve detailed information for a specific job posting",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Employer updates their own job posting",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Employer deletes their own job posting",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs/{job_id}/apply",
      "description": "Job seeker submits an application with cover letter and resume",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/employer/applications",
      "description": "Employer lists applications for their jobs with pagination and status filter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}/status",
      "description": "Employer updates the status of an application and triggers email notification",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/profile/me",
      "description": "Job seeker retrieves their personal profile",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "PUT",
      "path": "/profile/me",
      "description": "Job seeker creates or updates profile fields and uploads resume PDF",
      "file": "app/routes/profile_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/users",
      "description": "Admin lists all user accounts with pagination",
      "file": "app/routes/admin_user_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/users/{id}/deactivate",
      "description": "Admin deactivates a user account, forcing immediate logout",
      "file": "app/routes/admin_user_routes.py"
    }
  ],
