{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and issue JWT",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update profile of the authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/groups",
      "description": "List groups the user belongs to",
      "file": "app/routes/group_routes.py"
    },
    {
      "method": "POST",
      "path": "/groups",
      "description": "Create a new expense group",
      "file": "app/routes/group_routes.py"
    },
    {
      "method": "GET",
      "path": "/groups/{group_id}",
      "description": "Get details of a specific group",
      "file": "app/routes/group_routes.py"
    },
    {
      "method": "POST",
      "path": "/groups/{group_id}/members",
      "description": "Invite a user to the group",
      "file": "app/routes/group_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/groups/{group_id}/members/{user_id}",
      "description": "Remove a member from the group",
      "file": "app/routes/group_routes.py"
    },
    {
      "method": "GET",
      "path": "/groups/{group_id}/expenses",
      "description": "List expenses for a group",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "POST",
      "path": "/groups/{group_id}/expenses",
      "description": "Add a new expense with automatic equal split",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "GET",
      "path": "/groups/{group_id}/expenses/{expense_id}",
      "description": "Get details of a specific expense",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "PUT",
      "path": "/groups/{group_id}/expenses/{expense_id}",
      "description": "Update an existing expense",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/groups/{group_id}/expenses/{expense_id}",
      "description": "Delete an expense",
      "file": "app/routes/expense_routes.py"
    },
    {
      "method": "GET",
      "path": "/groups/{group_id}/settlements",
      "description": "Calculate and retrieve settlement suggestions for the group",
      "file": "app/routes/settlement_routes.py"
    }
  ],
