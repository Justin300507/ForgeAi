{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/api/auth/register",
      "description": "Register a new user and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Authenticate user credentials and return a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/bookmarks",
      "description": "Create a new bookmark with URL, title, description, tags, and optional collection assignments",
      "file": "app/routes/bookmark_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/bookmarks",
      "description": "Retrieve a paginated list of the authenticated user's bookmarks",
      "file": "app/routes/bookmark_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/bookmarks/{id}",
      "description": "Get bookmark details; public bookmarks are accessible without authentication",
      "file": "app/routes/bookmark_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/bookmarks/{id}",
      "description": "Update bookmark fields (title, description, tags, collections, privacy)",
      "file": "app/routes/bookmark_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/api/bookmarks/{id}",
      "description": "Delete a bookmark and its tag associations",
      "file": "app/routes/bookmark_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/collections",
      "description": "Create a new collection with name, description, privacy, and optional initial bookmarks",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/collections",
      "description": "Retrieve a paginated list of the authenticated user's collections",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/collections/{id}",
      "description": "Get collection details; public collections are accessible without authentication",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/api/collections/{id}",
      "description": "Update collection fields (name, description, privacy, bookmark assignments)",
      "file": "app/routes/collection_routes.py"
    },
    {
      "method": "POST",
      "path": "/api/follows/{followee_id}",
      "description": "Create a follow relationship from the authenticated user to the specified user",
      "file": "app/routes/follow_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/api/follows/{followee_id}",
      "description": "Remove the follow relationship from the authenticated user to the specified user",
      "file": "app/routes/follow_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/feed",
      "description": "Return a paginated feed of public bookmarks from users the authenticated user follows",
      "file": "app/routes/feed_routes.py"
    },
    {
      "method": "GET",
      "path": "/api/search",
      "description": "Search bookmarks or collections by free\u2011text query and/or tag filters; supports pagination",
      "file": "app/routes/search_routes.py"
    }
  ],
