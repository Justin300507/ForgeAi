{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account with role and credentials",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve current authenticated user's basic info",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/profile",
      "description": "Get the candidate's personal profile",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/profile",
      "description": "Create or update candidate profile fields (name, phone, summary)",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidates/resume",
      "description": "Upload a resume file (PDF/DOC/DOCX up to 5\u202fMB) and link it to the candidate profile",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "Search and list job listings with filters, pagination (20 per page) and total count",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs/{id}",
      "description": "Retrieve detailed information for a specific job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job posting (title, description, location, salary range, tags) as an employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/jobs/{id}",
      "description": "Edit an existing job posting (e.g., update description, salary, tags) while keeping it open",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/jobs/{id}",
      "description": "Deactivate a job listing (set status to Closed/Removed)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application for a job using the saved resume and a cover letter",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}",
      "description": "Employer updates application status (Reviewed, Interview, Rejected)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/admin/users",
      "description": "Admin lists all user accounts with role and status filters",
      "file": "app/routes/admin_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/admin/users/{id}/deactivate",
      "description": "Admin deactivates a user account",
      "file": "app/routes/admin_routes.py"
    }
  ],
