{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and return a JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user (librarian) account.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination and keyword search.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve detailed information for a single book.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record with cover image upload and author links.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update an existing book's details.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book from the catalog.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List authors with pagination.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author record.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/members",
      "description": "List library members with pagination.",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Register a new library member (patron).",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/{id}",
      "description": "Edit member details or deactivate the member.",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Check out a book to a member, creating a borrowing record with due date.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings/{id}/return",
      "description": "Process the return of a borrowed book and update status/reservations.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a book that is currently checked out.",
      "file": "app/routes/reservation_routes.py"
    }
  ],
