{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and store hashed credentials",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access and refresh tokens",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Retrieve profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/me",
      "description": "Update profile fields of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions",
      "description": "List subscriptions with pagination, search by name, and filter by status or category",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "POST",
      "path": "/subscriptions",
      "description": "Create a new subscription linked to the logged\u2011in user",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions/{id}",
      "description": "Get detailed information for a specific subscription",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "PUT",
      "path": "/subscriptions/{id}",
      "description": "Update fields of an existing subscription",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/subscriptions/{id}",
      "description": "Delete a subscription permanently",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions/export",
      "description": "Export the authenticated user's subscriptions as a CSV file",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/categories",
      "description": "List all categories belonging to the authenticated user",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "POST",
      "path": "/categories",
      "description": "Create a new category for organizing subscriptions",
      "file": "app/routes/category_routes.py"
    },
    {
      "method": "GET",
      "path": "/notifications",
      "description": "List scheduled notifications and current notification preferences",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "PUT",
      "path": "/notifications/settings",
      "description": "Enable or disable notification channels and set lead time",
      "file": "app/routes/notification_routes.py"
    },
    {
      "method": "GET",
      "path": "/analytics/summary",
      "description": "Return monthly spend totals and category breakdowns for dashboard charts",
      "file": "app/routes/analytics_routes.py"
    }
  ],
