{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with username, email, and password",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "description": "Invalidate the current JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/me",
      "description": "Retrieve profile of the authenticated user",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get current user's detailed information",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks",
      "description": "List all tasks for the authenticated user, sorted by priority",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "description": "Create a new task with title, description, priority, and optional due date",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "GET",
      "path": "/tasks/{id}",
      "description": "Retrieve a specific task by its ID",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tasks/{id}",
      "description": "Update an existing task's details, including priority and completion status",
      "file": "app/routes/task_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/tasks/{id}",
      "description": "Delete a task owned by the authenticated user",
      "file": "app/routes/task_routes.py"
    }
  ],
  "database_schema": [
    {
      "table_name": "users",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "username",
          "type": "VARCHAR(150)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "hashed_password",
          "type": "VARCHAR(255)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    },
    {
      "table_name": "tasks",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "is_primary_key": true,
          "is_nullable": false
        },
        {
          "name": "user_id",
          "type": "INTEGER",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "title",
          "type": "VARCHAR(200)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "description",
          "type": "TEXT",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "priority",
          "type": "VARCHAR(10)",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "due_date",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": true
        },
        {
          "name": "completed",
          "type": "BOOLEAN",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "created_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        },
        {
          "name": "updated_at",
          "type": "DATETIME",
          "is_primary_key": false,
          "is_nullable": false
        }
      ]
    }
  ],
  "folder_structure": {
    "backend": [
      "routes",
      "models",
      "schemas",
      "services",
      "utils",
      "dependencies",
      "config"
    ]
  },
  "frontend_structure": {
    "pages": [
      "Login",
      "Register",
      "Dashboard",
      "TaskForm",
      "Settings"
    ],
    "components": [
      "Header",
      "Footer",
      "Sidebar",
      "LoginForm",
      "RegisterForm",
      "SettingsForm",
      "TaskList",
      "TaskItem",
      "PriorityBadge",
      "TaskForm",
      "Modal",
      "ConfirmationDialog",
      "ErrorAlert",
      "LoadingSpinner",
      "UserAvatar"
    ]
  }
}