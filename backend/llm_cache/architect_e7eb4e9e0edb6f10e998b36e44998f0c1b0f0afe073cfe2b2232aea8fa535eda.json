{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination and optional search query",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve detailed information for a single book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record with associated authors",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update book fields and its author relationships",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book from the catalog",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List all authors with pagination",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PUT",
      "path": "/authors/{id}",
      "description": "Update author details",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Register a new library member and generate a unique card number",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/{id}",
      "description": "Edit member information or deactivate the member (soft delete)",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Create a borrowing record when a member checks out an available book",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "PUT",
      "path": "/borrowings/{id}/return",
      "description": "Mark a borrowing as returned and update book availability",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Place a reservation for a checked\u2011out book and add the member to the queue",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reservations/{id}",
      "description": "Cancel a reservation made by a member",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/overdue",
      "description": "Paginated report of borrowings past their due date",
      "file": "app/routes/report_routes.py"
    }
  ],
