{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user with email, password and role",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "description": "Get profile of the currently authenticated user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/instruments",
      "description": "List instruments of the logged\u2011in musician with pagination and optional search",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "POST",
      "path": "/instruments",
      "description": "Create a new instrument for the logged\u2011in musician",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "PUT",
      "path": "/instruments/{id}",
      "description": "Update name, type or description of an existing instrument",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/instruments/{id}",
      "description": "Delete an instrument owned by the logged\u2011in musician",
      "file": "app/routes/instrument_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions",
      "description": "Retrieve paginated list of practice sessions for the user, filterable by instrument or date",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions",
      "description": "Log a new practice session, optionally uploading an audio file",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "GET",
      "path": "/sessions/{id}",
      "description": "Get detailed information of a single practice session, including audio playback URL",
      "file": "app/routes/session_routes.py"
    },
    {
      "method": "GET",
      "path": "/goals",
      "description": "List practice goals for the user with current progress percentages",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/goals",
      "description": "Create a weekly or monthly practice goal for a specific instrument",
      "file": "app/routes/goal_routes.py"
    },
    {
      "method": "POST",
      "path": "/sessions/{session_id}/comments",
      "description": "Teacher adds a comment to a student's practice session",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "GET",
      "path": "/teacher/students",
      "description": "Teacher retrieves list of assigned students with their latest session dates",
      "file": "app/routes/teacher_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/student/{student_id}/pdf",
      "description": "Generate and download a PDF report of a student's monthly practice activity",
      "file": "app/routes/report_routes.py"
    }
  ],
