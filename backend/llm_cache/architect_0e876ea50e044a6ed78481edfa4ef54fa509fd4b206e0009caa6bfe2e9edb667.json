{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token.",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user (librarian creates member accounts).",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with pagination and full\u2011text search; supports filtering by availability.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record with associated authors and optional cover image upload.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve detailed information for a single book, including authors and reservation status.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update book details and manage linked authors; records audit log entry.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/books/{id}",
      "description": "Delete a book from the catalog.",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List authors with pagination and search capability.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author record.",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/members",
      "description": "List library members (librarian view) with pagination and search.",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Register a new library member; sends welcome email.",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Create a borrowing record when a member checks out an available book; sets due date.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings/return",
      "description": "Mark a borrowing as returned; updates book availability and triggers reservation fulfillment if needed.",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a checked\u2011out book; sends confirmation email.",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/overdue",
      "description": "Generate a report of overdue borrowings; accessible to librarians; downloadable as CSV.",
      "file": "app/routes/report_routes.py"
    }
  ],
