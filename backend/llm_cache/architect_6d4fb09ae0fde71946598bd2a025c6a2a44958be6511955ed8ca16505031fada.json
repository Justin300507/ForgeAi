{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Create a new user account (admin only)",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "List all users (admin)",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Get details of a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "PUT",
      "path": "/users/{id}",
      "description": "Update user role or activation status",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/tickets",
      "description": "Create a new support ticket (customer)",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets",
      "description": "List tickets (own tickets for customers, all with filters for agents/managers)",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/{id}",
      "description": "Retrieve detailed information of a ticket",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "PUT",
      "path": "/tickets/{id}",
      "description": "Update ticket status, assign agent, or change priority",
      "file": "app/routes/ticket_routes.py"
    },
    {
      "method": "POST",
      "path": "/tickets/{ticket_id}/messages",
      "description": "Add a message to a ticket (customer or agent)",
      "file": "app/routes/message_routes.py"
    },
    {
      "method": "GET",
      "path": "/tickets/{ticket_id}/messages",
      "description": "List messages for a ticket (paginated)",
      "file": "app/routes/message_routes.py"
    },
    {
      "method": "POST",
      "path": "/messages/{message_id}/attachments",
      "description": "Upload an attachment to a ticket message",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/attachments/{id}",
      "description": "Download an attachment file",
      "file": "app/routes/attachment_routes.py"
    },
    {
      "method": "GET",
      "path": "/sla/rules",
      "description": "List SLA rules per priority (manager)",
      "file": "app/routes/sla_routes.py"
    },
    {
      "method": "POST",
      "path": "/sla/rules",
      "description": "Create or update an SLA rule for a priority",
      "file": "app/routes/sla_routes.py"
    }
  ],
