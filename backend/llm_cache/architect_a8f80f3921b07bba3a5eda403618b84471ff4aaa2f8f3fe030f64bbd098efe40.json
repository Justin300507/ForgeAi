{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return access token",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users",
      "description": "Retrieve list of all users",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "description": "Retrieve detailed information for a specific user",
      "file": "app/routes/user_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts",
      "description": "Retrieve list of all blog posts",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}",
      "description": "Retrieve a single post by its ID",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts",
      "description": "Create a new blog post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "PUT",
      "path": "/posts/{id}",
      "description": "Update an existing post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/posts/{id}",
      "description": "Delete a post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{id}/like",
      "description": "Add a like to a post",
      "file": "app/routes/post_routes.py"
    },
    {
      "method": "GET",
      "path": "/posts/{id}/comments",
      "description": "Retrieve comments for a specific post",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/posts/{id}/comments",
      "description": "Create a comment on a specific post",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "PUT",
      "path": "/comments/{id}",
      "description": "Update an existing comment",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/comments/{id}",
      "description": "Delete a comment",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "POST",
      "path": "/comments/{id}/like",
      "description": "Add a like to a comment",
      "file": "app/routes/comment_routes.py"
    }
  ],
