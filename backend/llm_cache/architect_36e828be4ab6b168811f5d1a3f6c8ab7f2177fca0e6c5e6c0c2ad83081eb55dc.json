{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/books",
      "description": "List books with optional search and pagination",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/books/{id}",
      "description": "Retrieve detailed information for a specific book",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "POST",
      "path": "/books",
      "description": "Create a new book record with associated authors and optional cover image",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "PUT",
      "path": "/books/{id}",
      "description": "Update book fields; keep existing author links unless changed",
      "file": "app/routes/book_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors",
      "description": "List authors with pagination",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "GET",
      "path": "/authors/{id}",
      "description": "Get details of a single author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/authors",
      "description": "Create a new author",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "PUT",
      "path": "/authors/{id}",
      "description": "Update author information",
      "file": "app/routes/author_routes.py"
    },
    {
      "method": "POST",
      "path": "/members",
      "description": "Register a new library member and create linked user account",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "PUT",
      "path": "/members/me",
      "description": "Update the authenticated member's profile",
      "file": "app/routes/member_routes.py"
    },
    {
      "method": "POST",
      "path": "/borrowings",
      "description": "Create a borrowing record (checkout) and set book status to checked_out",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/borrowings/{id}/return",
      "description": "Mark a borrowing as returned, update book status, and trigger reservation notification if needed",
      "file": "app/routes/borrowing_routes.py"
    },
    {
      "method": "POST",
      "path": "/reservations",
      "description": "Create a reservation for a checked\u2011out book and assign queue position",
      "file": "app/routes/reservation_routes.py"
    },
    {
      "method": "GET",
      "path": "/reports/overdue",
      "description": "Paginated list of borrowings past due date with member contact info",
      "file": "app/routes/report_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    }
  ],
