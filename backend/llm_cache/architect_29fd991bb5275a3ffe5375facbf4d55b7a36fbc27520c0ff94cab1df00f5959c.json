{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/signup",
      "description": "Create a new user account and send verification email",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT access token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/auth/verify",
      "description": "Verify email using token query parameter",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/candidates/me",
      "description": "Retrieve the authenticated candidate's profile",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/candidates/me",
      "description": "Update the authenticated candidate's profile details",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "POST",
      "path": "/candidates/resume",
      "description": "Upload a resume file for the candidate (PDF/DOC/DOCX, \u22645\u202fMB)",
      "file": "app/routes/candidate_routes.py"
    },
    {
      "method": "PUT",
      "path": "/employers/me",
      "description": "Update the authenticated employer's company profile",
      "file": "app/routes/employer_routes.py"
    },
    {
      "method": "POST",
      "path": "/jobs",
      "description": "Create a new job listing (employer only)",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "GET",
      "path": "/jobs",
      "description": "List public job listings with pagination, search and filters",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PUT",
      "path": "/jobs/{id}",
      "description": "Update an existing job listing owned by the employer",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/jobs/{id}",
      "description": "Archive or deactivate a job listing",
      "file": "app/routes/job_routes.py"
    },
    {
      "method": "POST",
      "path": "/applications",
      "description": "Submit an application to a job with cover letter and selected resume",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/applications",
      "description": "List applications: candidates see own, employers see applications for their jobs (filtered by query)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "PATCH",
      "path": "/applications/{id}",
      "description": "Employer updates application status (Under Review, Interview, Rejected, Hired)",
      "file": "app/routes/application_routes.py"
    },
    {
      "method": "GET",
      "path": "/ws/notifications",
      "description": "WebSocket endpoint for real\u2011time notification stream",
      "file": "app/routes/notification_routes.py"
    }
  ],
