{
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/customers",
      "description": "Retrieve a list of all customers (admin view)",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "GET",
      "path": "/customers/{id}",
      "description": "Retrieve details of a specific customer",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "PUT",
      "path": "/customers/{id}",
      "description": "Update profile information for a specific customer",
      "file": "app/routes/customer_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user account",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate a user and issue a JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/plans",
      "description": "Retrieve a list of available subscription plans",
      "file": "app/routes/plan_routes.py"
    },
    {
      "method": "GET",
      "path": "/plans/{id}",
      "description": "Retrieve detailed information for a specific plan",
      "file": "app/routes/plan_routes.py"
    },
    {
      "method": "POST",
      "path": "/plans",
      "description": "Create a new subscription plan (admin)",
      "file": "app/routes/plan_routes.py"
    },
    {
      "method": "PUT",
      "path": "/plans/{id}",
      "description": "Update an existing subscription plan (admin)",
      "file": "app/routes/plan_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/plans/{id}",
      "description": "Delete a subscription plan (admin)",
      "file": "app/routes/plan_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions",
      "description": "List all subscriptions for the authenticated user",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "POST",
      "path": "/subscriptions",
      "description": "Create a new subscription for the authenticated user",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions/{id}",
      "description": "Retrieve details of a specific subscription",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "PUT",
      "path": "/subscriptions/{id}",
      "description": "Update subscription status or details",
      "file": "app/routes/subscription_routes.py"
    },
    {
      "method": "GET",
      "path": "/subscriptions/{id}/track",
      "description": "Get real\u2011time tracking information for a subscription's delivery",
      "file": "app/routes/subscription_routes.py"
    }
  ],
