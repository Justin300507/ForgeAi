{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "description": "Register a new user and store credentials",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/clubs",
      "description": "Retrieve a paginated list of clubs",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs",
      "description": "Create a new club (organizer only)",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "PUT",
      "path": "/clubs/{id}",
      "description": "Update club details; owner permission required",
      "file": "app/routes/club_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs/{club_id}/members",
      "description": "Join a club as a member",
      "file": "app/routes/club_member_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/clubs/{club_id}/members",
      "description": "Leave a club",
      "file": "app/routes/club_member_routes.py"
    },
    {
      "method": "POST",
      "path": "/clubs/{club_id}/reading-list",
      "description": "Add a book to the club's reading list with schedule",
      "file": "app/routes/reading_list_routes.py"
    },
    {
      "method": "PUT",
      "path": "/reading-list/{item_id}",
      "description": "Update reading list item (e.g., change start date or order)",
      "file": "app/routes/reading_list_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/reading-list/{item_id}",
      "description": "Remove a book from the club's reading list",
      "file": "app/routes/reading_list_routes.py"
    },
    {
      "method": "POST",
      "path": "/reading-list/{item_id}/progress",
      "description": "Log reading progress for the authenticated member",
      "file": "app/routes/progress_routes.py"
    },
    {
      "method": "POST",
      "path": "/books/{book_id}/reviews",
      "description": "Submit a star rating and optional text review for a completed book",
      "file": "app/routes/review_routes.py"
    },
    {
      "method": "POST",
      "path": "/reading-list/{item_id}/comments",
      "description": "Post a comment in the discussion thread of a reading list item",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "PUT",
      "path": "/comments/{comment_id}",
      "description": "Edit own comment within allowed time window",
      "file": "app/routes/comment_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/comments/{comment_id}",
      "description": "Delete own comment",
      "file": "app/routes/comment_routes.py"
    }
  ],
