{
  "api_endpoints": [
    {
      "method": "POST",
      "path": "/auth/login",
      "description": "Authenticate user and return JWT token",
      "file": "app/routes/auth_routes.py"
    },
    {
      "method": "GET",
      "path": "/students/me",
      "description": "Retrieve profile of the logged\u2011in student",
      "file": "app/routes/student_routes.py"
    },
    {
      "method": "PUT",
      "path": "/students/me",
      "description": "Update profile of the logged\u2011in student",
      "file": "app/routes/student_routes.py"
    },
    {
      "method": "GET",
      "path": "/subjects",
      "description": "List all subjects belonging to the logged\u2011in student",
      "file": "app/routes/subject_routes.py"
    },
    {
      "method": "POST",
      "path": "/subjects",
      "description": "Create a new subject for the logged\u2011in student",
      "file": "app/routes/subject_routes.py"
    },
    {
      "method": "GET",
      "path": "/subjects/{id}",
      "description": "Get details of a specific subject",
      "file": "app/routes/subject_routes.py"
    },
    {
      "method": "PUT",
      "path": "/subjects/{id}",
      "description": "Update a specific subject",
      "file": "app/routes/subject_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/subjects/{id}",
      "description": "Delete a specific subject",
      "file": "app/routes/subject_routes.py"
    },
    {
      "method": "GET",
      "path": "/assignments",
      "description": "List all assignments for the logged\u2011in student",
      "file": "app/routes/assignment_routes.py"
    },
    {
      "method": "POST",
      "path": "/assignments",
      "description": "Create a new assignment under a subject",
      "file": "app/routes/assignment_routes.py"
    },
    {
      "method": "GET",
      "path": "/assignments/{id}",
      "description": "Get details of a specific assignment",
      "file": "app/routes/assignment_routes.py"
    },
    {
      "method": "PUT",
      "path": "/assignments/{id}",
      "description": "Update a specific assignment",
      "file": "app/routes/assignment_routes.py"
    },
    {
      "method": "DELETE",
      "path": "/assignments/{id}",
      "description": "Delete a specific assignment",
      "file": "app/routes/assignment_routes.py"
    },
    {
      "method": "GET",
      "path": "/dashboard",
      "description": "Retrieve dashboard data including upcoming assignments and calculated GPA",
      "file": "app/routes/dashboard_routes.py"
    }
  ],
