elete('/recipes/{id}')\ndef delete_recipe(id: int, db: Session = Depends(get_db)):\n    recipe = db.query(Recipe).filter(Recipe.id == id).first()\n    if not recipe:\n        raise HTTPException(status_code=404, detail=\"Recipe not found\")\n    db.delete(recipe)\n    db.commit()\n    return {'detail': 'Recipe deleted successfully'}"
